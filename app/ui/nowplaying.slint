// „Teraz odtwarzane”: okładka z wizualizacją (jak w Poweramp), opis utworu z szeryfowym tytułem
// i dolny pasek – duża taśma utworu, przyciski odtwarzania na środku, głośność i wyjście po lewej,
// przełączniki po prawej. Te same części składają pełne okno i widok pomniejszony.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconBtn, HSlider, Marquee, Cover, LyricText, LyricStyle } from "widgets.slint";
import { SeekBar, Visualizer, Fmt } from "display.slint";
import { Player, Prefs, Ui, Video } from "state.slint";
import { VideoStage } from "surface.slint";

export global VizNames {
    out property <[string]> names: [@tr("Bars"), @tr("Spectrum"), @tr("Oscilloscope"), @tr("VU meters"), @tr("glow" => "Off"), @tr("Mirror"), @tr("Circle"), @tr("3D spectrum"), @tr("LEDs"), @tr("Stereo"), @tr("Dots"), @tr("Wave"), @tr("Blob"), @tr("Pulse"), @tr("Capsules")];
}

// Okładka z poświatą w kolorze akcentu i wizualizacją na dolnej części obrazu.
export component CoverArt inherits Rectangle {
    in property <length> radius: 14px;
    in property <bool> show-chip: true;
    in property <bool> show-viz: true;
    callback clicked();
    out property <bool> hovered: ta.has-hover || chip-ta.has-hover || viz-prev.hovered || viz-next.hovered;
    // Poświata
    Rectangle {
        border-radius: root.radius;
        background: Theme.bg;
        drop-shadow-blur: min(root.width * 0.18, 48px);
        drop-shadow-color: Player.has-cover ? Theme.glow : Theme.glow.with-alpha(0.18);
    }
    Cover {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        source: Player.cover;
        has: Player.has-cover;
        fallback: Icons.note;
        background: Theme.panel2;
        // Przyciemnienie pod wizualizacją – siła z ustawień (0 – brak).
        if root.show-viz && Player.viz-mode != 4 && !Player.idle && Prefs.viz-dim > 0.01: Rectangle {
            y: parent.height * 0.36;
            height: parent.height * 0.64;
            background: @linear-gradient(180deg, transparent 0%, #000000.with-alpha(Prefs.viz-dim * 0.6) 55%, #000000.with-alpha(Prefs.viz-dim * 0.9) 100%);
        }
        if root.show-viz && Player.viz-mode != 4 && !Player.idle: Visualizer {
            x: parent.width * 0.06;
            width: parent.width * 0.88;
            y: parent.height * (Player.viz-mode == 3 ? 0.62 : 0.5);
            height: parent.height * (Player.viz-mode == 3 ? 0.32 : 0.46);
            overlay: true;
            mode: Player.viz-mode;
            bars: Player.bars;
            peaks: Player.peaks;
            scope-path: Player.scope-path;
            spectrum-path: Player.spectrum-path;
            viz-path: Player.viz-path;
            vu-l: Player.vu-l;
            vu-r: Player.vu-r;
            vu-pl: Player.vu-pl;
            vu-pr: Player.vu-pr;
            active: Player.viz-active;
            note: "";
        }
    }
    Rectangle {
        border-radius: root.radius;
        border-width: 1px;
        border-color: Theme.tint.with-alpha(0.28);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    // Przełącznik wizualizacji – szklana pigułka ze strzałkami, widoczna po najechaniu na okładkę.
    chip := Rectangle {
        visible: root.show-chip && root.width >= 150px;
        x: parent.width - self.width - 10px;
        y: 10px;
        height: 30px;
        width: chip-row.preferred-width;
        border-radius: 15px;
        background: Theme.glass-color.with-alpha(0.78);
        border-width: 1px;
        border-color: Theme.tint.with-alpha(0.35);
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000066;
        opacity: root.hovered ? 1 : 0;
        animate opacity { duration: 160ms; }
        chip-row := HorizontalLayout {
            padding: 3px;
            spacing: 2px;
            viz-prev := IconBtn {
                size: 24px;
                icon-size: 16px;
                icon: Icons.chevron-left;
                tip: @tr("Previous visualization");
                clicked => { Player.step-viz(-1); }
            }
            mid := Rectangle {
                width: mid-row.preferred-width;
                chip-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Player.step-viz(1); }
                }
                mid-row := HorizontalLayout {
                    spacing: 6px;
                    padding-left: 2px;
                    padding-right: 2px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.equalizer;
                        size: 13px;
                        fill: Theme.tint.brighter(0.4);
                    }
                    Text {
                        text: VizNames.names[Player.viz-mode];
                        color: Theme.text;
                        font-size: Theme.fs-xs;
                        font-weight: 600;
                        vertical-alignment: center;
                        min-width: 64px;
                        horizontal-alignment: center;
                    }
                }
            }
            viz-next := IconBtn {
                size: 24px;
                icon-size: 16px;
                icon: Icons.chevron-right;
                tip: @tr("Next visualization");
                clicked => { Player.step-viz(1); }
            }
        }
    }
}

// Parametr przy tytule: ikona i tekst, bez obramowania. Pierwszy (najważniejszy) – w akcencie.
component Param inherits HorizontalLayout {
    in property <string> text;
    in property <string> icon;
    in property <bool> lit;
    spacing: 5px;
    Icon {
        y: (parent.height - self.height) / 2;
        icon: Icons.get(root.icon);
        size: 14px;
        fill: root.lit ? Theme.tint-hi : Theme.text3;
    }
    Text {
        text: root.text;
        color: root.lit ? Theme.tint-hi : Theme.text2;
        font-size: Theme.fs-sm;
        font-weight: root.lit ? 600 : 400;
        vertical-alignment: center;
    }
}

// Włączony tryb silnika (losowo, korektor…) – widoczny tylko, gdy działa.
component Flag inherits HorizontalLayout {
    in property <string> text;
    in property <string> icon;
    spacing: 4px;
    Icon {
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        size: 13px;
        fill: Theme.tint-hi;
    }
    Text {
        text: root.text;
        color: Theme.tint-hi;
        font-size: Theme.fs-xs;
        vertical-alignment: center;
    }
}

// Opis bieżącego utworu albo filmu obok okładki – jeden układ dla muzyki i wideo:
// stan, tytuł, wykonawca/opis, parametry z ikonami, przyciski i włączone tryby.
export component NowInfo inherits VerticalLayout {
    in property <bool> small;
    property <bool> movie: Video.active || Video.bg-audio || Player.subs-mode;
    alignment: center;
    spacing: root.small ? 2px : 4px;
    // Stan: pulsująca kropka, „teraz odtwarzane” / „wstrzymane”, rodzaj i miejsce na liście.
    if !root.small: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        height: 14px;
        if !Player.idle: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: Player.playing ? Theme.tint-hi : Theme.text3;
            opacity: Player.playing ? 0.55 + 0.45 * abs(sin(animation-tick() / 1.6s * 180deg)) : 1;
        }
        Text {
            text: Player.idle ? "OPENMP" : (Player.playing ? @tr("NOW PLAYING") : @tr("PAUSED")) + (root.movie ? @tr("  ·  MOVIE") : "");
            color: Theme.text3;
            font-size: Theme.fs-xs;
            letter-spacing: 3px;
            vertical-alignment: center;
        }
        if Player.position-text != "": Text {
            text: "·  " + Player.position-text;
            color: Theme.text3;
            font-size: Theme.fs-xs;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
    }
    Marquee {
        text: Player.idle ? @tr("Nothing playing") : Player.title;
        font-size: root.small ? 22px : 40px;
        font-family: Theme.font-serif;
        text-color: Theme.heading;
        enabled: Prefs.scroll-title;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { Player.show-current(); }
        }
    }
    if Player.idle || Player.artist != "": Marquee {
        text: Player.idle ? @tr("Drop files or folders to start listening") : Player.artist;
        font-size: root.small ? 15px : 24px;
        font-family: Theme.font-serif;
        text-color: Theme.tint.mix(Theme.text2, 0.45);
        enabled: Prefs.scroll-title;
    }
    // Album i rok (muzyka) albo rok, gatunki i ocena / folder (film) – z ikoną.
    if Player.album != "": HorizontalLayout {
        spacing: 6px;
        Icon {
            y: (parent.height - self.height) / 2;
            icon: root.movie ? Icons.calendar : Icons.album;
            size: 14px;
            fill: Theme.text3;
        }
        Text {
            horizontal-stretch: 1;
            text: Player.album;
            color: Theme.text2;
            font-size: root.small ? Theme.fs-sm : Theme.fs-md;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if !root.small && Player.credits != "": HorizontalLayout {
        spacing: 6px;
        Icon {
            y: (parent.height - self.height) / 2;
            icon: Icons.artist;
            size: 14px;
            fill: Theme.text3;
        }
        Text {
            horizontal-stretch: 1;
            text: Player.credits;
            color: Theme.text3;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // Opis w prostokącie o stałych wymiarach: zawijany tekst nie bierze udziału w układzie
    // (inaczej jego wysokość zależy od szerokości – pętla wiązań z szerokością okładki).
    if !root.small && Player.overview != "": Rectangle {
        height: 3 * 1.4 * Theme.fs;
        min-width: 0px;
        preferred-width: 0px;
        Text {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: Player.overview;
            color: Theme.text2;
            font-size: Theme.fs;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
        }
    }
    if !Player.idle: Rectangle {
        height: root.small ? 0px : 2px;
    }
    // Parametry techniczne – ikona i wartość, oddzielone odstępem, bez ramek.
    if !Player.idle && Player.badges.length > 0: HorizontalLayout {
        spacing: 16px;
        alignment: start;
        height: 18px;
        for b[i] in Player.badges: Param {
            text: b;
            icon: Player.badge-icons[i];
            lit: i == 0;
        }
    }
    if !Player.idle: HorizontalLayout {
        spacing: 2px;
        alignment: start;
        height: 30px;
        IconBtn {
            icon: Player.fav ? Icons.heart : Icons.heart-outline;
            size: 30px;
            icon-size: 17px;
            active: Player.fav;
            tip: @tr("Favorite");
            clicked => { Player.toggle-fav(); }
        }
        if !Player.hero-lyrics: IconBtn {
            icon: root.movie ? Icons.subtitles : Icons.lyrics;
            size: 30px;
            icon-size: 17px;
            active: Prefs.side-panel == 1;
            tip: root.movie ? @tr("Subtitles in the panel (L)") : @tr("Lyrics (L)");
            clicked => {
                Prefs.side-panel = Prefs.side-panel == 1 ? 0 : 1;
                Prefs.changed("side-panel");
            }
        }
        IconBtn {
            icon: Icons.info;
            size: 30px;
            icon-size: 17px;
            active: Prefs.side-panel == 2;
            tip: @tr("Info");
            clicked => {
                Prefs.side-panel = Prefs.side-panel == 2 ? 0 : 2;
                Prefs.changed("side-panel");
            }
        }
        if Video.active || Video.bg-audio: IconBtn {
            icon: Icons.movie;
            size: 30px;
            icon-size: 17px;
            active: true;
            tip: Video.bg-audio ? @tr("Show the movie picture") : @tr("Movie view");
            clicked => { Video.open-view(); }
        }
        IconBtn {
            icon: Icons.folder-open;
            size: 30px;
            icon-size: 17px;
            tip: @tr("Show file in Explorer");
            clicked => { Player.reveal-current(); }
        }
        IconBtn {
            icon: Icons.queue;
            size: 30px;
            icon-size: 17px;
            active: Prefs.side-panel == 3;
            tip: @tr("Queue");
            clicked => {
                Prefs.side-panel = Prefs.side-panel == 3 ? 0 : 3;
                Prefs.changed("side-panel");
            }
        }
        Rectangle {
            width: 12px;
        }
        // Tylko włączone tryby – z ikoną i nazwą, bez szarych skrótów.
        HorizontalLayout {
            spacing: 12px;
            if Player.shuffle: Flag {
                icon: Icons.shuffle;
                text: @tr("Shuffle");
            }
            if Player.eq-on: Flag {
                icon: Icons.equalizer;
                text: @tr("Equalizer");
            }
            if Player.crossfade-on: Flag {
                icon: Icons.compact;
                text: @tr("badge" => "Crossfade");
            }
            if Player.rg-on: Flag {
                icon: Icons.volume-low;
                text: @tr("ReplayGain");
            }
            if Player.speed-text != "": Flag {
                icon: Icons.speed;
                text: Player.speed-text;
            }
            if Player.sleep-text != "": Flag {
                icon: Icons.timer;
                text: Player.sleep-text;
            }
        }
    }
}

// Tekst piosenki obok opisu utworu: wiersz po wierszu przy znacznikach czasu,
// bez nich – przewijany ręcznie kółkiem myszy.
component HeroLyrics inherits Rectangle {
    clip: true;
    lyr := Flickable {
        property <length> line-h: LyricStyle.line-h;
        content-height: Player.lyrics.length * line-h + (Player.lyrics-synced ? self.height : 32px);
        property <int> act: Player.lyrics-active;
        changed act => {
            if Player.lyrics-synced && self.act >= 0 {
                self.content-y = -(self.act * self.line-h);
            }
        }
        animate content-y { duration: 400ms; easing: ease-out; }
        for l[i] in Player.lyrics: Rectangle {
            x: 0;
            y: (Player.lyrics-synced ? lyr.height / 2 - lyr.line-h / 2 : 16px) + i * lyr.line-h;
            width: lyr.width;
            height: lyr.line-h;
            LyricText {
                width: parent.width;
                height: parent.height;
                text: l.text;
                active: l.active;
                synced: Player.lyrics-synced;
                dist: abs(i - Player.lyrics-active);
                overflow: elide;
            }
            // Klik – przewinięcie do tej linii (w zaznaczeniu: utwór zaczyna grać od niej).
            TouchArea {
                mouse-cursor: Player.lyrics-synced ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    if Player.lyrics-synced {
                        Player.lyrics-seek(i);
                    }
                }
            }
        }
    }
}

// Film w miejscu okładki (okno muzyki): obraz z poświatą, przyciski po najechaniu.
component HeroVideo inherits Rectangle {
    in property <length> radius: 0;
    // Poświata w kolorze przewodnim (który przy filmie podąża za obrazem).
    Rectangle {
        border-radius: root.radius;
        background: #000000;
        drop-shadow-blur: Prefs.ambient == 2 ? 56px : 36px;
        drop-shadow-color: Prefs.ambient > 0 ? Theme.glow : transparent;
    }
    VideoStage {
        radius: root.radius;
        ambient: false;
    }
    Rectangle {
        border-radius: root.radius;
        border-width: 1px;
        border-color: Theme.tint.with-alpha(0.3);
    }
    hta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Video.open-view(); }
        scroll-event(e) => {
            Player.set-volume(clamp(Player.volume + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1));
            accept
        }
    }
    Rectangle {
        opacity: hta.has-hover || fsb.hovered ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 160ms; }
        border-radius: root.radius;
        background: @linear-gradient(180deg, #00000070 0%, transparent 40%);
        HorizontalLayout {
            y: 8px;
            height: 30px;
            padding-right: 8px;
            alignment: end;
            spacing: 2px;
            fsb := IconBtn {
                icon: Icons.fullscreen;
                size: 30px;
                icon-size: 16px;
                on-dark: true;
                icon-color: #ffffffe0;
                hover-color: #ffffff;
                tip: @tr("Movie full screen (F)");
                clicked => { Video.toggle-fullscreen(); }
            }
        }
    }
}

// Okładka (albo obraz filmu) i opis obok siebie – górna część okna, w oknie i na pełnym ekranie.
// Tryb zaznaczenia: nic nie gra – szczegóły zaznaczonego pliku, kilku plików albo grupy,
// w tym samym układzie co „Teraz odtwarzane”: nagłówek, tytuł, podtytuł i wiersze z ikonami.
component SelInfo inherits VerticalLayout {
    in property <bool> small;
    alignment: center;
    spacing: root.small ? 2px : 4px;
    // Ten sam układ co „Teraz odtwarzane”: nagłówek, tytuł, wykonawca, album/rok z ikoną,
    // twórcy, opis i parametry z ikonami; niżej – dodatkowe tagi.
    if !root.small: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        height: 14px;
        Text {
            text: @tr("SELECTION") + (Player.sel-movie ? @tr("  ·  MOVIE") : "");
            color: Theme.text3;
            font-size: Theme.fs-xs;
            letter-spacing: 3px;
            vertical-alignment: center;
        }
    }
    Marquee {
        text: Player.sel-title;
        font-size: root.small ? 22px : 40px;
        font-family: Theme.font-serif;
        text-color: Theme.heading;
        enabled: Prefs.scroll-title;
    }
    if Player.sel-sub != "": Marquee {
        text: Player.sel-sub;
        font-size: root.small ? 15px : 24px;
        font-family: Theme.font-serif;
        text-color: Theme.tint.mix(Theme.text2, 0.45);
        enabled: Prefs.scroll-title;
    }
    if Player.sel-album != "": HorizontalLayout {
        spacing: 6px;
        Icon {
            y: (parent.height - self.height) / 2;
            icon: Player.sel-movie ? Icons.calendar : Icons.album;
            size: 14px;
            fill: Theme.text3;
        }
        Text {
            horizontal-stretch: 1;
            text: Player.sel-album;
            color: Theme.text2;
            font-size: root.small ? Theme.fs-sm : Theme.fs-md;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if !root.small && Player.sel-credits != "": HorizontalLayout {
        spacing: 6px;
        Icon {
            y: (parent.height - self.height) / 2;
            icon: Icons.artist;
            size: 14px;
            fill: Theme.text3;
        }
        Text {
            horizontal-stretch: 1;
            text: Player.sel-credits;
            color: Theme.text3;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // Opis w prostokącie o stałych wymiarach (jak przy odtwarzaniu); przy braku miejsca
    // zostaje mniej wierszy, zakończonych wielokropkiem.
    if !root.small && Player.sel-overview != "": Rectangle {
        preferred-height: 3 * 1.4 * Theme.fs;
        min-height: 1.4 * Theme.fs;
        min-width: 0px;
        preferred-width: 0px;
        Text {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: Player.sel-overview;
            color: Theme.text2;
            font-size: Theme.fs;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
        }
    }
    Rectangle {
        height: root.small ? 0px : 2px;
    }
    if Player.sel-badges.length > 0: HorizontalLayout {
        spacing: 16px;
        alignment: start;
        height: 18px;
        for b[i] in Player.sel-badges: Param {
            text: b;
            icon: Player.sel-badge-icons[i];
            lit: i == 0;
        }
    }
    // Szczegóły w dwóch kolumnach (w wąskim miejscu – w jednej). Gdy brak miejsca w pionie,
    // znikają całe wiersze od dołu – bez przyciętych w pół.
    rows := Rectangle {
        property <int> cols: self.width >= 560px ? 2 : 1;
        property <length> row-h: 20px;
        property <length> gap: 4px;
        min-width: 0px;
        preferred-width: 0px;
        min-height: self.row-h;
        preferred-height: ceil(Player.sel-rows.length / self.cols) * (self.row-h + self.gap);
        clip: true;
        for r[i] in Player.sel-rows: Rectangle {
            x: mod(i, rows.cols) * (rows.width / rows.cols);
            y: floor(i / rows.cols) * (rows.row-h + rows.gap);
            width: rows.width / rows.cols - (rows.cols > 1 ? 16px : 0px);
            height: rows.row-h;
            visible: self.y + self.height <= rows.height;
            HorizontalLayout {
                spacing: 8px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.get(r.id);
                    size: 14px;
                    fill: Theme.text3;
                }
                Text {
                    text: r.label;
                    color: Theme.text3;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                    width: 110px;
                }
                Text {
                    horizontal-stretch: 1;
                    text: r.sub;
                    color: Theme.text2;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

export component Hero inherits Rectangle {
    in property <bool> small;
    // Szerokie okno i tekst dostępny – kolumna z tekstem obok opisu.
    // Szerokość okna (nie Hero) – szerokość Hero zależy od tego, czy tekst jest obok (pętla wiązań).
    in property <length> avail: 1200px;
    // Przy odtwarzaniu i w trybie zaznaczenia (tekst zaznaczonego utworu).
    property <bool> show-lyrics: !root.small && root.avail >= 1320px && (!Player.idle || Player.sel-mode) && Player.lyrics.length > 0;
    init => { Player.hero-lyrics = self.show-lyrics; }
    changed show-lyrics => { Player.hero-lyrics = self.show-lyrics; }
    // Proporcje okładki (plakat filmu, okładka albumu, klatka) – bez przycinania.
    property <float> cover-ratio: Player.has-cover ? clamp(Player.cover.width / max(1, Player.cover.height), 0.5, 2) : 1;
    property <float> sel-ratio: Player.sel-has-cover ? clamp(Player.sel-cover.width / max(1, Player.sel-cover.height), 0.5, 2) : 1;
    // Tekst wyrównany do lewej, okładka (albo obraz filmu) przy prawej krawędzi – w prawdziwych
    // proporcjach, bez zmiany układu tekstu.
    HorizontalLayout {
        spacing: root.small ? 18px : 36px;
        padding-left: root.small ? 4px : 8px;
        // Miejsce na przycisk zamknięcia pliku obok okładki.
        padding-right: Player.idle ? 0px : 34px;
        padding-top: root.small ? 2px : 0px;
        padding-bottom: root.small ? 2px : 0px;
        if !(Player.idle && Player.sel-mode): NowInfo {
            horizontal-stretch: 1;
            small: root.small;
        }
        if Player.idle && Player.sel-mode: SelInfo {
            horizontal-stretch: 1;
            small: root.small;
        }
        if root.show-lyrics: HeroLyrics {
            width: min(root.avail * 0.27, 520px);
        }
        // Tryb zaznaczenia: okładka zaznaczonego pliku / grupy.
        if Player.idle && Player.sel-mode: Cover {
            width: self.height * root.sel-ratio;
            border-radius: root.small ? 10px : 14px;
            source: Player.sel-cover;
            has: Player.sel-has-cover;
            fallback: Icons.folder;
            background: Theme.panel2;
        }
        if !Video.active && !(Player.idle && Player.sel-mode): CoverArt {
            width: self.height * root.cover-ratio;
            radius: root.small ? 10px : 14px;
            clicked => {
                if Video.bg-audio {
                    Video.show-picture();
                } else {
                    Prefs.side-panel = Prefs.side-panel == 2 ? 0 : 2;
                    Prefs.changed("side-panel");
                }
            }
        }
        // Film gra w miejscu okładki – z poświatą z obrazu; kliknięcie otwiera widok filmu.
        if Video.active: HeroVideo {
            // Tylko z wysokości – szerokość Hero zależy od tej szerokości (pętla wiązań).
            width: self.height * clamp(Video.ratio, 0.5, 2);
            // Proste rogi: zaokrąglone przycięcie Slint rysuje z bufora i obraz stałby w miejscu.
            radius: 0;
        }
    }
    // Zamknięcie bieżącego pliku – odtwarzanie staje, a w tym miejscu pojawia się zaznaczenie.
    if !Player.idle: IconBtn {
        x: parent.width - self.width - 2px;
        y: 2px;
        icon: Icons.close;
        size: 28px;
        icon-size: 15px;
        tip: @tr("Close file");
        clicked => { Player.close-current(); }
    }
}

// Duży przycisk odtwarzania: pierścień w kolorze akcentu z poświatą.
export component PlayRing inherits Rectangle {
    in property <length> size: 64px;
    width: size;
    height: size;
    border-radius: self.width / 2;
    background: pta.pressed ? Theme.tint.with-alpha(0.32) : pta.has-hover ? Theme.tint.with-alpha(0.2) : Theme.tint.with-alpha(0.08);
    border-width: 2px;
    border-color: Theme.tint;
    drop-shadow-blur: 22px;
    drop-shadow-color: Theme.glow;
    animate background { duration: 140ms; }
    Icon {
        icon: Player.playing ? Icons.pause : Icons.play;
        size: root.size * 0.42;
        fill: Theme.ink;
    }
    pta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Player.play-pause(); }
    }
}

// Dolny pasek: taśma utworu z czasami, przyciski odtwarzania, głośność, wyjście i przełączniki.
export component BottomBar inherits Rectangle {
    in property <bool> small;
    property <bool> narrow: root.width < 760px;
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: root.small ? 4px : 6px;
        padding-bottom: root.small ? 4px : 6px;
        spacing: 0px;
        SeekBar {
            wave-height: root.small ? 30px : 40px;
            value: Player.duration > 0 ? Player.pos / Player.duration : 0;
            duration: Player.duration;
            wave: Player.wave;
            wave2: Player.wave2;
            wave2-kind: Player.wave2-kind;
            wave-live: Player.wave-live;
            live-span: Player.live-span;
            live-glow: Prefs.live-glow;
            show-wave: Prefs.show-waveform;
            ab-a: Player.ab-a;
            ab-b: Player.ab-b;
            chapters: Video.chapters;
            buffered: Video.buffered;
            show-preview: Prefs.seek-preview && Video.active;
            preview: Video.preview;
            has-preview: Video.has-preview;
            preview-ratio: Video.ratio;
            preview-label: Video.preview-chapter;
            seek(v) => { Player.seek(v); }
            hover(f) => {
                if Video.active {
                    Video.hover-seek(f);
                }
            }
        }
        HorizontalLayout {
            height: 16px;
            Text {
                text: Fmt.time(Player.pos);
                color: Theme.text2;
                font-size: Theme.fs;
                font-family: Theme.font-display;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: Player.duration <= 0 ? Player.state-text : Prefs.remaining ? "-" + Fmt.time(Player.duration - Player.pos) : Fmt.time(Player.duration);
                color: Theme.text2;
                font-size: Theme.fs;
                font-family: Theme.font-display;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Prefs.remaining = !Prefs.remaining;
                        Prefs.changed("remaining");
                    }
                }
            }
        }
        HorizontalLayout {
            height: root.small ? 54px : 64px;
            spacing: 8px;
            // Lewa strona: wyjście dźwięku i głośność.
            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 4px;
                // Głośność w kapsule: ikona wyciszenia, suwak z dymkiem i procent; kółko myszy zmienia głośność.
                vol := Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 34px;
                    border-radius: 17px;
                    background: vta.has-hover ? Theme.hover : transparent;
                    animate background { duration: 140ms; }
                    vta := TouchArea {
                        scroll-event(e) => {
                            Player.set-volume(clamp(Player.volume + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1));
                            accept
                        }
                    }
                    HorizontalLayout {
                        padding-right: 12px;
                        spacing: 6px;
                        IconBtn {
                            tip-above: true;
                            y: (parent.height - self.height) / 2;
                            icon: Player.muted || Player.volume == 0 ? Icons.volume-off : Player.volume < 0.5 ? Icons.volume-low : Icons.volume;
                            size: 34px;
                            active: Player.muted;
                            tip: @tr("Mute (M)");
                            clicked => { Player.toggle-mute(); }
                        }
                        HSlider {
                            y: (parent.height - self.height) / 2;
                            width: root.width < 620px ? 70px : 120px;
                            value: Player.volume;
                            bubble: round(Player.volume * 100) + "%";
                            fill-color: Player.muted ? Theme.text3 : Theme.tint;
                            moved(v) => { Player.set-volume(v); }
                        }
                        if root.width >= 620px: Text {
                            width: 34px;
                            text: Player.muted ? @tr("off") : round(Player.volume * 100) + "%";
                            color: vta.has-hover ? Theme.text2 : Theme.text3;
                            font-size: Theme.fs-sm;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }
                }
                Rectangle {
                    width: 6px;
                }
                if Prefs.devices.length > 0: Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 32px;
                    width: 32px;
                    border-radius: 16px;
                    background: dev-ta.has-hover ? Theme.hover : transparent;
                    // Wyjście dźwięku: sama ikona, lista urządzeń po kliknięciu.
                    Icon {
                        icon: Icons.audiotrack;
                        size: 17px;
                        fill: dev-ta.has-hover ? Theme.text : Theme.text2;
                    }
                    dev-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Ui.device-menu(self.absolute-position.x, self.absolute-position.y); }
                    }
                }
            }
            // Środek: odtwarzanie.
            HorizontalLayout {
                spacing: root.narrow ? 6px : 16px;
                alignment: center;
                IconBtn {
                    tip-above: true;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.shuffle;
                    size: 40px;
                    icon-size: 20px;
                    active: Player.shuffle;
                    tip: @tr("Shuffle (S)");
                    clicked => { Player.toggle-shuffle(); }
                }
                IconBtn {
                    tip-above: true;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.prev;
                    size: 44px;
                    icon-size: 26px;
                    icon-color: Theme.ink;
                    tip: @tr("Previous (Ctrl+←)");
                    clicked => { Player.prev(); }
                }
                PlayRing {
                    y: (parent.height - self.height) / 2;
                    size: root.small ? 54px : 64px;
                }
                IconBtn {
                    tip-above: true;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.next;
                    size: 44px;
                    icon-size: 26px;
                    icon-color: Theme.ink;
                    tip: @tr("Next (Ctrl+→)");
                    clicked => { Player.next(); }
                }
                IconBtn {
                    tip-above: true;
                    y: (parent.height - self.height) / 2;
                    icon: Player.repeat == 2 ? Icons.repeat-one : Icons.repeat;
                    size: 40px;
                    icon-size: 20px;
                    active: Player.repeat > 0;
                    tip: Player.repeat == 0 ? @tr("Repeat off (R)") : Player.repeat == 1 ? @tr("Repeat list (R)") : @tr("Repeat track (R)");
                    clicked => { Player.cycle-repeat(); }
                }
            }
            // Prawa strona: zatrzymanie, korektor, wyłącznik, panele i widoki.
            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: end;
                spacing: 2px;
                if !root.narrow: IconBtn {
                    tip-above: true;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.stop;
                    size: 34px;
                    icon-size: 17px;
                    active: Player.stop-after;
                    tip: @tr("Stop (right-click – after current)");
                    clicked => { Player.stop(); }
                    right-clicked => { Ui.key("stop-after", false, false, false); }
                }
                IconBtn {
                    tip-above: true;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.equalizer;
                    size: 34px;
                    active: Ui.equalizer || Prefs.eq-on;
                    tip: @tr("Equalizer and effects (E)");
                    clicked => { Ui.equalizer = !Ui.equalizer; }
                }
                if !root.narrow: IconBtn {
                    tip-above: true;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.timer;
                    size: 34px;
                    active: Player.sleep-text != "";
                    tip: @tr("Sleep timer");
                    clicked => { Ui.sleep-menu(self.absolute-position.x, self.absolute-position.y); }
                }
                IconBtn {
                    tip-above: true;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.pip;
                    size: 34px;
                    icon-size: 17px;
                    tip: @tr("Mini player (Ctrl+M)");
                    clicked => { Ui.set-mode(2); }
                }
                IconBtn {
                    tip-above: true;
                    y: (parent.height - self.height) / 2;
                    icon: Ui.fullscreen ? Icons.fullscreen-exit : Icons.fullscreen;
                    size: 34px;
                    icon-size: 17px;
                    tip: Ui.fullscreen ? @tr("Exit full screen (F11)") : @tr("Full screen (F11)");
                    clicked => { Ui.toggle-full(); }
                }
            }
        }
    }
}
