// Szkło: jedno tło dla wszystkich powierzchni programu – paneli, pasków bocznych, panelu filmu,
// menu kontekstowych i okien (ustawienia, korektor, dialogi). Pod spodem prawdziwe szkło
// systemowe (akryl Windows rozmywa to, co jest za oknem), na wierzchu barwa szkła;
// przezroczystość i barwę ustawia się w wyglądzie.

import { Theme } from "theme.slint";

// Obraz, który przy zmianie źródła płynnie przenika ze starego w nowy (dwie warstwy na zmianę).
export component FadeImage inherits Rectangle {
    in property <image> source;
    in property <ImageFit> fit: cover;
    // Bez wiązania ze źródłem – stara warstwa musi zostać starym obrazem do końca przenikania.
    property <image> a;
    property <image> b;
    property <bool> on-a: true;
    init => {
        root.a = root.source;
    }
    changed source => {
        if root.on-a {
            root.b = root.source;
            root.on-a = false;
        } else {
            root.a = root.source;
            root.on-a = true;
        }
    }
    Image {
        width: 100%;
        height: 100%;
        source: root.a;
        image-fit: root.fit;
        opacity: root.on-a ? 1 : 0;
        animate opacity { duration: 800ms; easing: ease-in-out; }
    }
    Image {
        width: 100%;
        height: 100%;
        source: root.b;
        image-fit: root.fit;
        opacity: root.on-a ? 0 : 1;
        animate opacity { duration: 800ms; easing: ease-in-out; }
    }
}

export component GlassFill inherits Rectangle {
    // Barwa szkła danej powierzchni (panel, pasek boczny, menu).
    in property <color> base: Theme.glass-color;
    // Najmniejsza krycie – dla powierzchni nad obrazem filmu, żeby tekst był czytelny.
    in property <float> min-alpha: 0;
    clip: true;
    // Barwa szkła zmienia się płynnie (okładka, film, ustawienia), nie skokiem.
    Rectangle {
        background: root.base.with-alpha(max(root.min-alpha, 1 - Theme.glass));
        animate background { duration: 600ms; easing: ease-in-out; }
    }
}
