// Części okna trybu muzyki: pasek tytułu, sterowanie, panel boczny, listy, biblioteka, radio,
// panel tekstu/informacji i pasek stanu.

import { ComboBox } from "std-widgets.slint";
import { ScrollView, ListView } from "scroll.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconBtn, Btn, HSlider, Field, Cover, Segmented, SectionTitle, Divider, LyricText, LyricStyle } from "widgets.slint";
import { TrackList } from "tracklist.slint";
import { Player, Lists, Lib, Prefs, Ui } from "state.slint";
import { Fmt } from "display.slint";
import { GlassFill } from "glass.slint";

export component WinButtons inherits HorizontalLayout {
    in property <bool> on-dark;
    spacing: 0;
    for b[i] in [
        { icon: Icons.minimize, id: 0 },
        { icon: Ui.maximized ? Icons.restore : Icons.maximize, id: 1 },
        { icon: Icons.close, id: 2 },
    ]: Rectangle {
        width: 44px;
        height: 32px;
        border-radius: 6px;
        background: wta.has-hover ? (b.id == 2 ? #e81123 : (root.on-dark ? #ffffff1f : Theme.hover)) : transparent;
        Icon {
            icon: b.icon;
            size: 15px;
            fill: wta.has-hover && b.id == 2 ? #ffffff : root.on-dark ? #ffffffd0 : Theme.text2;
        }
        wta := TouchArea {
            clicked => {
                if b.id == 0 {
                    Ui.minimize();
                } else if b.id == 1 {
                    Ui.toggle-maximize();
                } else {
                    Ui.close();
                }
            }
        }
    }
}

// Logo z przyciskiem menu – w panelu nawigacji albo, gdy panel jest ukryty, na pasku tytułu.
export component Brand inherits HorizontalLayout {
    in property <bool> show-menu: true;
    spacing: 4px;
    if root.show-menu: IconBtn {
        y: (parent.height - self.height) / 2;
        icon: Icons.menu;
        size: 32px;
        tip: @tr("Menu");
        clicked => { Ui.open-main-menu(self.absolute-position.x, self.absolute-position.y + self.height + 2px); }
    }
    if root.show-menu: Rectangle {
        width: 4px;
    }
    Image {
        y: (parent.height - self.height) / 2;
        source: @image-url("../icon.png");
        width: 22px;
        height: 22px;
    }
    Text {
        text: "OpenMP";
        color: Theme.text;
        font-size: Theme.fs-md + 1px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

export component TitleBar inherits Rectangle {
    in property <string> subtitle;
    in property <bool> show-brand: true;
    height: 40px;
    background: transparent;
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                Ui.drag();
            }
        }
        double-clicked => { Ui.toggle-maximize(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 2px;
        // Panel nawigacji schowany – przycisk, który go przywraca.
        if root.show-brand && !Prefs.show-sidebar: IconBtn {
            y: (parent.height - self.height) / 2;
            icon: Icons.library;
            size: 32px;
            tip: @tr("Show navigation panel");
            clicked => {
                Prefs.show-sidebar = true;
                Prefs.changed("show-sidebar");
            }
        }
        if root.show-brand: Brand { }
        Text {
            text: root.show-brand && root.subtitle != "" ? "  ·  " + root.subtitle : "";
            color: Theme.text3;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        IconBtn {
            y: (parent.height - self.height) / 2;
            icon: Prefs.ontop ? Icons.pin : Icons.pin-off;
            active: Prefs.ontop;
            size: 30px;
            icon-size: 15px;
            tip: Prefs.ontop ? @tr("Pinned on top – unpin (Ctrl+T)") : @tr("Always on top (Ctrl+T)");
            clicked => {
                Prefs.ontop = !Prefs.ontop;
                Prefs.changed("ontop");
            }
        }
        Rectangle {
            width: 6px;
        }
        WinButtons { }
    }
}

// Przyciski odtwarzania, głośność i przełączniki.
export component ControlsBar inherits Rectangle {
    height: 56px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 4px;
        alignment: stretch;
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.prev;
                size: 38px;
                icon-size: 22px;
                tip: @tr("Previous (Ctrl+←)");
                clicked => { Player.prev(); }
            }
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 46px;
                height: 46px;
                border-radius: 23px;
                background: pta.pressed ? Theme.tint.darker(0.2) : pta.has-hover ? Theme.tint.brighter(0.15) : Theme.tint;
                drop-shadow-blur: 12px;
                drop-shadow-color: Theme.tint.with-alpha(0.45);
                animate background { duration: 120ms; }
                Icon {
                    icon: Player.playing ? Icons.pause : Icons.play;
                    size: 26px;
                    fill: Theme.on-accent;
                }
                pta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Player.play-pause(); }
                }
            }
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.next;
                size: 38px;
                icon-size: 22px;
                tip: @tr("Next (Ctrl+→)");
                clicked => { Player.next(); }
            }
            if root.width >= 480px: IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.stop;
                size: 34px;
                icon-size: 18px;
                active: Player.stop-after;
                tip: @tr("Stop (right-click – after current)");
                clicked => { Player.stop(); }
                right-clicked => { Ui.key("stop-after", false, false, false); }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        HorizontalLayout {
            spacing: 2px;
            alignment: end;
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.shuffle;
                active: Player.shuffle;
                tip: @tr("Shuffle (S)");
                clicked => { Player.toggle-shuffle(); }
            }
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Player.repeat == 2 ? Icons.repeat-one : Icons.repeat;
                active: Player.repeat > 0;
                tip: Player.repeat == 0 ? @tr("Repeat off (R)") : Player.repeat == 1 ? @tr("Repeat list (R)") : @tr("Repeat track (R)");
                clicked => { Player.cycle-repeat(); }
            }
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.equalizer;
                active: Ui.equalizer || Prefs.eq-on;
                tip: @tr("Equalizer and effects (E)");
                clicked => { Ui.equalizer = !Ui.equalizer; }
            }
            if root.width >= 600px: IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.timer;
                active: Player.sleep-text != "";
                tip: @tr("Sleep timer");
                clicked => { Ui.sleep-menu(self.absolute-position.x, self.absolute-position.y); }
            }
            if root.width >= 600px: IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.lyrics;
                active: Prefs.side-panel > 0;
                tip: @tr("Lyrics, info, queue (L)");
                clicked => {
                    Prefs.side-panel = Prefs.side-panel > 0 ? 0 : 1;
                    Prefs.changed("side-panel");
                }
            }
            Rectangle {
                width: 10px;
            }
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Player.muted || Player.volume == 0 ? Icons.volume-off : Player.volume < 0.5 ? Icons.volume-low : Icons.volume;
                tip: @tr("Mute (M)");
                clicked => { Player.toggle-mute(); }
            }
            HSlider {
                y: (parent.height - self.height) / 2;
                width: root.width < 560px ? 64px : 110px;
                value: Player.volume;
                fill-color: Player.muted ? Theme.text3 : Theme.tint;
                moved(v) => { Player.set-volume(v); }
            }
            if root.width >= 520px: Text {
                width: 36px;
                text: round(Player.volume * 100) + "%";
                color: Theme.text3;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }
}

// Panel nawigacji: listy, biblioteka, zbiory, radio.
// Widok utworów jednym suwakiem: lista po lewej, dalej coraz większe okładki.
component ViewSize inherits HorizontalLayout {
    spacing: 4px;
    IconBtn {
        y: (parent.height - self.height) / 2;
        icon: Icons.playlist;
        size: 26px;
        icon-size: 15px;
        tip: @tr("List");
        clicked => { Prefs.set-view(90); }
    }
    HSlider {
        y: (parent.height - self.height) / 2;
        width: 110px;
        minimum: 90;
        maximum: 280;
        step: 10;
        value: Prefs.view-size;
        moved(v) => { Prefs.set-view(v); }
        reset => { Prefs.set-view(160); }
    }
    IconBtn {
        y: (parent.height - self.height) / 2;
        icon: Icons.album;
        size: 26px;
        icon-size: 15px;
        tip: @tr("Large covers");
        clicked => { Prefs.set-view(280); }
    }
}

export component Sidebar inherits Rectangle {
    width: Prefs.sidebar-width * 1px;
    GlassFill {
        base: Theme.side-glass;
    }
    VerticalLayout {
        padding: 10px;
        padding-top: 4px;
        Rectangle {
            height: 52px;
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        Ui.drag();
                    }
                }
                double-clicked => { Ui.toggle-maximize(); }
            }
            // Menu po lewej, logo na środku, chowanie panelu po prawej.
            HorizontalLayout {
                padding-left: 2px;
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.menu;
                    size: 32px;
                    tip: @tr("Menu");
                    clicked => { Ui.open-main-menu(self.absolute-position.x, self.absolute-position.y + self.height + 2px); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Brand {
                    show-menu: false;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.back;
                    size: 32px;
                    tip: @tr("Hide navigation panel");
                    clicked => {
                        Prefs.show-sidebar = false;
                        Prefs.changed("show-sidebar");
                    }
                }
            }
        }
        ListView {
            for n in Lib.nav: Rectangle {
                height: Theme.nav-h;
                // Klik w nagłówek sekcji zwija ją albo rozwija.
                if n.section: sta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Lib.nav-toggle(n.id); }
                }
                if n.section: HorizontalLayout {
                    padding-left: 12px;
                    padding-top: Theme.dense ? 8px : 14px;
                    padding-right: 4px;
                    spacing: 4px;
                    SectionTitle {
                        text: n.label;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    // Strzałka w pionie na środku tekstu nagłówka (komórka układu ma jego wysokość).
                    Rectangle {
                        width: 14px;
                        horizontal-stretch: 0;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            icon: n.expander == 1 ? Icons.chevron-right : Icons.chevron-down;
                            size: 14px;
                            fill: Theme.text3;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    if n.id == "sec-folders": IconBtn {
                        icon: Icons.add;
                        size: 24px;
                        icon-size: 15px;
                        tip: @tr("Add music folder");
                        clicked => { Prefs.add-folder(0); }
                    }
                }
                if !n.section: Rectangle {
                    y: 2px;
                    height: parent.height - 4px;
                    border-radius: 10px;
                    background: Lib.nav-selected == n.id ? Theme.sel : nta.has-hover ? Theme.hover : transparent;
                    animate background { duration: 120ms; }
                    // Zaznaczenie: kropka akcentu po prawej.
                    if Lib.nav-selected == n.id: Rectangle {
                        x: parent.width - 12px;
                        y: (parent.height - self.height) / 2;
                        width: 5px;
                        height: 5px;
                        border-radius: 2.5px;
                        background: Theme.tint;
                    }
                    HorizontalLayout {
                        // Drzewo folderów: wcięcie wg poziomu i miejsce na strzałkę.
                        padding-left: 12px;
                        padding-right: 18px;
                        spacing: 12px;
                        if n.icon == "folder-open" || n.depth > 0: Rectangle {
                            width: 16px + n.depth * 14px;
                            if n.expander > 0: Icon {
                                x: n.depth * 14px;
                                icon: n.expander == 2 ? Icons.chevron-down : Icons.chevron-right;
                                size: 16px;
                                fill: Theme.text3;
                            }
                        }
                        Rectangle {
                            width: 26px;
                            Icon {
                                icon: Icons.get(n.icon);
                                size: 17px;
                                fill: Lib.nav-selected == n.id ? Theme.tint : Theme.text2;
                            }
                        }
                        Text {
                            text: n.label;
                            color: Lib.nav-selected == n.id ? Theme.text : Theme.text2;
                            font-weight: Lib.nav-selected == n.id ? 600 : 400;
                            font-size: Theme.nav-fs;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: n.count;
                            color: Theme.text3;
                            font-size: Theme.nav-fs-xs;
                            vertical-alignment: center;
                        }
                    }
                    nta := TouchArea {
                        clicked => { Lib.nav-clicked(n.id); }
                        double-clicked => {
                            if n.expander > 0 {
                                Lib.nav-toggle(n.id);
                            }
                        }
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                                Lib.nav-menu(n.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    // Strzałka przy folderze: rozwija i zwija podfoldery (nad obszarem kliknięcia wiersza).
                    if n.expander > 0: TouchArea {
                        x: 12px + n.depth * 14px - 4px;
                        width: 24px;
                        mouse-cursor: pointer;
                        clicked => { Lib.nav-toggle(n.id); }
                    }
                }
            }
        }
        if Lib.scanning: VerticalLayout {
            padding: 8px;
            spacing: 6px;
            Text {
                text: Lib.scan-text;
                color: Theme.text3;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            Rectangle {
                height: 3px;
                border-radius: 2px;
                background: Theme.hover;
                Rectangle {
                    x: 0;
                    width: parent.width * Lib.scan-progress;
                    border-radius: 2px;
                    background: Theme.tint;
                }
            }
        }
    }
    // Prawa krawędź: przeciąganie zmienia szerokość panelu.
    TouchArea {
        x: parent.width - 4px;
        width: 6px;
        mouse-cursor: MouseCursor.ew-resize;
        moved => {
            if self.pressed {
                Prefs.sidebar-width = clamp(Prefs.sidebar-width + (self.mouse-x - self.pressed-x) / 1px, 180, 420);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up {
                Prefs.changed("sidebar-width");
            }
        }
    }
}

export component PlaylistView inherits Rectangle {
    clip: true;
    VerticalLayout {
        HorizontalLayout {
            height: 44px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            Flickable {
                horizontal-stretch: 1;
                content-width: tabrow.preferred-width;
                interactive: false;
                tabrow := HorizontalLayout {
                    spacing: 2px;
                    alignment: start;
                    for t[i] in Lists.tabs: Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 30px;
                        width: tl.preferred-width + 18px + (i == Lists.active ? 22px : 0px);
                        border-radius: Theme.radius;
                        background: i == Lists.active ? Theme.sel : tta.has-hover ? Theme.hover : transparent;
                        tta := TouchArea {
                            clicked => { Lists.tab-clicked(i); }
                            double-clicked => { Lists.tab-menu(i, -1px, -1px); }
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.up && e.button == PointerEventButton.middle {
                                    Lists.tab-close(i);
                                }
                                if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                                    Lists.tab-menu(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 6px;
                            spacing: 4px;
                            tl := Text {
                                text: t.label + (t.count != "" ? "  " + t.count : "");
                                color: i == Lists.active ? Theme.text : Theme.text2;
                                font-weight: i == Lists.active ? 600 : 400;
                                font-size: Theme.fs;
                                vertical-alignment: center;
                            }
                            if i == Lists.active: IconBtn {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.close;
                                tip: @tr("Close list");
                                size: 20px;
                                icon-size: 12px;
                                clicked => { Lists.tab-close(i); }
                            }
                        }
                    }
                    IconBtn {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.add;
                        size: 28px;
                        icon-size: 16px;
                        tip: @tr("New list (Ctrl+N)");
                        clicked => { Lists.tab-add(); }
                    }
                }
            }
            ViewSize {
                y: (parent.height - self.height) / 2;
            }
            Field {
                y: (parent.height - self.height) / 2;
                width: 210px;
                icon: Icons.search;
                placeholder: @tr("Search the list (Ctrl+F)");
                text <=> Lists.filter;
                edited(t) => { Lists.filter-changed(t); }
                escape => {
                    Lists.filter = "";
                    Lists.filter-changed("");
                }
            }
        }
        Divider { }
        TrackList {
            vertical-stretch: 1;
            rows: Lists.rows;
            grid: Prefs.track-grid;
            tile: Prefs.grid-size * 1px;
            zoom(d) => {
                Prefs.set-view(clamp(Prefs.view-size + d, 90, 280));
            }
            show-album: !Lists.grouped;
            scroll-y: Lists.scroll-y;
            scroll-gen: Lists.scroll-gen;
            empty-text: Lists.filter != "" ? @tr("Nothing matches “{}”", Lists.filter) : @tr("The list is empty.\nDrag files or folders here, or double-click to choose them.");
            clicked(i, c, s) => { Lists.row-clicked(i, c, s); }
            band(r0, r1, c0, c1, n, k) => { Lists.row-band(r0, r1, c0, c1, n, k); }
            double(i) => { Lists.row-double(i); }
            menu(i, x, y) => { Lists.row-menu(i, x, y); }
            header-clicked(i) => { Lists.header-clicked(i); }
            header-double(i) => { Lists.header-double(i); }
            fav(i) => { Lists.fav-toggle(i); }
            empty-clicked => { Lists.open-files(); }
        }
        Divider { }
        HorizontalLayout {
            height: 28px;
            padding-left: 14px;
            padding-right: 14px;
            Text {
                text: Lists.summary;
                color: Theme.text3;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// Bez własnego tła i obrysu – siatka i lista leżą wprost na tle okna.
export component LibraryView inherits Rectangle {
    clip: true;
    VerticalLayout {
        HorizontalLayout {
            height: 56px;
            padding-left: 12px;
            padding-right: 10px;
            spacing: 8px;
            if Lib.can-back: IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.back;
                tip: @tr("Back (Backspace)");
                clicked => { Lib.back(); }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: Lib.title;
                    color: Theme.heading;
                    font-size: Theme.fs-xl;
                    font-family: Theme.font-serif;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                if Lib.subtitle != "": Text {
                    text: Lib.subtitle;
                    color: Theme.text3;
                    font-size: Theme.fs-sm;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
            // Odtwarzanie całego folderu – przycisk główny i dwie ikony, bez rozciągania na pasek.
            if !Lib.show-tiles && Lib.rows.length > 0: HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 4px;
                Btn {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 0;
                    text: @tr("Play");
                    icon: Icons.play;
                    primary: true;
                    clicked => { Lib.play-all(); }
                }
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.shuffle;
                    tip: @tr("Shuffle play");
                    clicked => { Lib.shuffle-all(); }
                }
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.add;
                    tip: @tr("Add all to the list");
                    clicked => { Lib.add-all(); }
                }
            }
            if !Lib.show-tiles: ViewSize {
                y: (parent.height - self.height) / 2;
            }
            // Zbiory (ulubione, historia…): muzyka, filmy albo jedno i drugie.
            if Lib.kind-filter-shown: Segmented {
                y: (parent.height - self.height) / 2;
                options: [@tr("All"), @tr("Music"), @tr("Videos")];
                selected: Lib.kind-filter;
                changed(i) => {
                    Lib.kind-filter = i;
                    Lib.kind-filter-changed(i);
                }
            }
            Field {
                y: (parent.height - self.height) / 2;
                width: 200px;
                icon: Icons.search;
                placeholder: @tr("Search the library");
                text <=> Lib.search;
                edited(t) => { Lib.search-changed(t); }
                escape => {
                    Lib.search = "";
                    Lib.search-changed("");
                }
            }
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.refresh;
                tip: @tr("Refresh library");
                enabled: !Lib.scanning;
                clicked => { Lib.rescan(); }
            }
        }
        Divider { }
        if Lib.show-tiles && Lib.grid: ScrollView {
            vertical-stretch: 1;
            property <int> cols: max(1, floor((self.visible-width - 24px) / 168px));
            property <length> cell: (self.visible-width - 24px) / cols;
            property <length> extra: Prefs.caption-overlay ? 0px : 46px;
            content-height: ceil(Lib.tiles.length / cols) * (cell + extra) + 24px;
            for t[i] in Lib.tiles: Rectangle {
                x: 12px + mod(i, parent.cols) * parent.cell;
                y: 12px + floor(i / parent.cols) * (parent.cell + parent.extra);
                width: parent.cell;
                height: parent.cell + parent.extra;
                Rectangle {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: parent.height - 12px;
                    border-radius: Theme.radius;
                    background: transparent;
                    tcov := Cover {
                        x: 6px;
                        y: gta.has-hover ? 2px : 6px;
                        width: parent.width - 12px;
                        height: self.width;
                        source: t.cover;
                        has: t.has-cover;
                        drop-shadow-blur: gta.has-hover ? 26px : 10px;
                        drop-shadow-offset-y: gta.has-hover ? 8px : 3px;
                        drop-shadow-color: gta.has-hover ? Theme.glow : #00000080;
                        animate y, drop-shadow-blur, drop-shadow-offset-y { duration: 180ms; easing: ease-out; }
                    }
                    if Prefs.caption-overlay: Rectangle {
                        x: tcov.x;
                        y: tcov.y + tcov.height - self.height;
                        width: tcov.width;
                        height: 52px;
                        border-bottom-left-radius: tcov.border-radius;
                        border-bottom-right-radius: tcov.border-radius;
                        background: @linear-gradient(0deg, #000000d8 0%, #00000099 55%, #00000000 100%);
                    }
                    Text {
                        x: Prefs.caption-overlay ? tcov.x + 8px : 8px;
                        y: Prefs.caption-overlay ? tcov.y + tcov.height - 40px : parent.width;
                        width: Prefs.caption-overlay ? tcov.width - 16px : parent.width - 16px;
                        text: t.name;
                        color: Prefs.caption-overlay ? (gta.has-hover ? Theme.tint-hi : #ffffff) : gta.has-hover ? Theme.tint-hi : Theme.text;
                        font-size: Theme.fs;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        x: Prefs.caption-overlay ? tcov.x + 8px : 8px;
                        y: Prefs.caption-overlay ? tcov.y + tcov.height - 22px : parent.width + 17px;
                        width: Prefs.caption-overlay ? tcov.width - 16px : parent.width - 16px;
                        text: t.sub;
                        color: Prefs.caption-overlay ? #ffffffb8 : Theme.text3;
                        font-size: Theme.fs-sm;
                        overflow: elide;
                    }
                }
                gta := TouchArea {
                    clicked => { Lib.tile-clicked(t.key); }
                    double-clicked => { Lib.tile-double(t.key); }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                            Lib.tile-menu(t.key, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
            }
        }
        if Lib.show-tiles && !Lib.grid: ListView {
            vertical-stretch: 1;
            for t in Lib.tiles: Rectangle {
                height: Theme.item-h;
                Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    border-radius: Theme.radius;
                    background: lta.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 12px;
                        spacing: 12px;
                        Cover {
                            y: (parent.height - self.height) / 2;
                            width: 32px;
                            height: 32px;
                            source: t.cover;
                            has: t.has-cover;
                            fallback: Lib.nav-selected == "artist" ? Icons.artist : Lib.nav-selected == "genre" ? Icons.tag : Lib.nav-selected == "year" ? Icons.calendar : Icons.folder;
                            border-radius: Lib.nav-selected == "artist" ? 16px : 5px;
                        }
                        Text {
                            text: t.name;
                            color: Theme.text;
                            font-size: Theme.fs;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: t.sub;
                            color: Theme.text3;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                        Text {
                            text: t.count;
                            color: Theme.text3;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                            width: 80px;
                            horizontal-alignment: right;
                        }
                    }
                    lta := TouchArea {
                        clicked => { Lib.tile-clicked(t.key); }
                        double-clicked => { Lib.tile-double(t.key); }
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                                Lib.tile-menu(t.key, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                }
            }
        }
        if !Lib.show-tiles: TrackList {
            vertical-stretch: 1;
            rows: Lib.rows;
            grid: Prefs.track-grid && !Lib.seasons;
            tile: Prefs.grid-size * 1px;
            zoom(d) => {
                Prefs.set-view(clamp(Prefs.view-size + d, 90, 280));
            }
            show-album: true;
            empty-text: Lib.empty-text;
            empty-icon: Icons.library;
            clicked(i, c, s) => { Lib.row-clicked(i, c, s); }
            band(r0, r1, c0, c1, n, k) => { Lib.row-band(r0, r1, c0, c1, n, k); }
            double(i) => { Lib.row-double(i); }
            menu(i, x, y) => { Lib.row-menu(i, x, y); }
            fav(i) => { Lists.fav-toggle(-1 - i); }
        }
        if Lib.show-tiles && Lib.tiles.length == 0: Text {
            vertical-stretch: 1;
            text: Lib.empty-text;
            color: Theme.text3;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component RadioView inherits Rectangle {
    clip: true;
    VerticalLayout {
        HorizontalLayout {
            height: 56px;
            padding-left: 14px;
            padding-right: 10px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Internet radio");
                    color: Theme.heading;
                    font-size: Theme.fs-xl;
                    font-family: Theme.font-serif;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: @tr("The radio-browser.info directory – tens of thousands of stations from around the world");
                    color: Theme.text3;
                    font-size: Theme.fs-sm;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
            Segmented {
                y: (parent.height - self.height) / 2;
                options: [@tr("My country"), @tr("World"), @tr("Saved")];
                selected <=> Lib.radio-source;
                changed(i) => { Lib.radio-source-changed(i); }
            }
            Field {
                y: (parent.height - self.height) / 2;
                width: 210px;
                icon: Icons.search;
                placeholder: @tr("Search stations or genres");
                text <=> Lib.radio-query;
                accepted(t) => { Lib.radio-search(t); }
                escape => {
                    Lib.radio-query = "";
                    Lib.radio-search("");
                }
            }
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.link;
                tip: @tr("Add station from URL");
                clicked => { Lib.radio-add-url(); }
            }
        }
        Divider { }
        if Lib.radio-busy: Text {
            vertical-stretch: 1;
            text: @tr("Loading stations…");
            color: Theme.text3;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if !Lib.radio-busy && Lib.stations.length == 0: Text {
            vertical-stretch: 1;
            text: Lib.radio-source == 2 ? @tr("No saved stations – click the star next to a station to save it.") : @tr("No stations. Check your internet connection.");
            color: Theme.text3;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        if !Lib.radio-busy && Lib.stations.length > 0: ListView {
            vertical-stretch: 1;
            for s[i] in Lib.stations: Rectangle {
                height: 46px;
                Rectangle {
                    x: 8px;
                    width: parent.width - 16px;
                    border-radius: Theme.radius;
                    background: sta.has-hover ? Theme.hover : transparent;
                    sta := TouchArea {
                        double-clicked => { Lib.radio-play(i); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 12px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.radio;
                            size: 18px;
                            fill: Theme.text3;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: s.name;
                                color: Theme.text;
                                font-size: Theme.fs;
                                font-weight: 500;
                                overflow: elide;
                            }
                            Text {
                                text: s.info;
                                color: Theme.text3;
                                font-size: Theme.fs-xs;
                                overflow: elide;
                            }
                        }
                        IconBtn {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.star;
                            active: s.saved;
                            icon-color: s.saved ? #ffc94a : Theme.text3;
                            tip: s.saved ? @tr("Remove from saved") : @tr("Save station");
                            clicked => { Lib.radio-save(i); }
                        }
                        IconBtn {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.play;
                            tip: @tr("Listen");
                            clicked => { Lib.radio-play(i); }
                        }
                    }
                }
            }
        }
    }
}

// Panel po prawej: tekst piosenki, informacje o utworze, kolejka.
export component SidePanel inherits Rectangle {
    width: 300px;
    // Tekst jest obok opisu utworu – karta „Tekst” znika, zostają informacje i kolejka.
    property <int> page: Player.hero-lyrics && Prefs.side-panel == 1 ? 2 : Prefs.side-panel;
    GlassFill {
        border-radius: Theme.radius-lg;
    }
    border-radius: Theme.radius-lg;
    clip: true;
    VerticalLayout {
        HorizontalLayout {
            height: 46px;
            padding-left: 10px;
            padding-right: 6px;
            spacing: 4px;
            Segmented {
                y: (parent.height - self.height) / 2;
                small: true;
                options: Player.hero-lyrics ? [@tr("Info"), @tr("Queue")] : [@tr("Lyrics"), @tr("Info"), @tr("Queue")];
                selected: Player.hero-lyrics ? root.page - 2 : root.page - 1;
                changed(i) => {
                    Prefs.side-panel = Player.hero-lyrics ? i + 2 : i + 1;
                    Prefs.changed("side-panel");
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.close;
                tip: @tr("Close panel");
                size: 26px;
                icon-size: 14px;
                clicked => {
                    Prefs.side-panel = 0;
                    Prefs.changed("side-panel");
                }
            }
        }
        Divider { }
        if root.page == 1 && Player.subs-mode && Player.sub-langs.length > 0: HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            Text {
                text: @tr("Subtitles");
                color: Theme.text3;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }
            ComboBox {
                horizontal-stretch: 1;
                model: Player.sub-langs;
                current-index: Player.sub-lang;
                selected => { Player.pick-sub-lang(self.current-index); }
            }
        }
        // Szukanie w tekście / napisach tego utworu: Enter – następne, Shift+Enter… strzałki obok.
        if root.page == 1 && Player.lyrics.length > 0: HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            padding-top: 8px;
            padding-bottom: 4px;
            spacing: 2px;
            Field {
                horizontal-stretch: 1;
                icon: Icons.search;
                placeholder: Player.subs-mode ? @tr("Search subtitles") : @tr("Search lyrics");
                text <=> Player.lyrics-query;
                edited(t) => { Player.lyrics-search(t); }
                accepted(t) => { Player.lyrics-next(1); }
                escape => {
                    Player.lyrics-query = "";
                    Player.lyrics-search("");
                }
            }
            if Player.lyrics-query != "": Text {
                text: Player.lyrics-hits == 0 ? "0" : (Player.lyrics-hit + 1) + "/" + Player.lyrics-hits;
                color: Player.lyrics-hits == 0 ? Theme.danger : Theme.text3;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                min-width: 34px;
                horizontal-alignment: center;
            }
            if Player.lyrics-query != "": IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.chevron-up;
                size: 26px;
                icon-size: 15px;
                tip: @tr("Previous match");
                enabled: Player.lyrics-hits > 0;
                clicked => { Player.lyrics-next(-1); }
            }
            if Player.lyrics-query != "": IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.chevron-down;
                size: 26px;
                icon-size: 15px;
                tip: @tr("Next match (Enter)");
                enabled: Player.lyrics-hits > 0;
                clicked => { Player.lyrics-next(1); }
            }
        }
        if root.page == 1: Rectangle {
            vertical-stretch: 1;
            if Player.lyrics.length == 0: Text {
                text: !Player.subs-mode ? @tr("No lyrics for this track.\nOpenMP reads .lrc files next to the track and lyrics stored in tags.")
                    : Player.sub-langs.length == 0 ? @tr("This movie has no text subtitles.\nLoad or download subtitles in the movie panel.")
                    : @tr("Loading subtitles…");
                color: Theme.text3;
                font-size: Theme.fs;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                width: parent.width - 40px;
            }
            if Player.lyrics.length > 0: lyr := Flickable {
                // Kwestie z filmu są dłuższe – dwa wiersze.
                property <length> line-h: Player.subs-mode ? LyricStyle.line-h * 1.6 : LyricStyle.line-h;
                property <length> base: Player.lyrics-synced ? self.height / 2 - self.line-h : 16px;
                content-height: Player.lyrics.length * line-h + self.height;
                property <int> act: Player.lyrics-active;
                property <int> want: Player.lyrics-focus;
                // Bieżąca linia na środku – chyba że trwa wyszukiwanie (wtedy widok trzyma trafienie).
                changed act => {
                    if Player.lyrics-synced && self.act >= 0 && Player.lyrics-query == "" {
                        self.content-y = -(self.act * self.line-h);
                    }
                }
                changed want => {
                    if self.want >= 0 {
                        self.content-y = -max(0px, self.base + self.want * self.line-h - self.height / 2 + self.line-h / 2);
                    }
                }
                animate content-y { duration: 350ms; easing: ease-out; }
                for l[i] in Player.lyrics: Rectangle {
                    x: 8px;
                    y: lyr.base + i * lyr.line-h;
                    width: lyr.width - 16px;
                    height: lyr.line-h;
                    border-radius: Theme.radius;
                    // Trafienie wyszukiwania – tło, bieżące trafienie mocniej; najechanie – lekko.
                    background: l.hit ? (i == Player.lyrics-focus ? Theme.sel-strong : Theme.sel) : lta.has-hover && Player.lyrics-synced ? Theme.hover : transparent;
                    LyricText {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: l.text;
                        // Trafienie wyszukiwania liczy się jak bieżąca linia – dobrze widoczne.
                        active: l.active || l.hit;
                        synced: Player.lyrics-synced;
                        dist: abs(i - Player.lyrics-active);
                        wrap: Player.subs-mode ? word-wrap : no-wrap;
                        overflow: elide;
                    }
                    // Klik – przewinięcie utworu albo filmu do tej linii (gdy tekst ma czasy).
                    lta := TouchArea {
                        mouse-cursor: Player.lyrics-synced ? MouseCursor.pointer : MouseCursor.default;
                        clicked => {
                            if Player.lyrics-synced {
                                Player.lyrics-seek(i);
                            }
                        }
                    }
                }
            }
            if Player.lyrics-source == "LRCLIB": Rectangle {
                x: parent.width - self.width - 10px;
                y: parent.height - self.height - 10px;
                width: lsrc.preferred-width + 20px;
                height: 26px;
                border-radius: 13px;
                background: lsa.has-hover ? Theme.sel : Theme.raised;
                border-width: 1px;
                border-color: Theme.line2;
                lsrc := Text {
                    text: @tr("LRCLIB · save next to the track");
                    color: Theme.text2;
                    font-size: Theme.fs-xs;
                }
                lsa := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Player.save-lyrics(); }
                }
            }
        }
        if root.page == 2: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Cover {
                    height: self.width;
                    source: Player.cover;
                    has: Player.has-cover;
                    fallback: Icons.note;
                    border-radius: 10px;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Player.open-cover(); }
                    }
                }
                for d in Player.details: VerticalLayout {
                    spacing: 1px;
                    Text {
                        text: d.label;
                        color: Theme.text3;
                        font-size: Theme.fs-xs;
                    }
                    Text {
                        text: d.sub;
                        color: Theme.text;
                        font-size: Theme.fs;
                        wrap: word-wrap;
                    }
                }
            }
        }
        if root.page == 3: VerticalLayout {
            vertical-stretch: 1;
            if Player.queue.length == 0: Text {
                vertical-stretch: 1;
                text: @tr("The queue is empty.\nRight-click a track → “Play next”.");
                color: Theme.text3;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            if Player.queue.length > 0: ListView {
                vertical-stretch: 1;
                for q[i] in Player.queue: Rectangle {
                    height: 40px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 6px;
                        spacing: 8px;
                        Text {
                            text: (i + 1) + ".";
                            color: Theme.text3;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                            width: 20px;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: q.title;
                                color: Theme.text;
                                font-size: Theme.fs;
                                overflow: elide;
                            }
                            Text {
                                text: q.artist;
                                color: Theme.text3;
                                font-size: Theme.fs-xs;
                                overflow: elide;
                            }
                        }
                        IconBtn {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.close;
                            tip: @tr("Remove from queue");
                            size: 24px;
                            icon-size: 13px;
                            clicked => { Player.queue-remove(i); }
                        }
                    }
                }
            }
            if Player.queue.length > 0: HorizontalLayout {
                padding: 10px;
                alignment: end;
                Btn {
                    text: @tr("Clear queue");
                    compact: true;
                    clicked => { Player.queue-clear(); }
                }
            }
        }
    }
}
