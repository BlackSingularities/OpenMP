// Kontrolki wspólne dla całego programu – jeden wygląd w trybie muzyki, wideo i w ustawieniach.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";

export component Icon inherits Path {
    in property <string> icon;
    in property <length> size: 18px;
    width: size;
    height: size;
    commands: icon;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: Theme.text2;
    stroke-width: 0;
}

export component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <length> size: 32px;
    in property <length> icon-size: 18px;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <color> icon-color: active ? Theme.tint : Theme.text2;
    in property <color> hover-color: active ? Theme.tint : Theme.text;
    in property <bool> round: true;
    in property <bool> on-dark: false;
    // Podpowiedź nad przyciskiem – dla przycisków przy dolnej krawędzi okna.
    in property <bool> tip-above: false;
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    callback right-clicked();
    // Czytniki ekranu (Narrator, NVDA): przycisk z nazwą z podpowiedzi.
    accessible-role: button;
    accessible-label: root.tip != "" ? root.tip : root.icon;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    width: size;
    height: size;
    border-radius: round ? self.height / 2 : Theme.radius;
    background: !enabled ? transparent : ta.pressed ? (on-dark ? #ffffff26 : Theme.press) : ta.has-hover ? (on-dark ? #ffffff17 : Theme.hover) : transparent;
    border-width: fs.has-focus ? 2px : 0;
    border-color: Theme.tint;
    animate background { duration: 120ms; }
    Icon {
        icon: root.icon;
        size: root.icon-size;
        fill: !root.enabled ? Theme.text3.with-alpha(0.5) : ta.has-hover ? root.hover-color : root.icon-color;
        animate fill { duration: 120ms; }
    }
    if root.active && !root.on-dark: Rectangle {
        y: parent.height - 5px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: Theme.tint;
    }
    // Klawiatura: Tab dochodzi tu, Spacja/Enter naciska; inne klawisze idą do skrótów okna.
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.right-clicked();
            }
        }
    }
    if root.tip != "" && ta.has-hover: Rectangle {
        // Podpowiedź pod przyciskiem (nad, gdy przycisk jest nisko w oknie).
        y: root.tip-above ? -self.height - 6px : parent.height + 6px;
        height: 22px;
        width: tipt.preferred-width + 14px;
        x: (parent.width - self.width) / 2;
        border-radius: 5px;
        background: #000000e0;
        opacity: 0;
        animate opacity { duration: 150ms; delay: 600ms; }
        init => { self.opacity = 1; }
        tipt := Text {
            text: root.tip;
            color: #f2f4f8;
            font-size: Theme.fs-sm;
        }
    }
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <bool> compact;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    height: compact ? 26px : 32px;
    min-width: lay.preferred-width + (compact ? 18px : 26px);
    border-radius: Theme.radius;
    background: !enabled ? Theme.hover : primary ? (ta.pressed ? Theme.tint.darker(0.2) : ta.has-hover ? Theme.tint.brighter(0.12) : Theme.tint) : danger ? (ta.has-hover ? Theme.danger.with-alpha(0.25) : Theme.danger.with-alpha(0.15)) : (ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : Theme.panel2);
    border-width: fs.has-focus ? 2px : primary || danger ? 0 : 1px;
    border-color: fs.has-focus ? Theme.tint.brighter(0.3) : Theme.line2;
    animate background { duration: 120ms; }
    lay := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: root.compact ? 9px : 13px;
        padding-right: self.padding-left;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            size: 16px;
            fill: root.primary ? Theme.on-accent : root.danger ? Theme.danger : Theme.text2;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: root.compact ? Theme.fs-sm : Theme.fs;
            font-weight: root.primary ? 600 : 500;
            color: !root.enabled ? Theme.text3 : root.primary ? Theme.on-accent : root.danger ? Theme.danger : Theme.text;
        }
    }
    // Klawiatura: Tab dochodzi tu, Spacja/Enter naciska; inne klawisze idą do skrótów okna.
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Poziomy suwak 0..1 (głośność, balans, ustawienia).
export component HSlider inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> centered;
    in property <color> fill-color: Theme.tint;
    in property <color> track-color: Theme.dark ? #ffffff1f : #0000001a;
    in property <length> thickness: 4px;
    in property <float> step: 0;
    out property <bool> dragging: ta.pressed;
    callback moved(float);
    callback committed(float);
    callback reset();
    accessible-role: slider;
    accessible-value: round(root.value * 100) / 100;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    height: 18px;
    min-width: 60px;
    property <float> frac: (value - minimum) / (maximum - minimum);
    track := Rectangle {
        height: root.thickness;
        width: 100%;
        border-radius: self.height / 2;
        background: root.track-color;
    }
    if !root.centered: Rectangle {
        x: 0;
        height: root.thickness;
        width: root.width * clamp(root.frac, 0, 1);
        border-radius: self.height / 2;
        background: root.fill-color;
    }
    if root.centered: Rectangle {
        x: min(root.width / 2, root.width * root.frac);
        height: root.thickness;
        width: abs(root.width * root.frac - root.width / 2);
        border-radius: self.height / 2;
        background: root.fill-color;
    }
    Rectangle {
        x: root.width * clamp(root.frac, 0, 1) - self.width / 2;
        width: ta.has-hover || ta.pressed ? 14px : 10px;
        height: self.width;
        border-radius: self.width / 2;
        background: ta.has-hover || ta.pressed ? Theme.knob : root.fill-color;
        border-width: fs.has-focus ? 2px : 0;
        border-color: Theme.tint.brighter(0.4);
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000066;
        animate width { duration: 100ms; }
    }
    function pick(x: length) -> float {
        let v = root.minimum + clamp(x / root.width, 0, 1) * (root.maximum - root.minimum);
        if root.step > 0 {
            return round(v / root.step) * root.step;
        }
        return v;
    }
    function nudge(dir: float) {
        let d = (root.step > 0 ? root.step : (root.maximum - root.minimum) / 50) * dir;
        root.value = clamp(root.value + d, root.minimum, root.maximum);
        root.moved(root.value);
        root.committed(root.value);
    }
    // Klawiatura po Tabie: strzałki przesuwają, Home/End na skraj.
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.LeftArrow || e.text == Key.DownArrow {
                root.nudge(-1);
                return accept;
            }
            if e.text == Key.RightArrow || e.text == Key.UpArrow {
                root.nudge(1);
                return accept;
            }
            if e.text == Key.Home || e.text == Key.End {
                root.value = e.text == Key.Home ? root.minimum : root.maximum;
                root.moved(root.value);
                root.committed(root.value);
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.value = root.pick(self.mouse-x);
                root.moved(root.value);
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                root.committed(root.value);
            }
        }
        moved => {
            if self.pressed {
                root.value = root.pick(self.mouse-x);
                root.moved(root.value);
            }
        }
        double-clicked => { root.reset(); }
        scroll-event(e) => {
            root.nudge(e.delta-y > 0 ? 1 : -1);
            accept
        }
    }
}

// Pionowy suwak pasma korektora (-15..+15 dB), podwójne kliknięcie zeruje.
export component VSlider inherits Rectangle {
    in-out property <float> value;
    in property <float> range: 15;
    in property <string> label;
    callback moved(float);
    width: 26px;
    property <float> frac: (value + range) / (2 * range);
    VerticalLayout {
        spacing: 6px;
        Text {
            text: (root.value > 0 ? "+" : "") + round(root.value * 10) / 10;
            font-size: 9.5px;
            color: root.value == 0 ? Theme.text3 : Theme.text2;
            horizontal-alignment: center;
        }
        area := Rectangle {
            vertical-stretch: 1;
            Rectangle {
                width: 4px;
                border-radius: 2px;
                background: Theme.dark ? #ffffff1a : #00000014;
            }
            Rectangle {
                width: 4px;
                y: min(parent.height / 2, parent.height * (1 - root.frac));
                height: abs(parent.height * (1 - root.frac) - parent.height / 2);
                border-radius: 2px;
                background: Theme.tint;
            }
            Rectangle {
                y: parent.height / 2;
                width: 10px;
                height: 1px;
                background: Theme.text3.with-alpha(0.5);
            }
            Rectangle {
                y: parent.height * (1 - root.frac) - self.height / 2;
                width: 16px;
                height: 8px;
                border-radius: 3px;
                background: ta.pressed || ta.has-hover ? #ffffff : Theme.text;
                drop-shadow-blur: 3px;
                drop-shadow-color: #00000080;
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                function pick() {
                    root.value = round(clamp((0.5 - self.mouse-y / area.height) * 2 * root.range, -root.range, root.range) * 2) / 2;
                    root.moved(root.value);
                }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        self.pick();
                    }
                }
                moved => {
                    if self.pressed {
                        self.pick();
                    }
                }
                double-clicked => {
                    root.value = 0;
                    root.moved(0);
                }
                scroll-event(e) => {
                    root.value = clamp(root.value + (e.delta-y > 0 ? 0.5 : -0.5), -root.range, root.range);
                    root.moved(root.value);
                    accept
                }
            }
        }
        Text {
            text: root.label;
            font-size: 9.5px;
            color: Theme.text3;
            horizontal-alignment: center;
        }
    }
}

export component Switch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: checked ? Theme.tint : (Theme.dark ? #ffffff24 : #00000024);
    border-width: fs.has-focus ? 2px : 0;
    border-color: Theme.tint.brighter(0.4);
    opacity: enabled ? 1 : 0.45;
    animate background { duration: 150ms; }
    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.checked || Theme.scope == 0 ? #ffffff : Theme.knob;
        animate x { duration: 150ms; easing: ease-out; }
    }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return accept;
            }
            reject
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Wiersz ustawienia: tytuł, opis, kontrolka po prawej.
export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    min-height: 46px;
    // Znalezione w wyszukiwarce ustawień – tło w kolorze akcentu.
    border-radius: Theme.radius;
    background: root.title != "" && root.title == Theme.settings-flash ? Theme.sel-strong : transparent;
    animate background { duration: 400ms; }
    HorizontalLayout {
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.fs;
                wrap: word-wrap;
            }
            if root.hint != "": Text {
                text: root.hint;
                color: Theme.text3;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            alignment: end;
            VerticalLayout {
                alignment: center;
                @children
            }
        }
    }
}

export component SettingSwitch inherits SettingRow {
    in-out property <bool> checked;
    callback toggled(bool);
    Switch {
        accessible-label: root.title;
        checked <=> root.checked;
        toggled(v) => { root.toggled(v); }
    }
}

// Wybór jednej z kilku opcji (pigułki).
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    in property <bool> small;
    callback changed(int);
    height: small ? 26px : 30px;
    border-radius: Theme.radius;
    background: Theme.dark ? #ffffff0c : #0000000a;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            border-radius: Theme.radius - 2px;
            background: i == root.selected ? Theme.raised : sta.has-hover ? Theme.hover : transparent;
            drop-shadow-blur: i == root.selected ? 3px : 0;
            drop-shadow-color: #00000040;
            min-width: st.preferred-width + 18px;
            st := Text {
                text: o;
                font-size: root.small ? Theme.fs-sm : Theme.fs;
                color: i == root.selected ? Theme.text : Theme.text2;
                font-weight: i == root.selected ? 600 : 400;
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

// Pole tekstowe z ikoną i podpowiedzią.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> icon;
    in property <bool> clearable: true;
    out property <bool> focused: ti.has-focus;
    callback edited(string);
    callback accepted(string);
    callback escape();
    height: 30px;
    border-radius: Theme.radius;
    background: Theme.dark ? #ffffff0d : #0000000a;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.tint.with-alpha(0.8) : transparent;
    public function focus-input() {
        ti.focus();
    }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 4px;
        spacing: 6px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            size: 15px;
            fill: Theme.text3;
        }
        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            if root.text == "": Text {
                x: 0;
                text: root.placeholder;
                color: Theme.text3;
                font-size: Theme.fs;
                vertical-alignment: center;
            }
            ti := TextInput {
                text <=> root.text;
                color: Theme.text;
                font-size: Theme.fs;
                vertical-alignment: center;
                selection-background-color: Theme.tint.with-alpha(0.4);
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        root.escape();
                        return accept;
                    }
                    reject
                }
            }
        }
        if root.clearable && root.text != "": IconBtn {
            y: (parent.height - self.height) / 2;
            icon: Icons.close;
            tip: "Wyczyść";
            size: 22px;
            icon-size: 13px;
            clicked => {
                root.text = "";
                root.edited("");
            }
        }
    }
}

// Tekst przewijany w poziomie, gdy się nie mieści (tytuł na wyświetlaczu).
export component Marquee inherits Rectangle {
    in property <string> text;
    in property <length> font-size: Theme.fs;
    in property <int> font-weight: 400;
    in property <color> text-color: Theme.text;
    in property <bool> enabled: true;
    in property <string> font-family: Theme.font;
    clip: true;
    height: t.preferred-height;
    property <length> over: t.preferred-width - self.width;
    property <length> gap: 60px;
    property <length> span: t.preferred-width + gap;
    property <duration> cycle: span / 34px * 1s;
    property <length> off: (enabled && over > 0) ? mod(animation-tick(), cycle + 2.5s) > 2.5s ? -(mod(animation-tick(), cycle + 2.5s) - 2.5s) / cycle * span : 0px : 0px;
    t := Text {
        x: root.off;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-family: root.font-family;
        color: root.text-color;
        width: self.preferred-width;
        overflow: clip;
    }
    if root.enabled && root.over > 0: Text {
        x: root.off + root.span;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-family: root.font-family;
        color: root.text-color;
        width: self.preferred-width;
    }
}

// Mała etykieta na wyświetlaczu („FLAC”, „44,1 kHz”).
export component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> lit;
    height: 17px;
    width: bt.preferred-width + 10px;
    border-radius: 4px;
    background: lit ? Theme.tint.with-alpha(0.22) : #ffffff10;
    border-width: 1px;
    border-color: lit ? Theme.tint.with-alpha(0.55) : #ffffff14;
    bt := Text {
        text: root.text;
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: 0.4px;
        color: root.lit ? Theme.tint.brighter(0.4) : Theme.lcd-dim;
    }
}

// Nagłówek sekcji w panelach.
export component SectionTitle inherits Text {
    color: Theme.text3;
    font-size: Theme.fs-xs;
    font-weight: 700;
    letter-spacing: 0.8px;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

// Okładka z zastępczą ikoną.
export component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> has;
    in property <string> fallback: Icons.album;
    border-radius: 6px;
    clip: true;
    background: Theme.dark ? #ffffff0d : #0000000d;
    if !root.has: Icon {
        icon: root.fallback;
        size: min(root.width, root.height) * 0.42;
        fill: Theme.text3.with-alpha(0.6);
    }
    if root.has: Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: ImageFit.cover;
    }
}
