// Stan programu wymieniany z Rustem – globalne obiekty zamiast setek właściwości okna.

import { StatCard, StatDay, StatTop, TrackRow, NavItem, Tile, MenuEntry, TabItem, LyricLine, Opt, Station, KeyHelp, CustomKey } from "types.slint";

// Odtwarzanie, wyświetlacz i analizator.
export global Player {
    // Opis filmu z TMDB (pusty – brak).
    in-out property <string> overview;
    in-out property <string> credits;
    in-out property <string> title;
    in-out property <string> artist;
    in-out property <string> album;
    in-out property <[string]> badges;
    // Nazwy ikon parametrów (Icons.get) – w tej samej kolejności co badges.
    in-out property <[string]> badge-icons;
    in-out property <string> position-text;
    in-out property <string> state-text;
    in-out property <image> cover;
    in-out property <bool> has-cover;
    in-out property <image> backdrop;
    in-out property <float> pos;
    in-out property <float> duration;
    in-out property <bool> playing;
    in-out property <bool> idle: true;
    in-out property <bool> fav;
    in-out property <float> volume: 0.8;
    in-out property <bool> muted;
    in-out property <bool> shuffle;
    in-out property <int> repeat;
    in-out property <bool> eq-on;
    in-out property <bool> crossfade-on;
    in-out property <bool> rg-on;
    in-out property <string> sleep-text;
    in-out property <string> speed-text;
    in-out property <bool> stop-after;
    in-out property <float> ab-a: -1;
    in-out property <float> ab-b: -1;
    // Analizator
    in-out property <int> viz-mode;
    in-out property <[float]> bars;
    in-out property <[float]> peaks;
    in-out property <string> scope-path;
    in-out property <string> spectrum-path;
    // Ścieżka nowych wizualizacji (tryby 5–10).
    in-out property <string> viz-path;
    in-out property <float> vu-l;
    in-out property <float> vu-r;
    in-out property <float> vu-pl;
    in-out property <float> vu-pr;
    in-out property <bool> viz-active;
    in-out property <string> viz-note;
    in-out property <string> wave;
    // Druga warstwa taśmy (0 – jaśniejsza, 1 – przygaszona) i żywa część przy znaczniku.
    in-out property <string> wave2;
    in-out property <int> wave2-kind;
    in-out property <string> wave-live;
    in-out property <float> live-span: 0.05;
    // Tekst piosenki i informacje
    in-out property <[LyricLine]> lyrics;
    in-out property <bool> lyrics-synced;
    in-out property <int> lyrics-active: -1;
    // Tekst widoczny obok opisu utworu (szerokie okno) – wtedy bez karty w panelu bocznym.
    in-out property <bool> hero-lyrics;
    in-out property <string> lyrics-source;
    callback save-lyrics();
    // Zamknięcie bieżącego pliku krzyżykiem – potem tryb zaznaczenia.
    callback close-current();
    // Tryb zaznaczenia (nic nie gra): szczegóły zaznaczonego pliku, kilku plików albo grupy.
    in-out property <bool> sel-mode;
    in-out property <string> sel-title;
    in-out property <string> sel-sub;
    // Jak przy odtwarzaniu: album i rok (film – rok, gatunki, ocena) oraz parametry z ikonami.
    in-out property <string> sel-album;
    in-out property <bool> sel-movie;
    in-out property <[string]> sel-badges;
    in-out property <[string]> sel-badge-icons;
    // Opis zaznaczonego filmu (TMDB) albo utworu (komentarz) i reżyseria/obsada.
    in-out property <string> sel-overview;
    in-out property <string> sel-credits;
    in-out property <[Opt]> sel-rows;
    in-out property <image> sel-cover;
    in-out property <bool> sel-has-cover;
    // Gra film – w panelu tekstu są jego napisy, z wyborem języka.
    in-out property <bool> subs-mode;
    in-out property <[string]> sub-langs;
    in-out property <int> sub-lang;
    callback pick-sub-lang(int);
    // Wyszukiwanie w tekście / napisach bieżącego utworu i przewijanie do linii.
    in-out property <string> lyrics-query;
    in-out property <int> lyrics-hits;
    in-out property <int> lyrics-hit;
    in-out property <int> lyrics-focus: -1;
    callback lyrics-search(string);
    callback lyrics-next(int);
    callback lyrics-seek(int);
    in-out property <[Opt]> details;
    in-out property <[TrackRow]> queue;

    callback play-pause();
    callback stop();
    callback next();
    callback prev();
    callback seek(float);
    callback seek-rel(float);
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback cycle-viz();
    callback set-viz(int);
    callback toggle-fav();
    callback reveal-current();
    callback show-current();
    callback open-cover();
    callback queue-remove(int);
    callback queue-clear();
}

// Listy odtwarzania.
export global Lists {
    in-out property <[TabItem]> tabs;
    in-out property <int> active;
    in-out property <[TrackRow]> rows;
    in-out property <string> summary;
    in-out property <string> filter;
    in-out property <bool> grouped: true;
    // Dodatkowe kolumny list odtwarzania (wspólne dla wszystkich list).
    in-out property <[int]> columns: [0, 1, 4];
    callback columns-menu(length, length);
    in-out property <length> scroll-y;
    in-out property <int> scroll-gen;
    callback tab-clicked(int);
    callback tab-menu(int, length, length);
    callback tab-add();
    callback tab-close(int);
    callback tab-rename(int, string);
    callback row-clicked(int, bool, bool);
    callback row-band(int, int, int, int, int, bool);
    callback row-double(int);
    callback row-menu(int, length, length);
    callback header-clicked(int);
    callback header-double(int);
    callback filter-changed(string);
    callback fav-toggle(int);
    callback key(string, bool, bool);
    callback open-files();
}

// Biblioteka, zbiory i radio.
export global Lib {
    in-out property <[NavItem]> nav;
    in-out property <string> nav-selected: "playlist";
    in-out property <int> view;
    // Statystyki (widok 3).
    in-out property <[StatCard]> stat-cards;
    in-out property <[StatDay]> stat-days;
    in-out property <[StatTop]> stat-tracks;
    in-out property <[StatTop]> stat-artists;
    in-out property <[StatTop]> stat-videos;
    in-out property <[StatTop]> stat-history;
    in-out property <string> title;
    in-out property <string> subtitle;
    in-out property <bool> grid;
    in-out property <bool> show-tiles;
    // Strona serialu: odcinki zawsze listą z nagłówkami sezonów.
    in-out property <bool> seasons;
    in-out property <[Tile]> tiles;
    in-out property <[TrackRow]> rows;
    in-out property <bool> can-back;
    in-out property <string> search;
    in-out property <bool> scanning;
    in-out property <string> scan-text;
    in-out property <float> scan-progress;
    in-out property <string> empty-text;
    // Radio
    in-out property <[Station]> stations;
    in-out property <int> radio-source;
    // Dodatkowe kolumny bieżącego widoku biblioteki i nazwy wszystkich kolumn.
    in-out property <[int]> columns: [0, 1, 4];
    in-out property <[string]> col-names;
    callback columns-menu(length, length);
    // Bieżące sortowanie listy widoku (napis na przełączniku) i menu wyboru.
    in-out property <string> sort-label;
    callback sort-menu(length, length);
    // Filtr zbiorów: 0 – wszystko, 1 – muzyka, 2 – filmy; widoczny tylko w zbiorach.
    in-out property <bool> kind-filter-shown;
    in-out property <int> kind-filter;
    in-out property <string> radio-query;
    in-out property <bool> radio-busy;
    callback nav-clicked(string);
    callback nav-menu(string, length, length);
    callback nav-toggle(string);
    callback tile-clicked(string);
    callback tile-double(string);
    callback tile-menu(string, length, length);
    callback back();
    callback play-all();
    callback shuffle-all();
    callback add-all();
    callback row-clicked(int, bool, bool);
    callback row-band(int, int, int, int, int, bool);
    callback row-double(int);
    callback row-menu(int, length, length);
    callback search-changed(string);
    callback rescan();
    callback radio-search(string);
    callback radio-source-changed(int);
    callback kind-filter-changed(int);
    callback radio-play(int);
    callback radio-save(int);
    callback radio-add-url();
}

// Tryb wideo.
export global Video {
    in-out property <image> frame;
    in-out property <bool> has-frame;
    in-out property <bool> controls: true;
    in-out property <bool> fullscreen;
    in-out property <bool> ontop;
    in-out property <string> title;
    in-out property <string> info;
    in-out property <float> pos;
    in-out property <float> duration;
    in-out property <float> buffered;
    in-out property <bool> playing;
    in-out property <[float]> chapters;
    in-out property <[Opt]> audio-tracks;
    in-out property <[Opt]> sub-tracks;
    in-out property <[Opt]> chapter-list;
    in-out property <string> osd;
    in-out property <bool> osd-visible;
    // Ikona komunikatu (nazwa z Icons.get) i wartość 0..1 do paska (-1 – bez paska).
    in-out property <string> osd-icon: "info";
    in-out property <float> osd-level: -1;
    in-out property <bool> panel;
    in-out property <int> panel-page;
    in-out property <float> speed: 1;
    in-out property <float> sub-delay;
    in-out property <float> audio-delay;
    in-out property <float> brightness;
    in-out property <float> contrast;
    in-out property <float> saturation;
    in-out property <float> gamma;
    in-out property <float> sub-scale: 1;
    in-out property <int> aspect;
    in-out property <bool> loading;
    in-out property <bool> audio-only;
    in-out property <string> error;
    // Gra plik wideo z obrazem – pokazywany w widoku filmu, w miejscu okładki albo w miniodtwarzaczu.
    in-out property <bool> active;
    // Film gra samym dźwiękiem (obraz wyłączony po wyjściu z widoku filmu).
    in-out property <bool> bg-audio;
    // Powierzchnia, na której jest obraz – w jej rozmiarze rysuje mpv (bez skalowania i marnowania GPU).
    in-out property <length> surface-w;
    in-out property <length> surface-h;
    // Proporcje obrazu (szerokość / wysokość).
    in-out property <float> ratio: 1.7778;
    // Poświata: obraz zmniejszony do kilkudziesięciu pikseli i rozciągnięty – miękkie światło wokół filmu.
    in-out property <image> ambient;
    in-out property <bool> has-ambient;
    // Podgląd klatki nad paskiem przewijania.
    in-out property <image> preview;
    in-out property <bool> has-preview;
    in-out property <string> preview-chapter;
    in-out property <[Opt]> stats;
    in-out property <float> zoom;
    in-out property <int> rotate;
    in-out property <float> hue;
    // Kursor nad obrazem (znika po chwili bez ruchu myszy).
    in-out property <bool> cursor: true;
    in-out property <bool> deband;
    // Panel boczny w szerokim widoku.
    in-out property <bool> side: true;
    callback open-view();
    callback leave-view();
    callback show-picture();
    callback hover-seek(float);
    callback set-zoom(float);
    callback rotate-view();
    callback reset-view();
    // Menu filmu w punkcie okna (x, y); above – nad punktem (przyciski na dolnym pasku).
    callback menu(length, length, bool);
    callback mini();
    callback panel-page-changed(int);
    callback mouse-moved();
    callback toggle-fullscreen();
    callback toggle-ontop();
    callback back-to-music();
    callback select-audio(string);
    callback select-sub(string);
    callback load-sub();
    callback fetch-sub();
    callback goto-chapter(string);
    // Pomijanie czołówki / napisów końcowych (cel w sekundach, -1 – następny plik).
    in-out property <string> skip-text;
    // Bieżący film jest z sieci (wybór jakości w panelu).
    in-out property <bool> is-url;
    in-out property <float> skip-to;
    callback skip();
    // Następny odcinek pod koniec filmu: tytuł i sekundy do przejścia.
    in-out property <string> next-text;
    in-out property <int> next-secs;
    callback next-cancel();
    callback set-speed(float);
    callback set-sub-delay(float);
    callback set-audio-delay(float);
    callback set-eq(string, float);
    callback set-sub-scale(float);
    callback set-aspect(int);
    callback screenshot();
    callback frame-step(bool);
    callback ab-loop();
    callback hover-controls(bool);
}

// Ustawienia (lustro settings.json).
export global Prefs {
    // Języki interfejsu: „Systemowy” i dostępne katalogi; wybrany indeks.
    in-out property <[string]> languages;
    in-out property <int> language;
    in-out property <bool> dark: true;
    in-out property <string> accent: "#4f8cff";
    in-out property <bool> accent-from-cover: true;
    in-out property <int> viz-bands: 48;
    in-out property <float> viz-sensitivity;
    in-out property <int> viz-color: 1;
    // Miejsce wizualizacji: 0 – na okładce, 1 – w tle okna.
    in-out property <int> viz-place;
    in-out property <float> viz-dim: 0.45;
    // Rozmycie wizualizacji w tle okna (0..1).
    in-out property <float> viz-blur;
    in-out property <int> viz-fps: 60;
    in-out property <float> viz-speed: 1;
    in-out property <bool> show-waveform: true;
    in-out property <int> wave-style;
    in-out property <int> live-style: 1;
    in-out property <int> live-span: 1;
    in-out property <bool> live-glow: true;
    in-out property <bool> auto-eq;
    in-out property <bool> online-lyrics: true;
    in-out property <bool> group-albums: true;
    in-out property <bool> remaining;
    in-out property <bool> ontop;
    in-out property <bool> show-sidebar: true;
    in-out property <float> sidebar-width: 236;
    in-out property <float> panel-glass;
    in-out property <int> glass-tint;
    in-out property <float> nav-text: 1;
    // Sekcje panelu nawigacji.
    in-out property <bool> nav-playlist: true;
    in-out property <bool> nav-music: true;
    in-out property <bool> nav-video: true;
    in-out property <bool> nav-sets: true;
    in-out property <bool> nav-smart: true;
    in-out property <bool> nav-folders: true;
    in-out property <int> side-panel;
    in-out property <bool> scroll-title: true;
    in-out property <int> accent-scope: 1;
    in-out property <int> backdrop: 2;
    in-out property <float> backdrop-opacity: 0.2;
    in-out property <bool> backdrop-motion;
    in-out property <float> glow: 1;
    in-out property <int> corners: 1;
    in-out property <float> text-scale: 1;
    in-out property <int> title-font;
    in-out property <bool> compact-ui;
    in-out property <bool> track-grid;
    in-out property <float> grid-size: 160;
    // Tytuł i podtytuł na dole okładki zamiast pod nią.
    in-out property <bool> caption-overlay;
    in-out property <bool> tray;
    // Jeden suwak widoku: skrajnie po lewej lista, dalej okładki coraz większe.
    out property <float> view-size: track-grid ? grid-size : 90;
    public function set-view(v: float) {
        if v < 100 {
            if track-grid {
                track-grid = false;
                changed("track-grid");
            }
        } else {
            grid-size = v;
            changed("grid-size");
            if !track-grid {
                track-grid = true;
                changed("track-grid");
            }
        }
    }
    // Wideo – wygląd i obraz
    in-out property <int> video-leave;
    in-out property <bool> video-open-view: true;
    in-out property <bool> autohide-window: true;
    in-out property <int> video-quality: 1;
    in-out property <int> hwdec-mode: 1;
    in-out property <bool> interpolation;
    in-out property <bool> deband;
    in-out property <int> tone-mapping;
    in-out property <int> ambient: 1;
    in-out property <bool> video-tint: true;
    in-out property <int> tint-rate: 1;
    in-out property <bool> seek-preview: true;
    in-out property <int> wheel-action;
    in-out property <bool> dblclick-seek: true;
    in-out property <bool> video-autonext: true;
    in-out property <float> volume-boost: 100;
    in-out property <float> played-pct: 80;
    in-out property <bool> night-mode;
    in-out property <bool> downmix;
    in-out property <int> ytdl-format: 1;
    in-out property <bool> ytdl: true;
    in-out property <int> cache-mb: 200;
    // Napisy
    in-out property <string> sub-font;
    in-out property <int> sub-color;
    in-out property <int> sub-style;
    in-out property <int> sub-pos: 100;
    in-out property <bool> sub-bold;
    in-out property <bool> sub-override;
    in-out property <int> sub-auto: 2;
    // Tekst piosenki i napisy w panelu (wszystkie widoki).
    in-out property <string> lyr-font;
    in-out property <int> lyr-size: 16;
    in-out property <int> lyr-active-scale: 125;
    in-out property <int> lyr-spacing: 200;
    in-out property <int> lyr-color;
    in-out property <int> lyr-active-color;
    in-out property <bool> lyr-bold: true;
    in-out property <bool> lyr-fade: true;
    in-out property <int> lyr-align;
    in-out property <[string]> devices;
    in-out property <int> device;
    in-out property <float> crossfade;
    in-out property <bool> soft-pause: true;
    in-out property <bool> exclusive: false;
    in-out property <int> resample-quality: 1;
    in-out property <int> replaygain: 0;
    in-out property <float> rg-preamp;
    in-out property <float> speed: 1;
    in-out property <bool> eq-on;
    in-out property <[float]> eq;
    in-out property <float> preamp;
    // Barwa (półki basów i sopranów, dB) i krzywa korektora do narysowania (układ 1000×100, ±18 dB).
    in-out property <float> bass;
    in-out property <float> treble;
    in-out property <string> eq-curve;
    in-out property <string> eq-curve-fill;
    in-out property <float> eq-peak;
    in-out property <bool> preset-custom;
    in-out property <float> balance;
    in-out property <float> width: 1;
    // Ulepszanie brzmienia 0..1: pełniejszy bas, powietrze w górze, harmoniczne, szersza scena.
    in-out property <float> enhance: 0.5;
    in-out property <bool> mono;
    in-out property <bool> swap;
    in-out property <bool> crossfeed;
    in-out property <bool> limiter: true;
    in-out property <[string]> presets;
    in-out property <int> preset;
    in-out property <bool> resume-on-start: true;
    in-out property <bool> follow-playing: true;
    in-out property <float> seek-step: 5;
    // Wysokość górnego panelu w px (0 – automatyczna).
    in-out property <float> hero-h: 0;
    in-out property <bool> video-resume: true;
    in-out property <int> autohide-ms: 2200;
    in-out property <int> sub-size: 46;
    in-out property <string> sub-lang;
    in-out property <string> lb-token;
    in-out property <string> tmdb-key;
    // AI: dostawca, klucz, adres, model (lista z API dostawcy), temperatura i stan analizy.
    in-out property <int> ai-provider;
    in-out property <string> ai-key;
    in-out property <string> ai-url;
    in-out property <string> ai-model;
    in-out property <[string]> ai-models;
    in-out property <float> ai-temperature: 0.3;
    in-out property <string> ai-status;
    in-out property <string> ai-count;
    in-out property <bool> ai-busy;
    in-out property <bool> peq-on;
    in-out property <string> peq-name;
    in-out property <string> os-key;
    in-out property <bool> online-covers: true;
    in-out property <string> audio-lang;
    in-out property <string> screenshot-dir;
    in-out property <bool> deinterlace;
    in-out property <bool> single-instance: true;
    in-out property <bool> media-keys: true;
    in-out property <bool> global-hotkeys: true;
    in-out property <bool> prevent-sleep: true;
    in-out property <bool> check-updates: true;
    in-out property <[string]> folders;
    in-out property <[string]> video-folders;
    in-out property <string> version;
    in-out property <string> author-line;
    in-out property <bool> mpv-ok;
    in-out property <string> mpv-info;
    in-out property <[KeyHelp]> keys;
    in-out property <[CustomKey]> custom-keys;
    callback custom-key(string, string, bool, bool, bool);
    callback changed(string);
    callback eq-band(int, float);
    callback eq-preset(int);
    callback eq-save-preset();
    callback eq-reset();
    callback add-folder(int);
    callback add-network-folder(int);
    callback remove-folder(int, int);
    callback pick-screenshot-dir();
    callback backup-export();
    callback backup-import();
    callback check-update();
    callback ai-fetch-models();
    callback ai-analyze(bool);
    callback ai-stop();
    callback ai-forget();
    callback open-url(string);
    callback associate();
}

// Okna, menu i komunikaty.
export global Ui {
    in-out property <int> mode;
    // Tryb bezczynności: interfejs powoli znika, zostaje sama wizualizacja (klik albo klawisz – powrót).
    in-out property <bool> ambient;
    // Ekran powitalny (pierwsze uruchomienie).
    in-out property <bool> welcome;
    callback welcome-done();
    in-out property <bool> maximized;
    // Okno na pełnym ekranie (ten sam układ co w oknie; F11).
    in-out property <bool> fullscreen;
    in-out property <bool> settings;
    in-out property <int> settings-page;
    // Okno ustawień: rozmiar zmieniony przez użytkownika (0 – domyślny) i wyszukiwanie.
    in-out property <length> settings-w;
    in-out property <length> settings-h;
    in-out property <string> settings-query;
    in-out property <[Opt]> settings-results;
    callback settings-search(string);
    in-out property <bool> equalizer;
    in-out property <bool> about;
    in-out property <bool> url-dialog;
    in-out property <string> url-text;
    in-out property <bool> tag-editor;
    in-out property <[string]> tag-values;
    in-out property <[bool]> tag-mixed;
    in-out property <string> tag-title;
    in-out property <image> tag-cover;
    in-out property <bool> tag-has-cover;
    in-out property <bool> tag-busy;
    in-out property <bool> update-dialog;
    in-out property <string> update-version;
    in-out property <string> update-notes;
    in-out property <float> update-progress: -1;
    in-out property <string> update-status;
    in-out property <bool> update-portable;
    in-out property <bool> rename-dialog;
    // Kolumny siatki okładek (strzałki w górę/dół skaczą o wiersz).
    in-out property <int> grid-cols: 1;
    in-out property <string> rename-text;
    in-out property <string> rename-title;
    in-out property <[MenuEntry]> menu;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in-out property <string> toast;
    in-out property <bool> toast-visible;
    in-out property <bool> drop-hint;
    callback drag();
    callback minimize();
    callback toggle-maximize();
    callback close();
    callback resize(int);
    callback menu-activated(string);
    callback open-main-menu(length, length);
    callback set-mode(int);
    callback toggle-full();
    callback url-accepted(string);
    callback tag-save([string]);
    callback tag-pick-cover();
    callback update-install();
    callback update-skip();
    callback rename-accepted(string);
    callback key(string, bool, bool, bool);
    callback sleep-menu(length, length);
    callback device-menu(length, length);
    // Okno dialogowe otwarte/zamknięte – dialogi mają własne okno (DialogWindow).
    callback dialog-shown(bool);
    callback dialog-drag();
    // Przesunięcie okna dialogu o (dx, dy) – bez systemowej pętli przeciągania, która
    // zatrzymywała rysowanie filmu.
    callback dialog-move(length, length);
}

export global VizNames {
    out property <[string]> names: [@tr("Bars"), @tr("Spectrum"), @tr("Oscilloscope"), @tr("VU meters"), @tr("glow" => "Off"), @tr("Mirror"), @tr("Circle"), @tr("3D spectrum"), @tr("LEDs"), @tr("Stereo"), @tr("Dots"), @tr("Wave"), @tr("Blob"), @tr("Pulse"), @tr("Capsules")];
}
