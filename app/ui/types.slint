// Struktury danych wymieniane z Rustem.

export struct TrackRow {
    header: bool,
    idx: int,
    num: string,
    title: string,
    artist: string,
    album: string,
    dur: string,
    info: string,
    playing: bool,
    selected: bool,
    fav: bool,
    queued: string,
    // Plik jest już na karcie „Kolejka” (znacznik poza samą kolejką).
    in-queue: bool,
    missing: bool,
    video: bool,
    h-title: string,
    h-sub: string,
    h-cover: image,
    h-has-cover: bool,
    // Film: obejrzana część (0..1, -1 – brak) i obejrzany do końca.
    progress: float,
    watched: bool,
}

export struct StatCard {
    label: string,
    value: string,
    sub: string,
}

export struct StatDay {
    label: string,
    music: float,
    video: float,
    tip: string,
}

export struct StatTop {
    title: string,
    sub: string,
    value: string,
    frac: float,
}

export struct NavItem {
    id: string,
    label: string,
    icon: string,
    count: string,
    section: bool,
    // Drzewo folderów: poziom wcięcia i strzałka (0 – brak, 1 – zwinięty, 2 – rozwinięty).
    depth: int,
    expander: int,
}

export struct Tile {
    key: string,
    name: string,
    sub: string,
    count: string,
    cover: image,
    has-cover: bool,
}

export struct MenuEntry {
    id: string,
    label: string,
    icon: string,
    shortcut: string,
    checked: bool,
    enabled: bool,
    sep: bool,
}

export struct TabItem {
    label: string,
    count: string,
}

export struct LyricLine {
    text: string,
    active: bool,
    // Pasuje do wyszukiwania w panelu tekstu.
    hit: bool,
}

export struct Opt {
    id: string,
    label: string,
    sub: string,
    selected: bool,
}

export struct Station {
    name: string,
    url: string,
    info: string,
    saved: bool,
}

export struct KeyHelp {
    keys: string,
    action: string,
}

// Akcja z własnym skrótem: id, nazwa i przypisana kombinacja (pusta – brak).
export struct CustomKey {
    id: string,
    action: string,
    keys: string,
}

export struct Toast {
    text: string,
    visible: bool,
}

export enum ViewKind { playlist, library, radio }
