// Lista utworów z nagłówkami albumów – wspólna dla list odtwarzania i biblioteki.

import { ListView, ScrollView } from "scroll.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconBtn, Cover } from "widgets.slint";
import { TrackRow } from "types.slint";
import { Ui, Prefs } from "state.slint";

export component TrackList inherits Rectangle {
    in property <[TrackRow]> rows;
    // Dodatkowe kolumny tego widoku (numery z `columns.rs`) i nazwy wszystkich kolumn.
    in property <[int]> columns;
    in property <[string]> col-names;
    in property <length> scroll-y;
    in property <int> scroll-gen;
    in property <string> empty-text;
    in property <string> empty-icon: Icons.playlist;
    // Siatka okładek zamiast wierszy i szerokość kafelka.
    in property <bool> grid;
    in property <length> tile: 160px;
    callback clicked(int, bool, bool);
    callback double(int);
    callback menu(int, length, length);
    callback header-clicked(int);
    callback header-double(int);
    callback fav(int);
    callback empty-clicked();
    callback zoom(float);
    // Menu wyboru kolumn (prawy klik na pasku kolumn albo przycisk na jego końcu).
    callback columns-menu(length, length);
    // Proporcje szerokości kolumn i kolumny wyrównane do prawej (liczby).
    property <[float]> weight: [2, 2, 1.2, 0.6, 1.1, 0.8, 0.6, 0.7, 1.1, 1.1, 1.4, 2];
    property <[bool]> num-col: [false, false, false, true, false, true, true, false, true, true, false, false];
    // Na wąskiej liście zostają tylko pierwsze kolumny.
    property <int> fit: max(0, floor((root.width - 360px) / 130px));
    property <bool> head: !root.grid && root.rows.length > 0;
    // Zaznaczenie prostokątem w siatce: wiersze r0..r1, kolumny c0..c1, liczba kolumn, Ctrl.
    callback band(int, int, int, int, int, bool);
    changed scroll-gen => {
        lv.content-y = -root.scroll-y;
    }
    if root.rows.length == 0: VerticalLayout {
        alignment: center;
        spacing: 10px;
        Icon {
            x: (parent.width - self.width) / 2;
            icon: root.empty-icon;
            size: 44px;
            fill: Theme.text3.with-alpha(0.5);
        }
        Text {
            text: root.empty-text;
            color: Theme.text3;
            font-size: Theme.fs;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        TouchArea {
            height: 0;
            double-clicked => { root.empty-clicked(); }
        }
    }
    if root.rows.length == 0: TouchArea {
        double-clicked => { root.empty-clicked(); }
    }
    // Siatka okładek: kafelek na utwór, wielkość z suwaka. Treść powstaje tylko dla widocznych
    // kafelków – tysiące utworów nie spowalniają przewijania.
    if root.grid && root.rows.length > 0: sv := ScrollView {
        property <int> cols: max(1, floor((self.visible-width - 16px) / root.tile));
        init => { Ui.grid-cols = self.cols; }
        changed cols => { Ui.grid-cols = self.cols; }
        property <length> cell: (self.visible-width - 16px) / cols;
        property <length> cell-h: Prefs.caption-overlay ? cell : cell + 44px;
        content-height: ceil(root.rows.length / cols) * cell-h + 16px;
        // Prostokąt zaznaczenia (współrzędne treści): kotwica, bieżący punkt i ostatni zakres.
        property <bool> band-on;
        property <length> ax;
        property <length> ay;
        property <length> mx;
        property <length> my;
        property <string> band-key;
        function band-move(x: length, y: length, ctrl: bool) {
            self.mx = x;
            self.my = y;
            // Kursor przy krawędzi – siatka przewija się za nim.
            if y > -self.content-y + self.visible-height - 30px {
                self.content-y = max(self.content-y - 24px, min(0px, self.visible-height - self.content-height));
            } else if y < -self.content-y + 30px {
                self.content-y = min(self.content-y + 24px, 0px);
            }
            if !self.band-on && abs(x - self.ax) + abs(y - self.ay) < 8px {
                return;
            }
            self.band-on = true;
            let c0 = clamp(floor((min(self.ax, x) - 8px) / self.cell), 0, self.cols - 1);
            let c1 = clamp(floor((max(self.ax, x) - 8px) / self.cell), 0, self.cols - 1);
            let r0 = max(0, floor((min(self.ay, y) - 8px) / self.cell-h));
            let r1 = max(0, floor((max(self.ay, y) - 8px) / self.cell-h));
            let key = r0 + ":" + r1 + ":" + c0 + ":" + c1;
            if key != self.band-key {
                self.band-key = key;
                root.band(r0, r1, c0, c1, self.cols, ctrl);
            }
        }
        // Puste miejsce siatki: przeciąganie zaczyna zaznaczanie.
        TouchArea {
            width: sv.visible-width;
            height: max(sv.content-height, sv.visible-height);
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    sv.ax = self.mouse-x;
                    sv.ay = self.mouse-y;
                    sv.band-key = "";
                } else if e.kind == PointerEventKind.up {
                    sv.band-on = false;
                }
            }
            moved => {
                if self.pressed {
                    sv.band-move(self.mouse-x, self.mouse-y, false);
                }
            }
        }
        for r[i] in root.rows: cellr := Rectangle {
            x: 8px + mod(i, sv.cols) * sv.cell;
            y: 8px + floor(i / sv.cols) * sv.cell-h;
            width: sv.cell;
            height: sv.cell-h;
            property <bool> shown: self.y + self.height > -sv.content-y - sv.cell-h && self.y < -sv.content-y + sv.visible-height + sv.cell-h;
            // Rząd wjeżdżający pod górną krawędź stopniowo znika.
            opacity: clamp((self.y + sv.content-y + self.height * 0.7) / (self.height * 0.7), 0, 1);
            if cellr.shown && !r.header: Rectangle {
                x: 5px;
                y: 5px;
                width: parent.width - 10px;
                height: parent.height - 10px;
                border-radius: Theme.radius;
                background: r.selected ? Theme.sel : transparent;
                border-width: r.selected ? 1px : 0;
                border-color: Theme.tint.with-alpha(0.35);
                cov := Cover {
                    x: 5px;
                    y: gta.has-hover ? 1px : 5px;
                    animate y, drop-shadow-blur, drop-shadow-offset-y { duration: 180ms; easing: ease-out; }
                    width: parent.width - 10px;
                    height: self.width;
                    source: r.h-cover;
                    has: r.h-has-cover;
                    fallback: r.video ? Icons.movie : Icons.note;
                    border-radius: Theme.radius - 2px;
                    drop-shadow-blur: r.playing || gta.has-hover ? 24px : 10px;
                    drop-shadow-offset-y: r.playing || gta.has-hover ? 8px : 3px;
                    drop-shadow-color: r.playing || gta.has-hover ? Theme.glow : #00000080;
                }
                // Podpisy na dole okładki (ustawienie) – na przyciemnieniu, żeby były czytelne.
                if Prefs.caption-overlay: Rectangle {
                    x: cov.x;
                    y: cov.y + cov.height - self.height;
                    width: cov.width;
                    height: 52px;
                    border-bottom-left-radius: cov.border-radius;
                    border-bottom-right-radius: cov.border-radius;
                    background: @linear-gradient(0deg, #000000d8 0%, #00000099 55%, #00000000 100%);
                }
                // Film: obejrzana część u dołu okładki i znacznik obejrzanego.
                if r.video && r.progress > 0 && !r.watched: Rectangle {
                    x: 9px;
                    y: parent.width - 12px;
                    width: parent.width - 18px;
                    height: 4px;
                    border-radius: 2px;
                    background: #00000099;
                    Rectangle {
                        x: 0;
                        width: parent.width * r.progress;
                        border-radius: 2px;
                        background: Theme.tint;
                    }
                }
                if r.video && r.watched: Rectangle {
                    x: Prefs.caption-overlay ? parent.width - self.width - 11px : 11px;
                    y: Prefs.caption-overlay ? 11px : parent.width - self.height - 12px;
                    height: 22px;
                    width: wtx.preferred-width + 30px;
                    border-radius: 11px;
                    background: #000000b0;
                    HorizontalLayout {
                        padding-left: 7px;
                        spacing: 4px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.check;
                            size: 12px;
                            fill: Theme.tint-hi;
                        }
                        wtx := Text {
                            text: @tr("Watched");
                            color: #ffffffe0;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                }
                if r.playing: Rectangle {
                    x: 11px;
                    y: 11px;
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    background: Theme.tint;
                    Icon {
                        icon: Icons.equalizer;
                        size: 15px;
                        fill: Theme.on-accent;
                    }
                }
                if !r.playing && r.queued != "": Rectangle {
                    x: 11px;
                    y: 11px;
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: Theme.tint;
                    Text {
                        text: r.queued;
                        color: Theme.on-accent;
                        font-size: 10px;
                        font-weight: 700;
                    }
                }
                Text {
                    x: Prefs.caption-overlay ? cov.x + 8px : 8px;
                    y: Prefs.caption-overlay ? cov.y + cov.height - 40px : parent.width + 1px;
                    width: Prefs.caption-overlay ? cov.width - 16px : parent.width - 16px;
                    text: r.title;
                    color: Prefs.caption-overlay ? (r.playing ? Theme.tint-hi : #ffffff) : r.missing ? Theme.text3 : r.playing ? Theme.tint-hi : Theme.text;
                    font-size: Theme.fs;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    x: Prefs.caption-overlay ? cov.x + 8px : 8px;
                    y: Prefs.caption-overlay ? cov.y + cov.height - 22px : parent.width + 18px;
                    width: Prefs.caption-overlay ? cov.width - 16px : parent.width - 16px;
                    text: r.artist + (r.dur != "" ? "  ·  " + r.dur : "");
                    color: Prefs.caption-overlay ? #ffffffb8 : Theme.text3;
                    font-size: Theme.fs-sm;
                    overflow: elide;
                }
            }
            gta := TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        root.clicked(r.idx, e.modifiers.control, e.modifiers.shift);
                        sv.ax = cellr.x + self.mouse-x;
                        sv.ay = cellr.y + self.mouse-y;
                        sv.band-key = "";
                    }
                    if e.kind == PointerEventKind.up {
                        sv.band-on = false;
                    }
                    if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                        if !r.selected {
                            root.clicked(r.idx, false, false);
                        }
                        root.menu(r.idx, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                moved => {
                    if self.pressed {
                        sv.band-move(cellr.x + self.mouse-x, cellr.y + self.mouse-y, true);
                    }
                }
                double-clicked => { root.double(r.idx); }
                // Ctrl + kółko – wielkość okładek.
                scroll-event(e) => {
                    if e.modifiers.control {
                        root.zoom(e.delta-y > 0 ? 10 : -10);
                        return accept;
                    }
                    reject
                }
            }
        }
        if sv.band-on: Rectangle {
            x: min(sv.ax, sv.mx);
            y: min(sv.ay, sv.my);
            width: abs(sv.mx - sv.ax);
            height: abs(sv.my - sv.ay);
            border-radius: Theme.r(4px);
            background: Theme.tint.with-alpha(0.14);
            border-width: 1px;
            border-color: Theme.tint.with-alpha(0.7);
        }
    }
    // Pasek nazw kolumn nad wierszami – prawy klik albo przycisk wybiera kolumny.
    if root.head: Rectangle {
        y: 0;
        height: 26px;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 10px;
            spacing: 10px;
            Text {
                width: 30px;
                text: "#";
                color: Theme.text3;
                font-size: Theme.fs-xs;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Rectangle {
                width: 14px;
            }
            Text {
                horizontal-stretch: 3;
                preferred-width: 0px;
                min-width: 80px;
                text: @tr("Title");
                color: Theme.text3;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                overflow: elide;
            }
            for c[k] in root.columns: Text {
                visible: k < root.fit;
                horizontal-stretch: k < root.fit ? root.weight[c] : 0;
                preferred-width: 0px;
                min-width: k < root.fit ? 40px : 0px;
                max-width: k < root.fit ? 10000px : 0px;
                text: root.col-names[c];
                color: Theme.text3;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                horizontal-alignment: root.num-col[c] ? right : left;
                overflow: elide;
            }
            Text {
                width: 46px;
                text: @tr("Length");
                color: Theme.text3;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
            }
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.line;
        }
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                    root.columns-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        IconBtn {
            x: parent.width - self.width - 4px;
            y: (parent.height - self.height) / 2;
            size: 22px;
            icon-size: 13px;
            icon: Icons.tune;
            tip: @tr("Columns");
            clicked => { root.columns-menu(self.absolute-position.x, self.absolute-position.y + self.height); }
        }
    }
    lv := ListView {
        y: root.head ? 28px : 0px;
        height: root.height - self.y;
        visible: root.rows.length > 0 && !root.grid;
        for r[i] in root.rows: Rectangle {
            height: r.header ? Theme.head-h : Theme.row-h;
            if r.header: Rectangle {
                y: 8px;
                height: parent.height - 10px;
                border-radius: Theme.radius;
                background: hta.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 12px;
                    spacing: 11px;
                    Cover {
                        y: (parent.height - self.height) / 2;
                        width: Theme.dense ? 28px : 38px;
                        height: self.width;
                        source: r.h-cover;
                        has: r.h-has-cover;
                        border-radius: Theme.r(5px);
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: r.h-title;
                            color: Theme.heading;
                            font-size: Theme.fs-lg;
                            font-family: Theme.font-serif;
                            overflow: elide;
                        }
                        Text {
                            text: r.h-sub;
                            color: Theme.text3;
                            font-size: Theme.fs-sm;
                            overflow: elide;
                        }
                    }
                }
                hta := TouchArea {
                    clicked => { root.header-clicked(r.idx); }
                    double-clicked => { root.header-double(r.idx); }
                }
            }
            if !r.header: Rectangle {
                border-radius: Theme.r(6px);
                background: r.selected ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 10px;
                    spacing: 10px;
                    Rectangle {
                        width: 30px;
                        if r.playing: Icon {
                            icon: Icons.equalizer;
                            size: 15px;
                            fill: Theme.tint;
                        }
                        if !r.playing && r.queued != "": Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: Theme.tint.with-alpha(0.25);
                            Text {
                                text: r.queued;
                                color: Theme.tint;
                                font-size: 10px;
                                font-weight: 700;
                            }
                        }
                        if !r.playing && r.queued == "": Text {
                            text: r.num;
                            color: Theme.text3;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: right;
                            width: 100%;
                        }
                    }
                    // Miejsce na ikonę filmu zawsze – kolumny trzymają pion w listach mieszanych.
                    Rectangle {
                        width: 14px;
                        if r.video: Icon {
                            icon: Icons.movie;
                            size: 14px;
                            fill: Theme.text3;
                        }
                    }
                    Text {
                        horizontal-stretch: 3;
                        text: r.title;
                        color: r.missing ? Theme.text3 : r.playing ? Theme.tint : Theme.text;
                        font-weight: r.playing ? 600 : 400;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 80px;
                        // Szerokość tylko z proporcji – kolumny równe we wszystkich wierszach.
                        preferred-width: 0px;
                    }
                    for c[k] in root.columns: Text {
                        visible: k < root.fit;
                        horizontal-stretch: k < root.fit ? root.weight[c] : 0;
                        preferred-width: 0px;
                        min-width: k < root.fit ? 40px : 0px;
                        max-width: k < root.fit ? 10000px : 0px;
                        text: r.cols[c];
                        // Wykonawca jaśniej, reszta przygaszona; liczby do prawej.
                        color: c == 0 ? Theme.text2 : Theme.text3;
                        font-size: c == 4 ? Theme.fs-xs : Theme.fs;
                        vertical-alignment: center;
                        horizontal-alignment: root.num-col[c] ? right : left;
                        overflow: elide;
                    }
                    Text {
                        width: 46px;
                        text: r.dur;
                        color: Theme.text3;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
                ta := TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                            root.clicked(r.idx, e.modifiers.control, e.modifiers.shift);
                        }
                        if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                            if !r.selected {
                                root.clicked(r.idx, false, false);
                            }
                            root.menu(r.idx, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                    double-clicked => { root.double(r.idx); }
                    // Ctrl + kółko – z listy do okładek (ten sam suwak widoku).
                    scroll-event(e) => {
                        if e.modifiers.control {
                            root.zoom(e.delta-y > 0 ? 10 : -10);
                            return accept;
                        }
                        reject
                    }
                }
            }
        }
    }
}
