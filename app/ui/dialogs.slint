// Okna dialogowe: korektor i efekty, ustawienia, edytor tagów, adres URL, o programie,
// aktualizacja, zmiana nazwy.

import { ComboBox, LineEdit, SpinBox } from "std-widgets.slint";
import { ScrollView } from "scroll.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconBtn, Btn, HSlider, VSlider, Switch, SettingRow, SettingSwitch, Segmented, Field, SectionTitle, Divider, Cover, LyricText, LyricStyle } from "widgets.slint";
import { Player, Prefs, Ui } from "state.slint";
import { GlassFill } from "glass.slint";

// Pole nagrywania skrótu: kliknięcie, potem kombinacja klawiszy (Backspace usuwa skrót).
component KeyCapture inherits Rectangle {
    in property <string> keys;
    callback captured(string, bool, bool, bool);
    width: 180px;
    height: 26px;
    border-radius: 5px;
    background: fs.has-focus ? Theme.tint.with-alpha(0.15) : Theme.panel2;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.tint : Theme.line2;
    Text {
        text: fs.has-focus ? @tr("Press keys…") : root.keys != "" ? root.keys : "—";
        color: fs.has-focus ? Theme.tint-hi : root.keys != "" ? Theme.text : Theme.text3;
        font-size: Theme.fs-sm;
        font-family: Theme.mono;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { fs.focus(); }
    }
    fs := FocusScope {
        key-pressed(e) => {
            root.captured(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
            accept
        }
    }
}

// Okno dialogowe: osobne okno programu (DialogWindow), karta wypełnia całe okno.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 480px;
    in property <length> card-height: 0;
    // Rozmiar, jaki dialog chce mieć – z niego bierze się rozmiar okna.
    out property <length> natural-width: card-width;
    out property <length> natural-height: card-height > 0 ? card-height : lay.preferred-height;
    callback close();
    background: Theme.glass-color;
    GlassFill {
        min-alpha: 0.5;
    }
    lay := VerticalLayout {
        HorizontalLayout {
            height: 50px;
            padding-left: 20px;
            padding-right: 10px;
            Rectangle {
                horizontal-stretch: 1;
                // Przeciąganie okna dialogu za pasek tytułu.
                TouchArea {
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
                    // Okno jedzie za kursorem, więc przesunięcie od miejsca chwycenia jest stałe.
                    moved => {
                        if self.pressed {
                            Ui.dialog-move(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }
                }
                // Tytuł na środku całego okna (nie paska bez przycisku zamykania).
                Text {
                    x: max(0px, (root.width - self.width) / 2 - parent.x);
                    width: min(self.preferred-width, parent.width);
                    overflow: elide;
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.fs-lg;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.close;
                tip: @tr("Close");
                clicked => { root.close(); }
            }
        }
        @children
    }
}

export component EqualizerDialog inherits Dialog {
    title: @tr("Equalizer and sound effects");
    card-width: 860px;
    close => { Ui.equalizer = false; }
    VerticalLayout {
        padding: 20px;
        padding-top: 4px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            Switch {
                y: (parent.height - self.height) / 2;
                checked <=> Prefs.eq-on;
                toggled => { Prefs.changed("eq-on"); }
            }
            Text {
                text: Prefs.eq-on ? @tr("Equalizer on") : @tr("Equalizer off");
                color: Theme.text;
                font-size: Theme.fs;
                vertical-alignment: center;
            }
            Rectangle {
                width: 14px;
            }
            Switch {
                y: (parent.height - self.height) / 2;
                checked <=> Prefs.auto-eq;
                toggled => { Prefs.changed("auto-eq"); }
            }
            Text {
                text: @tr("Match genre");
                color: Prefs.auto-eq ? Theme.text : Theme.text2;
                font-size: Theme.fs;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            ComboBox {
                width: 200px;
                model: Prefs.presets;
                current-index: Prefs.preset;
                selected => { Prefs.eq-preset(self.current-index); }
            }
            Btn {
                text: @tr("Save as…");
                icon: Icons.add;
                clicked => { Prefs.eq-save-preset(); }
            }
            Btn {
                text: @tr("Reset");
                clicked => { Prefs.eq-reset(); }
            }
        }
        Rectangle {
            height: 220px;
            border-radius: Theme.radius;
            background: Theme.panel2;
            opacity: Prefs.eq-on ? 1 : 0.55;
            HorizontalLayout {
                padding: 12px;
                spacing: 6px;
                VSlider {
                    label: @tr("Gain");
                    range: 20;
                    value: Prefs.preamp;
                    moved(v) => {
                        Prefs.preamp = v;
                        Prefs.changed("preamp");
                    }
                }
                Rectangle {
                    width: 1px;
                    background: Theme.line2;
                }
                for g[i] in Prefs.eq: VSlider {
                    horizontal-stretch: 1;
                    value: g;
                    label: ["31", "63", "87", "125", "175", "250", "350", "500", "700", "1k", "1.4k", "2k", "2.8k", "4k", "5.6k", "8k", "11k", "16k"][i];
                    moved(v) => { Prefs.eq-band(i, v); }
                }
            }
        }
        HorizontalLayout {
            spacing: 24px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                SectionTitle {
                    text: @tr("SPACE");
                }
                SettingRow {
                    title: @tr("Balance");
                    HSlider {
                        width: 150px;
                        minimum: -1;
                        maximum: 1;
                        centered: true;
                        value: Prefs.balance;
                        moved(v) => {
                            Prefs.balance = v;
                            Prefs.changed("balance");
                        }
                        reset => {
                            Prefs.balance = 0;
                            Prefs.changed("balance");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Stereo width");
                    hint: round(Prefs.width * 100) + "%";
                    HSlider {
                        width: 150px;
                        minimum: 0;
                        maximum: 2;
                        centered: true;
                        value: Prefs.width;
                        moved(v) => {
                            Prefs.width = v;
                            Prefs.changed("width");
                        }
                        reset => {
                            Prefs.width = 1;
                            Prefs.changed("width");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Mono");
                    checked <=> Prefs.mono;
                    toggled => { Prefs.changed("mono"); }
                }
                SettingSwitch {
                    title: @tr("Swap channels");
                    checked <=> Prefs.swap;
                    toggled => { Prefs.changed("swap"); }
                }
                SettingSwitch {
                    title: @tr("Headphone crossfeed");
                    hint: @tr("A more natural stage in headphones");
                    checked <=> Prefs.crossfeed;
                    toggled => { Prefs.changed("crossfeed"); }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                SectionTitle {
                    text: @tr("PLAYBACK");
                }
                SettingRow {
                    title: @tr("Crossfade");
                    hint: Prefs.crossfade > 0 ? round(Prefs.crossfade * 10) / 10 + " s" : @tr("Off – gapless transitions");
                    HSlider {
                        width: 150px;
                        minimum: 0;
                        maximum: 12;
                        step: 0.5;
                        value: Prefs.crossfade;
                        moved(v) => {
                            Prefs.crossfade = v;
                            Prefs.changed("crossfade");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Speed");
                    hint: @tr("{}× (with pitch, like a turntable)", round(Prefs.speed * 100) / 100);
                    HSlider {
                        width: 150px;
                        minimum: 0.5;
                        maximum: 2;
                        step: 0.05;
                        value: Prefs.speed;
                        moved(v) => {
                            Prefs.speed = v;
                            Prefs.changed("speed");
                        }
                        reset => {
                            Prefs.speed = 1;
                            Prefs.changed("speed");
                        }
                    }
                }
                SettingRow {
                    title: @tr("ReplayGain");
                    hint: @tr("Volume levelling from tags");
                    Segmented {
                        small: true;
                        options: [@tr("short" => "Off"), @tr("Track"), @tr("Album")];
                        selected <=> Prefs.replaygain;
                        changed => { Prefs.changed("replaygain"); }
                    }
                }
                SettingSwitch {
                    title: @tr("Limiter");
                    hint: @tr("Prevents clipping when boosting");
                    checked <=> Prefs.limiter;
                    toggled => { Prefs.changed("limiter"); }
                }
                SettingSwitch {
                    title: @tr("Parametric equalizer");
                    hint: Prefs.peq-name != "" ? @tr("Profile: {}", Prefs.peq-name) : @tr("Headphone profile from AutoEQ – load a ParametricEQ.txt file");
                    checked <=> Prefs.peq-on;
                    toggled => { Prefs.changed("peq-on"); }
                }
                HorizontalLayout {
                    alignment: start;
                    Btn {
                        text: @tr("Load AutoEQ profile…");
                        icon: Icons.file;
                        compact: true;
                        clicked => { Prefs.changed("peq-load"); }
                    }
                }
                SettingSwitch {
                    title: @tr("Smooth pause");
                    hint: @tr("Fade on pause and resume");
                    checked <=> Prefs.soft-pause;
                    toggled => { Prefs.changed("soft-pause"); }
                }
            }
        }
    }
}

component Page inherits ScrollView {
    in property <string> heading;
    VerticalLayout {
        padding: 22px;
        padding-top: 16px;
        spacing: 2px;
        Text {
            text: root.heading;
            horizontal-alignment: center;
            color: Theme.text;
            font-size: Theme.fs-xl;
            font-weight: 600;
        }
        Rectangle {
            height: 10px;
        }
        @children
    }
}

export component AuthorCard inherits Rectangle {
    border-radius: Theme.radius-lg;
    background: Theme.panel2;
    border-width: 1px;
    border-color: Theme.line;
    height: lay.preferred-height;
    lay := HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3px;
            Text {
                text: Prefs.author-line;
                color: Theme.text;
                font-size: Theme.fs;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: @tr("OpenMP is free. If you find it useful, you can support further development.");
                color: Theme.text3;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            Btn {
                text: "redzikowski.com";
                icon: Icons.link;
                clicked => { Prefs.open-url("https://redzikowski.com"); }
            }
            Btn {
                text: @tr("Buy me a coffee");
                icon: Icons.coffee;
                primary: true;
                clicked => { Prefs.open-url("https://buycoffee.to/adamredzikowski"); }
            }
        }
    }
}

component FolderList inherits VerticalLayout {
    in property <int> kind;
    in property <string> title;
    in property <string> hint;
    in property <[string]> folders;
    spacing: 6px;
    SectionTitle {
        text: root.title;
    }
    Text {
        text: root.hint;
        color: Theme.text3;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
    if root.folders.length == 0: Text {
        text: @tr("No folders.");
        color: Theme.text3;
        font-size: Theme.fs;
    }
    for f[i] in root.folders: Rectangle {
        height: 38px;
        border-radius: Theme.radius;
        background: Theme.panel2;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 4px;
            spacing: 10px;
            Icon {
                y: (parent.height - self.height) / 2;
                icon: Icons.folder;
                size: 16px;
                fill: Theme.text3;
            }
            Text {
                text: f;
                color: Theme.text;
                font-size: Theme.fs;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.delete;
                size: 28px;
                icon-size: 15px;
                tip: @tr("Remove folder from library");
                clicked => { Prefs.remove-folder(root.kind, i); }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        spacing: 8px;
        Btn {
            text: @tr("Add folder…");
            icon: Icons.add;
            compact: true;
            clicked => { Prefs.add-folder(root.kind); }
        }
        Btn {
            text: @tr("Add network path…");
            icon: Icons.link;
            compact: true;
            clicked => { Prefs.add-network-folder(root.kind); }
        }
    }
}

export component SettingsDialog inherits Dialog {
    title: @tr("Settings");
    card-width: 900px;
    card-height: 640px;
    close => { Ui.settings = false; }
    HorizontalLayout {
        vertical-stretch: 1;
        VerticalLayout {
            width: 220px;
            padding: 10px;
            spacing: 2px;
            // Szukanie ustawienia po nazwie i opisie – klik przenosi na stronę i podświetla wiersz.
            Field {
                icon: Icons.search;
                placeholder: @tr("Search settings");
                text <=> Ui.settings-query;
                edited(t) => { Ui.settings-search(t); }
                escape => {
                    Ui.settings-query = "";
                    Ui.settings-search("");
                }
            }
            Rectangle {
                height: 6px;
            }
            if Ui.settings-query != "" && Ui.settings-results.length == 0: Text {
                text: @tr("Nothing found");
                color: Theme.text3;
                font-size: Theme.fs-sm;
                horizontal-alignment: center;
            }
            for r in Ui.settings-results: Rectangle {
                min-height: 40px;
                border-radius: Theme.radius;
                background: rta.has-hover ? Theme.hover : transparent;
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    alignment: center;
                    Text {
                        text: r.label;
                        color: Theme.text;
                        font-size: Theme.fs;
                        overflow: elide;
                    }
                    Text {
                        text: r.sub;
                        color: Theme.text3;
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                }
                rta := TouchArea {
                    clicked => {
                        Ui.settings-page = r.id.to-float();
                        Theme.settings-flash = r.label;
                    }
                }
            }
            for p[i] in [
                { icon: Icons.palette, l: @tr("Appearance") },
                { icon: Icons.queue, l: @tr("Layout") },
                { icon: Icons.equalizer, l: @tr("Visualization") },
                { icon: Icons.play, l: @tr("Playback") },
                { icon: Icons.volume, l: @tr("Audio") },
                { icon: Icons.movie, l: @tr("Video") },
                { icon: Icons.subtitles, l: @tr("Subtitles") },
                { icon: Icons.library, l: @tr("Library") },
                { icon: Icons.keyboard, l: @tr("Keyboard shortcuts") },
                { icon: Icons.system, l: @tr("System") },
                { icon: Icons.info, l: @tr("About") },
            ]: Rectangle {
                // Podczas szukania zamiast stron są wyniki.
                height: Ui.settings-query == "" ? 34px : 0px;
                visible: Ui.settings-query == "";
                border-radius: Theme.radius;
                background: Ui.settings-page == i ? Theme.sel : pta.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 10px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        icon: p.icon;
                        size: 16px;
                        fill: Ui.settings-page == i ? Theme.tint : Theme.text3;
                    }
                    Text {
                        text: p.l;
                        color: Ui.settings-page == i ? Theme.text : Theme.text2;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }
                }
                pta := TouchArea {
                    clicked => { Ui.settings-page = i; }
                }
            }
            Rectangle {
                vertical-stretch: 1;
            }
        }
        Rectangle {
            width: 1px;
            background: Theme.line;
        }
        Rectangle {
            horizontal-stretch: 1;
            if Ui.settings-page == 0: Page {
                heading: @tr("Appearance");
                SettingRow {
                    title: @tr("Language");
                    hint: @tr("“System” uses the Windows language");
                    ComboBox {
                        width: 240px;
                        model: Prefs.languages;
                        current-index: Prefs.language;
                        selected => {
                            Prefs.language = self.current-index;
                            Prefs.changed("language");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Theme");
                    Segmented {
                        options: [@tr("Dark"), @tr("Light")];
                        selected: Prefs.dark ? 0 : 1;
                        changed(i) => {
                            Prefs.dark = i == 0;
                            Prefs.changed("dark");
                        }
                    }
                }
                SectionTitle {
                    text: @tr("ACCENT COLOR");
                }
                SettingRow {
                    title: @tr("Accent color");
                    hint: @tr("When the cover has no distinct color – or always, when the cover color is off");
                    HorizontalLayout {
                        spacing: 6px;
                        for c in [{ h: "#4f8cff", c: #4f8cff }, { h: "#8b5cf6", c: #8b5cf6 }, { h: "#c026d3", c: #c026d3 }, { h: "#ec4899", c: #ec4899 }, { h: "#ef4444", c: #ef4444 }, { h: "#f97316", c: #f97316 }, { h: "#f59e0b", c: #f59e0b }, { h: "#84cc16", c: #84cc16 }, { h: "#22c55e", c: #22c55e }, { h: "#14b8a6", c: #14b8a6 }, { h: "#06b6d4", c: #06b6d4 }, { h: "#e2e8f0", c: #e2e8f0 }]: Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: c.c;
                            border-width: Prefs.accent == c.h ? 2px : 0;
                            border-color: Theme.text;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Prefs.accent = c.h;
                                    Prefs.changed("accent");
                                }
                            }
                        }
                    }
                }
                SettingRow {
                    title: @tr("Custom color");
                    hint: @tr("Hex notation, e.g. #ff6a3d");
                    LineEdit {
                        width: 110px;
                        text <=> Prefs.accent;
                        edited => { Prefs.changed("accent"); }
                    }
                }
                SettingSwitch {
                    title: @tr("Accent color from cover");
                    hint: @tr("The whole program takes on the album's color (for movies – the picture's color, when enabled in video settings)");
                    checked <=> Prefs.accent-from-cover;
                    toggled => { Prefs.changed("accent-from-cover"); }
                }
                SettingRow {
                    title: @tr("Accent color scope");
                    hint: Prefs.accent-scope == 0 ? @tr("Accents only: selections, waveform, play button") : Prefs.accent-scope == 1 ? @tr("Also playback icons, slider knobs, markers and movie controls – instead of white") : @tr("Whole interface: also backgrounds, lines, titles and secondary text");
                    Segmented {
                        options: [@tr("Accents"), @tr("Elements"), @tr("Everything")];
                        selected: Prefs.accent-scope;
                        changed(i) => {
                            Prefs.accent-scope = i;
                            Prefs.changed("accent-scope");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Glow strength");
                    hint: @tr("{}% – behind the cover, the play button and at the top of the window", round(Prefs.glow * 100));
                    HSlider {
                        width: 180px;
                        minimum: 0;
                        maximum: 2;
                        step: 0.1;
                        value: Prefs.glow;
                        moved(v) => {
                            Prefs.glow = v;
                            Prefs.changed("glow");
                        }
                        reset => {
                            Prefs.glow = 1;
                            Prefs.changed("glow");
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("WINDOW BACKGROUND");
                }
                SettingRow {
                    title: @tr("Background from cover");
                    hint: @tr("A subtle layer under the whole window; for movies – glow from the picture");
                    Segmented {
                        options: [@tr("None"), @tr("Blurred cover"), @tr("Color gradient")];
                        selected: Prefs.backdrop;
                        changed(i) => {
                            Prefs.backdrop = i;
                            Prefs.changed("backdrop");
                        }
                    }
                }
                if Prefs.backdrop > 0: SettingRow {
                    title: @tr("Background opacity");
                    hint: round(Prefs.backdrop-opacity * 100) + "%";
                    HSlider {
                        width: 180px;
                        minimum: 0.04;
                        maximum: 0.6;
                        step: 0.02;
                        value: Prefs.backdrop-opacity;
                        moved(v) => {
                            Prefs.backdrop-opacity = v;
                            Prefs.changed("backdrop-opacity");
                        }
                        reset => {
                            Prefs.backdrop-opacity = 0.2;
                            Prefs.changed("backdrop-opacity");
                        }
                    }
                }
                if Prefs.backdrop > 0: SettingSwitch {
                    title: @tr("Background motion");
                    hint: @tr("Slowly drifting spots of light in the cover's colors – the window redraws constantly (more power)");
                    checked <=> Prefs.backdrop-motion;
                    toggled => { Prefs.changed("backdrop-motion"); }
                }
                Rectangle {
                    height: 10px;
                }
                SettingRow {
                    title: @tr("Glass: transparency");
                    hint: @tr("{}% – all windows, menus, panels and sidebars show the blurred cover or movie through", round(Prefs.panel-glass * 100));
                    HSlider {
                        width: 180px;
                        minimum: 0;
                        maximum: 0.8;
                        step: 0.05;
                        value: Prefs.panel-glass;
                        moved(v) => {
                            Prefs.panel-glass = v;
                            Prefs.changed("panel-glass");
                        }
                        reset => {
                            Prefs.panel-glass = 0;
                            Prefs.changed("panel-glass");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Glass: tint");
                    hint: @tr("Background color of all windows, menus and panels");
                    Segmented {
                        options: [@tr("Neutral"), @tr("From accent"), @tr("Black")];
                        selected: Prefs.glass-tint;
                        changed(i) => {
                            Prefs.glass-tint = i;
                            Prefs.changed("glass-tint");
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("SHAPE AND TEXT");
                }
                SettingRow {
                    title: @tr("Corner rounding");
                    Segmented {
                        options: [@tr("Sharp"), @tr("Normal"), @tr("Strong")];
                        selected: Prefs.corners;
                        changed(i) => {
                            Prefs.corners = i;
                            Prefs.changed("corners");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Text size");
                    Segmented {
                        options: ["90%", "100%", "110%", "125%"];
                        selected: Prefs.text-scale < 0.95 ? 0 : Prefs.text-scale < 1.05 ? 1 : Prefs.text-scale < 1.15 ? 2 : 3;
                        changed(i) => {
                            Prefs.text-scale = [0.9, 1, 1.1, 1.25][i];
                            Prefs.changed("text-scale");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Compact interface");
                    hint: @tr("Shorter list and navigation rows, smaller spacing and cover – more tracks on screen");
                    checked <=> Prefs.compact-ui;
                    toggled => { Prefs.changed("compact-ui"); }
                }
                SettingRow {
                    title: @tr("Title font");
                    Segmented {
                        options: [@tr("Serif"), @tr("Sans-serif"), @tr("Technical")];
                        selected: Prefs.title-font;
                        changed(i) => {
                            Prefs.title-font = i;
                            Prefs.changed("title-font");
                        }
                    }
                }
            }
            if Ui.settings-page == 1: Page {
                heading: @tr("Layout");
                SectionTitle {
                    text: @tr("NAVIGATION PANEL");
                }
                SettingRow {
                    title: @tr("Panel text size");
                    Segmented {
                        options: ["90%", "100%", "115%", "130%"];
                        selected: Prefs.nav-text < 0.95 ? 0 : Prefs.nav-text < 1.07 ? 1 : Prefs.nav-text < 1.22 ? 2 : 3;
                        changed(i) => {
                            Prefs.nav-text = [0.9, 1, 1.15, 1.3][i];
                            Prefs.changed("nav-text");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Navigation panel");
                    checked <=> Prefs.show-sidebar;
                    toggled => { Prefs.changed("show-sidebar"); }
                }
                if Prefs.show-sidebar: SettingSwitch {
                    title: @tr("Panel: playlists");
                    checked <=> Prefs.nav-playlist;
                    toggled => { Prefs.changed("nav-sections"); }
                }
                if Prefs.show-sidebar: SettingSwitch {
                    title: @tr("Panel: music");
                    checked <=> Prefs.nav-music;
                    toggled => { Prefs.changed("nav-sections"); }
                }
                if Prefs.show-sidebar: SettingSwitch {
                    title: @tr("Panel: video");
                    checked <=> Prefs.nav-video;
                    toggled => { Prefs.changed("nav-sections"); }
                }
                if Prefs.show-sidebar: SettingSwitch {
                    title: @tr("Panel: collections");
                    checked <=> Prefs.nav-sets;
                    toggled => { Prefs.changed("nav-sections"); }
                }
                if Prefs.show-sidebar: SettingSwitch {
                    title: @tr("Panel: smart playlists");
                    checked <=> Prefs.nav-smart;
                    toggled => { Prefs.changed("nav-sections"); }
                }
                if Prefs.show-sidebar: SettingSwitch {
                    title: @tr("Panel: folders");
                    checked <=> Prefs.nav-folders;
                    toggled => { Prefs.changed("nav-sections"); }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("TRACK LISTS");
                }
                SettingRow {
                    title: @tr("Track view");
                    hint: Prefs.track-grid ? @tr("Covers {} px – the same slider is above the list", round(Prefs.grid-size)) : @tr("List – slide right to show covers");
                    HSlider {
                        width: 180px;
                        minimum: 90;
                        maximum: 280;
                        step: 10;
                        value: Prefs.view-size;
                        moved(v) => { Prefs.set-view(v); }
                        reset => { Prefs.set-view(160); }
                    }
                }
                SettingSwitch {
                    title: @tr("Captions on covers");
                    hint: @tr("Title and subtitle at the bottom of the cover instead of below it – more covers fit on screen");
                    checked <=> Prefs.caption-overlay;
                    toggled => { Prefs.changed("caption-overlay"); }
                }
                SettingSwitch {
                    title: @tr("Group list by album");
                    hint: @tr("A header with cover above each album");
                    checked <=> Prefs.group-albums;
                    toggled => { Prefs.changed("group-albums"); }
                }
                SettingSwitch {
                    title: @tr("Scroll long titles");
                    checked <=> Prefs.scroll-title;
                    toggled => { Prefs.changed("scroll-title"); }
                }
                SettingSwitch {
                    title: @tr("Show remaining time");
                    checked <=> Prefs.remaining;
                    toggled => { Prefs.changed("remaining"); }
                }
            }
            if Ui.settings-page == 2: Page {
                heading: @tr("Visualization");
                SectionTitle {
                    text: @tr("ANALYZER");
                }
                SettingRow {
                    title: @tr("Analyzer bar count");
                    hint: Prefs.viz-bands + "";
                    HSlider {
                        width: 180px;
                        minimum: 16;
                        maximum: 96;
                        step: 4;
                        value: Prefs.viz-bands;
                        moved(v) => {
                            Prefs.viz-bands = v;
                            Prefs.changed("viz-bands");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Analyzer sensitivity");
                    HSlider {
                        width: 180px;
                        minimum: -12;
                        maximum: 12;
                        step: 1;
                        centered: true;
                        value: Prefs.viz-sensitivity;
                        moved(v) => {
                            Prefs.viz-sensitivity = v;
                            Prefs.changed("viz-sensitivity");
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("TRACK STRIP");
                }
                SettingSwitch {
                    title: @tr("Track waveform on the seek bar");
                    checked <=> Prefs.show-waveform;
                    toggled => { Prefs.changed("show-waveform"); }
                }
                if Prefs.show-waveform: SettingRow {
                    title: @tr("Track strip style");
                    ComboBox {
                        width: 200px;
                        model: [@tr("Wave"), @tr("Bars"), @tr("From bottom"), @tr("Contour"), @tr("Dense bars"), @tr("Mirror"), @tr("LEDs"), @tr("3D bars"), @tr("3D wave"), @tr("Line"), @tr("Dots")];
                        current-index: Prefs.wave-style;
                        selected => {
                            Prefs.wave-style = self.current-index;
                            Prefs.changed("wave-style");
                        }
                    }
                }
                if Prefs.show-waveform: SettingRow {
                    title: @tr("Effect at the playhead");
                    hint: @tr("The part of the strip around the playhead moves with the music");
                    ComboBox {
                        width: 200px;
                        model: [@tr("effect" => "Off"), @tr("Strip pulse"), @tr("Spectrum bars"), @tr("Spectrum wave"), @tr("Peak dots"), @tr("Envelope"), @tr("Shockwave")];
                        current-index: Prefs.live-style;
                        selected => {
                            Prefs.live-style = self.current-index;
                            Prefs.changed("live-style");
                        }
                    }
                }
                if Prefs.show-waveform && Prefs.live-style > 0: SettingRow {
                    title: @tr("Effect range");
                    Segmented {
                        options: [@tr("Narrow"), @tr("Medium"), @tr("Wide")];
                        selected: Prefs.live-span;
                        changed(i) => {
                            Prefs.live-span = i;
                            Prefs.changed("live-span");
                        }
                    }
                }
                if Prefs.show-waveform: SettingSwitch {
                    title: @tr("Glow at the playhead");
                    checked <=> Prefs.live-glow;
                    toggled => { Prefs.changed("live-glow"); }
                }
            }
            if Ui.settings-page == 3: Page {
                heading: @tr("Playback");
                SectionTitle {
                    text: @tr("GENERAL");
                }
                SettingSwitch {
                    title: @tr("Resume on startup");
                    hint: @tr("The last track from where you left off");
                    checked <=> Prefs.resume-on-start;
                    toggled => { Prefs.changed("resume-on-start"); }
                }
                SettingSwitch {
                    title: @tr("Follow the playing track");
                    hint: @tr("The list scrolls to the current track");
                    checked <=> Prefs.follow-playing;
                    toggled => { Prefs.changed("follow-playing"); }
                }
                SettingRow {
                    title: @tr("Arrow key seek step");
                    hint: round(Prefs.seek-step) + " s";
                    HSlider {
                        width: 180px;
                        minimum: 2;
                        maximum: 30;
                        step: 1;
                        value: Prefs.seek-step;
                        moved(v) => {
                            Prefs.seek-step = v;
                            Prefs.changed("seek-step");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Watched and played after");
                    hint: @tr("{}% of the length – only then does a play count, and a movie is marked watched", round(Prefs.played-pct));
                    HSlider {
                        width: 180px;
                        minimum: 10;
                        maximum: 100;
                        step: 5;
                        value: Prefs.played-pct;
                        moved(v) => {
                            Prefs.played-pct = v;
                            Prefs.changed("played-pct");
                        }
                        reset => {
                            Prefs.played-pct = 80;
                            Prefs.changed("played-pct");
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("SCROBBLING");
                }
                SettingRow {
                    title: @tr("ListenBrainz token");
                    hint: @tr("Scrobbling of played tracks – a token from listenbrainz.org/settings; empty turns it off");
                    LineEdit {
                        width: 220px;
                        input-type: password;
                        text <=> Prefs.lb-token;
                        edited => { Prefs.changed("lb-token"); }
                    }
                }
            }
            if Ui.settings-page == 4: Page {
                heading: @tr("Audio");
                SectionTitle {
                    text: @tr("OUTPUT");
                }
                SettingRow {
                    title: @tr("Output device");
                    ComboBox {
                        width: 280px;
                        model: Prefs.devices;
                        current-index: Prefs.device;
                        selected => {
                            Prefs.device = self.current-index;
                            Prefs.changed("device");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Exclusive mode (WASAPI Exclusive)");
                    hint: @tr("The sound card plays at the file's sample rate, bypassing the Windows mixer – other programs cannot play meanwhile");
                    checked <=> Prefs.exclusive;
                    toggled => { Prefs.changed("exclusive"); }
                }
                SettingRow {
                    title: @tr("Resampling quality");
                    hint: @tr("When the file's sample rate differs from the card (from the next track)");
                    Segmented {
                        options: [@tr("Fast"), @tr("Good"), @tr("Best")];
                        selected <=> Prefs.resample-quality;
                        changed => { Prefs.changed("resample-quality"); }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("VOLUME AND SOUND");
                }
                SettingRow {
                    title: @tr("ReplayGain");
                    hint: @tr("Levels track volume – from tags, and measures untagged files itself (EBU R128)");
                    Segmented {
                        options: [@tr("Off"), @tr("Track"), @tr("Album")];
                        selected <=> Prefs.replaygain;
                        changed => { Prefs.changed("replaygain"); }
                    }
                }
                SettingRow {
                    title: @tr("ReplayGain preamp");
                    hint: (Prefs.rg-preamp > 0 ? "+" : "") + round(Prefs.rg-preamp) + " dB";
                    HSlider {
                        width: 180px;
                        minimum: -12;
                        maximum: 12;
                        step: 0.5;
                        centered: true;
                        value: Prefs.rg-preamp;
                        moved(v) => {
                            Prefs.rg-preamp = v;
                            Prefs.changed("rg-preamp");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Limiter");
                    hint: @tr("Prevents clipping with a boosted equalizer");
                    checked <=> Prefs.limiter;
                    toggled => { Prefs.changed("limiter"); }
                }
                SettingRow {
                    title: @tr("Equalizer and effects");
                    hint: @tr("18 bands, presets, balance, stereo width, crossfeed");
                    Btn {
                        text: @tr("Open equalizer");
                        icon: Icons.equalizer;
                        clicked => {
                            Ui.settings = false;
                            Ui.equalizer = true;
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("TRANSITIONS");
                }
                SettingRow {
                    title: @tr("Crossfade");
                    hint: Prefs.crossfade > 0 ? round(Prefs.crossfade * 10) / 10 + " s" : @tr("Off – gapless playback");
                    HSlider {
                        width: 180px;
                        minimum: 0;
                        maximum: 12;
                        step: 0.5;
                        value: Prefs.crossfade;
                        moved(v) => {
                            Prefs.crossfade = v;
                            Prefs.changed("crossfade");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Smooth pause");
                    hint: @tr("A short fade on pause and resume");
                    checked <=> Prefs.soft-pause;
                    toggled => { Prefs.changed("soft-pause"); }
                }
            }
            if Ui.settings-page == 5: Page {
                heading: @tr("Video");
                SectionTitle {
                    text: @tr("MOVIE VIEW");
                }
                SettingSwitch {
                    title: @tr("Open movies in full screen");
                    hint: @tr("Off – the movie plays in the window, in place of the cover next to the description; click the picture or press F for full screen");
                    checked <=> Prefs.video-open-view;
                    toggled => { Prefs.changed("video-open-view"); }
                }
                SettingRow {
                    title: @tr("The “Library” button during a movie");
                    hint: @tr("What happens to the movie when you go back to the library with it (Esc returns to the window, the movie keeps playing)");
                    ComboBox {
                        width: 240px;
                        model: [@tr("Picture keeps playing in the window"), @tr("Audio only"), @tr("Pause")];
                        current-index: Prefs.video-leave;
                        selected => {
                            Prefs.video-leave = self.current-index;
                            Prefs.changed("video-leave");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Hide controls in the window too");
                    hint: @tr("In full screen, controls and the cursor always hide");
                    checked <=> Prefs.autohide-window;
                    toggled => { Prefs.changed("autohide-window"); }
                }
                SettingRow {
                    title: @tr("Hide controls");
                    hint: @tr("After {} s without mouse movement", round(Prefs.autohide-ms / 100) / 10);
                    HSlider {
                        width: 180px;
                        minimum: 1000;
                        maximum: 8000;
                        step: 250;
                        value: Prefs.autohide-ms;
                        moved(v) => {
                            Prefs.autohide-ms = v;
                            Prefs.changed("autohide-ms");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Frame preview above the seek bar");
                    hint: @tr("A thumbnail of the spot under the cursor (local files)");
                    checked <=> Prefs.seek-preview;
                    toggled => { Prefs.changed("seek-preview"); }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("MOVIE PLAYBACK");
                }
                SettingSwitch {
                    title: @tr("Resume movies");
                    hint: @tr("A movie starts where you stopped it");
                    checked <=> Prefs.video-resume;
                    toggled => { Prefs.changed("video-resume"); }
                }
                SettingSwitch {
                    title: @tr("After a movie, play the next file from the list");
                    checked <=> Prefs.video-autonext;
                    toggled => { Prefs.changed("video-autonext"); }
                }
                SettingRow {
                    title: @tr("Mouse wheel over the picture");
                    hint: @tr("With Ctrl – zoom the picture");
                    Segmented {
                        options: [@tr("Volume"), @tr("Seeking")];
                        selected: Prefs.wheel-action;
                        changed(i) => {
                            Prefs.wheel-action = i;
                            Prefs.changed("wheel-action");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Double-click near the edge seeks 10 s");
                    hint: @tr("Left quarter – back, right – forward; in the middle – full screen");
                    checked <=> Prefs.dblclick-seek;
                    toggled => { Prefs.changed("dblclick-seek"); }
                }
                SettingSwitch {
                    title: @tr("Keep the computer awake during movies");
                    checked <=> Prefs.prevent-sleep;
                    toggled => { Prefs.changed("prevent-sleep"); }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("PICTURE");
                }
                SettingRow {
                    title: @tr("Picture quality");
                    hint: [@tr("Bilinear scaling – lightest, for slow computers"), @tr("Spline36 and correct downscaling – a good picture without load"), @tr("EWA Lanczos and HDR peak detection – a sharper picture"), @tr("The sharpest scaling – for powerful graphics cards")][Prefs.video-quality];
                    Segmented {
                        options: [@tr("Fast"), @tr("Balanced"), @tr("High"), @tr("Highest")];
                        selected: Prefs.video-quality;
                        changed(i) => {
                            Prefs.video-quality = i;
                            Prefs.changed("video-quality");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Hardware decoding");
                    hint: @tr("The graphics card decodes video – less CPU load");
                    ComboBox {
                        width: 240px;
                        model: [@tr("Off"), @tr("Automatic (recommended)"), @tr("Automatic with copy-back"), @tr("D3D11 (copy-back)"), @tr("NVIDIA NVDEC (copy-back)"), @tr("DXVA2 (copy-back)")];
                        current-index: Prefs.hwdec-mode;
                        selected => {
                            Prefs.hwdec-mode = self.current-index;
                            Prefs.changed("hwdec-mode");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Smooth motion (frame interpolation)");
                    hint: @tr("Matches the movie to the display refresh rate – no judder with 24 fps on 60 Hz");
                    checked <=> Prefs.interpolation;
                    toggled => { Prefs.changed("interpolation"); }
                }
                SettingSwitch {
                    title: @tr("Debanding");
                    hint: @tr("Smooth sky and shadow gradients in heavily compressed files");
                    checked <=> Prefs.deband;
                    toggled => { Prefs.changed("deband"); }
                }
                SettingRow {
                    title: @tr("HDR tone mapping");
                    hint: @tr("How HDR movies are shown on a regular display");
                    ComboBox {
                        width: 200px;
                        model: [@tr("Automatic"), "BT.2390", @tr("Hable (filmic)"), "Mobius", "Reinhard", @tr("Clip")];
                        current-index: Prefs.tone-mapping;
                        selected => {
                            Prefs.tone-mapping = self.current-index;
                            Prefs.changed("tone-mapping");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Deinterlacing");
                    checked <=> Prefs.deinterlace;
                    toggled => { Prefs.changed("deinterlace"); }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("COLORS AND GLOW");
                }
                SettingRow {
                    title: @tr("Ambient glow");
                    hint: @tr("Soft light in the movie's colors around the picture and in the side bars");
                    Segmented {
                        options: [@tr("glow" => "Off"), @tr("Subtle"), @tr("glow" => "Strong")];
                        selected: Prefs.ambient;
                        changed(i) => {
                            Prefs.ambient = i;
                            Prefs.changed("ambient");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Accent color from picture");
                    hint: @tr("The program's accent smoothly follows the movie's colors");
                    checked <=> Prefs.video-tint;
                    toggled => { Prefs.changed("video-tint"); }
                }
                if Prefs.video-tint: SettingRow {
                    title: @tr("How often to sample the picture's color");
                    hint: @tr("More often – the color keeps up with the scene faster; less often – calmer and lighter on the graphics card");
                    Segmented {
                        options: [@tr("0.5 s"), @tr("1.2 s"), "3 s", "8 s"];
                        selected: Prefs.tint-rate;
                        changed(i) => {
                            Prefs.tint-rate = i;
                            Prefs.changed("tint-rate");
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("MOVIE AUDIO");
                }
                SettingRow {
                    title: @tr("Volume boost");
                    hint: @tr("{}% at full volume – for quiet movies", round(Prefs.volume-boost));
                    HSlider {
                        width: 180px;
                        minimum: 100;
                        maximum: 200;
                        step: 5;
                        value: Prefs.volume-boost;
                        moved(v) => {
                            Prefs.volume-boost = v;
                            Prefs.changed("volume-boost");
                        }
                        reset => {
                            Prefs.volume-boost = 100;
                            Prefs.changed("volume-boost");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Night mode");
                    hint: @tr("Compressed dynamics: dialogue is audible, explosions don't wake the household");
                    checked <=> Prefs.night-mode;
                    toggled => { Prefs.changed("night-mode"); }
                }
                SettingSwitch {
                    title: @tr("Downmix surround sound to stereo");
                    hint: @tr("For headphones and stereo speakers – dialogue from the center channel isn't lost");
                    checked <=> Prefs.downmix;
                    toggled => { Prefs.changed("downmix"); }
                }
                SettingRow {
                    title: @tr("Preferred audio languages");
                    hint: @tr("Comma-separated codes, e.g. eng,pol");
                    LineEdit {
                        width: 180px;
                        text <=> Prefs.audio-lang;
                        edited => { Prefs.changed("audio-lang"); }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("NETWORK");
                }
                SettingSwitch {
                    title: @tr("Videos from streaming sites (yt-dlp)");
                    hint: @tr("Links to YouTube and other sites – the program downloads and updates yt-dlp itself");
                    checked <=> Prefs.ytdl;
                    toggled => { Prefs.changed("ytdl"); }
                }
                SettingRow {
                    title: @tr("Online video quality");
                    ComboBox {
                        width: 180px;
                        model: [@tr("Best"), @tr("Up to 1080p"), @tr("Up to 720p"), @tr("Up to 480p")];
                        current-index: Prefs.ytdl-format;
                        selected => {
                            Prefs.ytdl-format = self.current-index;
                            Prefs.changed("ytdl-format");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Stream buffer");
                    hint: @tr("{} MB of memory to buffer online video", Prefs.cache-mb);
                    HSlider {
                        width: 180px;
                        minimum: 32;
                        maximum: 1024;
                        step: 32;
                        value: Prefs.cache-mb;
                        moved(v) => {
                            Prefs.cache-mb = v;
                            Prefs.changed("cache-mb");
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("ENGINE AND FILES");
                }
                SettingRow {
                    title: @tr("Video engine");
                    hint: Prefs.mpv-info;
                    Text {
                        text: Prefs.mpv-ok ? @tr("ready") : @tr("unavailable");
                        color: Prefs.mpv-ok ? Theme.ok : Theme.danger;
                        font-size: Theme.fs;
                    }
                }
                SettingRow {
                    title: @tr("Screenshot folder");
                    hint: Prefs.screenshot-dir;
                    Btn {
                        text: @tr("Change…");
                        clicked => { Prefs.pick-screenshot-dir(); }
                    }
                }
            }
            if Ui.settings-page == 6: Page {
                heading: @tr("Subtitles");
                SettingRow {
                    title: @tr("Subtitle size");
                    hint: Prefs.sub-size + "";
                    HSlider {
                        width: 180px;
                        minimum: 24;
                        maximum: 90;
                        step: 1;
                        value: Prefs.sub-size;
                        moved(v) => {
                            Prefs.sub-size = v;
                            Prefs.changed("sub-size");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Font");
                    hint: @tr("The name of a font installed in Windows");
                    LineEdit {
                        width: 200px;
                        text <=> Prefs.sub-font;
                        edited => { Prefs.changed("sub-font"); }
                    }
                }
                SettingRow {
                    title: @tr("Color");
                    HorizontalLayout {
                        spacing: 6px;
                        for c[i] in [#ffffff, #ffe14d, #86e1ff, #a6ffa0]: Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: c;
                            border-width: Prefs.sub-color == i ? 2px : 1px;
                            border-color: Prefs.sub-color == i ? Theme.tint : Theme.line2;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Prefs.sub-color = i;
                                    Prefs.changed("sub-color");
                                }
                            }
                        }
                    }
                }
                SettingRow {
                    title: @tr("Style");
                    hint: [@tr("Black outline – readable on any background"), @tr("Soft shadow"), @tr("A semi-transparent box under the text")][Prefs.sub-style];
                    Segmented {
                        options: [@tr("Outline"), @tr("Shadow"), @tr("Box")];
                        selected: Prefs.sub-style;
                        changed(i) => {
                            Prefs.sub-style = i;
                            Prefs.changed("sub-style");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Position");
                    hint: Prefs.sub-pos >= 100 ? @tr("At the bottom edge of the picture") : @tr("{}% of the height higher", 100 - Prefs.sub-pos);
                    HSlider {
                        width: 180px;
                        minimum: 40;
                        maximum: 110;
                        step: 1;
                        value: Prefs.sub-pos;
                        moved(v) => {
                            Prefs.sub-pos = v;
                            Prefs.changed("sub-pos");
                        }
                        reset => {
                            Prefs.sub-pos = 100;
                            Prefs.changed("sub-pos");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Bold");
                    checked <=> Prefs.sub-bold;
                    toggled => { Prefs.changed("sub-bold"); }
                }
                SettingSwitch {
                    title: @tr("Custom style for ASS subtitles too");
                    hint: @tr("Styled subtitles (anime, karaoke) get the font and color from settings");
                    checked <=> Prefs.sub-override;
                    toggled => { Prefs.changed("sub-override"); }
                }
                SettingRow {
                    title: @tr("Subtitles from the movie's folder");
                    hint: @tr("Which subtitle files next to the movie to load automatically");
                    ComboBox {
                        width: 200px;
                        model: [@tr("Don't load"), @tr("Same name"), @tr("Similar name"), @tr("All in the folder")];
                        current-index: Prefs.sub-auto;
                        selected => {
                            Prefs.sub-auto = self.current-index;
                            Prefs.changed("sub-auto");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Preferred subtitle languages");
                    hint: @tr("Comma-separated codes, e.g. eng,pol");
                    LineEdit {
                        width: 180px;
                        text <=> Prefs.sub-lang;
                        edited => { Prefs.changed("sub-lang"); }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("LYRICS AND SUBTITLES IN THE PANEL");
                }
                // Podgląd: linia przed, bieżąca i po.
                Rectangle {
                    height: LyricStyle.line-h * 3 + 12px;
                    border-radius: Theme.radius;
                    background: Theme.hover;
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 6px;
                        for t[i] in [@tr("A line already sung"), @tr("The line being sung now"), @tr("The next line")]: LyricText {
                            height: LyricStyle.line-h;
                            text: t;
                            synced: true;
                            active: i == 1;
                            dist: i == 1 ? 0 : 1;
                            overflow: elide;
                        }
                    }
                }
                SettingRow {
                    title: @tr("Font");
                    hint: @tr("The name of a font installed in Windows; empty – the program's font");
                    LineEdit {
                        width: 200px;
                        text <=> Prefs.lyr-font;
                        edited => { Prefs.changed("lyr-style"); }
                    }
                }
                SettingRow {
                    title: @tr("Size");
                    hint: Prefs.lyr-size + " px";
                    HSlider {
                        width: 180px;
                        minimum: 10;
                        maximum: 36;
                        step: 1;
                        value: Prefs.lyr-size;
                        moved(v) => {
                            Prefs.lyr-size = v;
                            Prefs.changed("lyr-style");
                        }
                        reset => {
                            Prefs.lyr-size = 16;
                            Prefs.changed("lyr-style");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Current line enlarged");
                    hint: Prefs.lyr-active-scale + "%";
                    HSlider {
                        width: 180px;
                        minimum: 100;
                        maximum: 180;
                        step: 5;
                        value: Prefs.lyr-active-scale;
                        moved(v) => {
                            Prefs.lyr-active-scale = v;
                            Prefs.changed("lyr-style");
                        }
                        reset => {
                            Prefs.lyr-active-scale = 125;
                            Prefs.changed("lyr-style");
                        }
                    }
                }
                SettingRow {
                    title: @tr("Line spacing");
                    hint: Prefs.lyr-spacing + "%";
                    HSlider {
                        width: 180px;
                        minimum: 120;
                        maximum: 320;
                        step: 10;
                        value: Prefs.lyr-spacing;
                        moved(v) => {
                            Prefs.lyr-spacing = v;
                            Prefs.changed("lyr-style");
                        }
                        reset => {
                            Prefs.lyr-spacing = 200;
                            Prefs.changed("lyr-style");
                        }
                    }
                }
                for row[r] in [@tr("Color of the other lines"), @tr("Color of the sung line")]: SettingRow {
                    title: row;
                    hint: (r == 0 ? Prefs.lyr-color : Prefs.lyr-active-color) == 0 ? @tr("From the theme") : "";
                    HorizontalLayout {
                        spacing: 6px;
                        for c[i] in LyricStyle.palette: Rectangle {
                            property <int> cur: r == 0 ? Prefs.lyr-color : Prefs.lyr-active-color;
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            // Pierwsze kółko – kolor z motywu.
                            background: i == 0 ? (r == 0 ? Theme.text2 : Theme.text) : c;
                            border-width: self.cur == i ? 2px : 1px;
                            border-color: self.cur == i ? Theme.tint : Theme.line2;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if r == 0 {
                                        Prefs.lyr-color = i;
                                    } else {
                                        Prefs.lyr-active-color = i;
                                    }
                                    Prefs.changed("lyr-style");
                                }
                            }
                        }
                    }
                }
                SettingRow {
                    title: @tr("Alignment");
                    Segmented {
                        options: [@tr("Left"), @tr("Center")];
                        selected: Prefs.lyr-align;
                        changed(i) => {
                            Prefs.lyr-align = i;
                            Prefs.changed("lyr-style");
                        }
                    }
                }
                SettingSwitch {
                    title: @tr("Sung line in bold");
                    checked <=> Prefs.lyr-bold;
                    toggled => { Prefs.changed("lyr-style"); }
                }
                SettingSwitch {
                    title: @tr("Fade lines further from the sung one");
                    checked <=> Prefs.lyr-fade;
                    toggled => { Prefs.changed("lyr-style"); }
                }
            }
            if Ui.settings-page == 7: Page {
                heading: @tr("Library");
                FolderList {
                    kind: 0;
                    title: @tr("MUSIC");
                    hint: @tr("Music folders – artists, albums, genres, years and folders.");
                    folders: Prefs.folders;
                }
                Rectangle {
                    height: 18px;
                }
                FolderList {
                    kind: 1;
                    title: @tr("VIDEO");
                    hint: @tr("Movie and TV show folders – all videos, folders, continue watching.");
                    folders: Prefs.video-folders;
                }
                Rectangle {
                    height: 18px;
                }
                Text {
                    text: @tr("Network drives: add a folder on a mapped drive (e.g. Z:\\Music) or a share path (\\\\NAS\\Music). When the server is off, the library keeps its files and refreshes them on the next scan.");
                    color: Theme.text3;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 10px;
                }
                HorizontalLayout {
                    alignment: start;
                    Btn {
                        text: @tr("Scan library now");
                        icon: Icons.refresh;
                        clicked => { Prefs.changed("rescan"); }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("MUSIC ONLINE");
                }
                SettingSwitch {
                    title: @tr("Download missing lyrics from LRCLIB");
                    hint: @tr("Sends only the artist, title, album and duration");
                    checked <=> Prefs.online-lyrics;
                    toggled => { Prefs.changed("online-lyrics"); }
                }
                SettingSwitch {
                    title: @tr("Download missing covers");
                    hint: @tr("From MusicBrainz and Cover Art Archive – sends only the artist and album");
                    checked <=> Prefs.online-covers;
                    toggled => { Prefs.changed("online-covers"); }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("MOVIES ONLINE");
                }
                SettingRow {
                    title: @tr("TMDB API key");
                    hint: @tr("Movie posters, descriptions, genres and ratings in your language – a free key from themoviedb.org (Settings → API)");
                    LineEdit {
                        width: 220px;
                        input-type: password;
                        text <=> Prefs.tmdb-key;
                        edited => { Prefs.changed("tmdb-key"); }
                    }
                }
                SettingRow {
                    title: @tr("OpenSubtitles API key");
                    hint: @tr("One-click subtitle download in your language – a key from opensubtitles.com (Account → API)");
                    LineEdit {
                        width: 220px;
                        input-type: password;
                        text <=> Prefs.os-key;
                        edited => { Prefs.changed("os-key"); }
                    }
                }
            }
            if Ui.settings-page == 8: Page {
                heading: @tr("Keyboard shortcuts");
                for k in Prefs.keys: HorizontalLayout {
                    height: 30px;
                    spacing: 12px;
                    Rectangle {
                        width: 190px;
                        HorizontalLayout {
                            alignment: start;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 22px;
                                width: kt.preferred-width + 14px;
                                border-radius: 5px;
                                background: Theme.panel2;
                                border-width: 1px;
                                border-color: Theme.line2;
                                kt := Text {
                                    text: k.keys;
                                    color: Theme.text;
                                    font-size: Theme.fs-sm;
                                    font-family: Theme.mono;
                                }
                            }
                        }
                    }
                    Text {
                        text: k.action;
                        color: Theme.text2;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }
                }
                SectionTitle {
                    text: @tr("YOUR SHORTCUTS");
                }
                Text {
                    text: @tr("Click a field and press a key combination; Backspace removes it. Your shortcuts take precedence over the ones above.");
                    color: Theme.text3;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                for c in Prefs.custom-keys: HorizontalLayout {
                    height: 32px;
                    spacing: 12px;
                    Rectangle {
                        width: 190px;
                        KeyCapture {
                            x: 0;
                            keys: c.keys;
                            captured(t, ctrl, shift, alt) => { Prefs.custom-key(c.id, t, ctrl, shift, alt); }
                        }
                    }
                    Text {
                        text: c.action;
                        color: Theme.text2;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }
                }
            }
            if Ui.settings-page == 9: Page {
                heading: @tr("System");
                SectionTitle {
                    text: @tr("WINDOWS");
                }
                SettingSwitch {
                    title: @tr("Single program window");
                    hint: @tr("Opened files go to the running OpenMP");
                    checked <=> Prefs.single-instance;
                    toggled => { Prefs.changed("single-instance"); }
                }
                SettingSwitch {
                    title: @tr("Icon in the notification area");
                    hint: @tr("Closing the window hides it there and playback continues; right-click the icon for the menu");
                    checked <=> Prefs.tray;
                    toggled => { Prefs.changed("tray"); }
                }
                SettingSwitch {
                    title: @tr("Media keys and the Windows panel");
                    hint: @tr("Control from the keyboard, headphones and the volume overlay");
                    checked <=> Prefs.media-keys;
                    toggled => { Prefs.changed("media-keys"); }
                }
                SettingSwitch {
                    title: @tr("Global keyboard shortcuts");
                    hint: @tr("Ctrl+Alt+Space – play/pause, Ctrl+Alt+←/→ – track, Ctrl+Alt+↑/↓ – volume; also when the window is in the background");
                    checked <=> Prefs.global-hotkeys;
                    toggled => { Prefs.changed("global-hotkeys"); }
                }
                SettingRow {
                    title: @tr("File associations");
                    hint: @tr("Set OpenMP as the default player in Windows settings");
                    Btn {
                        text: @tr("Default apps…");
                        clicked => { Prefs.associate(); }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("DATA");
                }
                SettingRow {
                    title: @tr("Backup");
                    hint: @tr("Settings, playlists, favorites, ratings and statistics in one file – also for moving to another computer");
                    HorizontalLayout {
                        spacing: 8px;
                        Btn {
                            text: @tr("Export…");
                            clicked => { Prefs.backup-export(); }
                        }
                        Btn {
                            text: @tr("Import…");
                            clicked => { Prefs.backup-import(); }
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: @tr("UPDATES");
                }
                SettingSwitch {
                    title: @tr("Check for updates automatically");
                    hint: @tr("On startup, via redzikowski.com");
                    checked <=> Prefs.check-updates;
                    toggled => { Prefs.changed("check-updates"); }
                }
                SettingRow {
                    title: @tr("Version {}", Prefs.version);
                    Btn {
                        text: @tr("Check now");
                        icon: Icons.refresh;
                        clicked => { Prefs.check-update(); }
                    }
                }
            }
            if Ui.settings-page == 10: Page {
                heading: @tr("About");
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    Image {
                        source: @image-url("../icon.png");
                        width: 64px;
                        height: 64px;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: "OpenMP";
                            color: Theme.text;
                            font-size: 24px;
                            font-weight: 700;
                        }
                        Text {
                            text: @tr("Open Media Player · version {}", Prefs.version);
                            color: Theme.text3;
                            font-size: Theme.fs;
                        }
                    }
                }
                Rectangle {
                    height: 14px;
                }
                Text {
                    text: @tr("A music and video player for Windows: its own audio engine with gapless playback, crossfade, an 18-band equalizer and ReplayGain, a music library, internet radio, song lyrics, and movie playback with subtitles and hardware decoding (mpv).");
                    color: Theme.text2;
                    font-size: Theme.fs;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 16px;
                }
                AuthorCard { }
                Rectangle {
                    height: 16px;
                }
                Text {
                    text: @tr("Built with: Slint, Symphonia, cpal, rubato, RustFFT, lofty, libmpv and FFmpeg.");
                    color: Theme.text3;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component AboutDialog inherits Dialog {
    title: @tr("About");
    card-width: 520px;
    close => { Ui.about = false; }
    VerticalLayout {
        padding: 22px;
        padding-top: 4px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            Image {
                source: @image-url("../icon.png");
                width: 64px;
                height: 64px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text {
                    text: "OpenMP";
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 700;
                }
                Text {
                    text: @tr("Open Media Player · version {}", Prefs.version);
                    color: Theme.text3;
                    font-size: Theme.fs;
                }
            }
        }
        Text {
            text: @tr("A music and video player for Windows – a rich display in music mode and a minimal, auto-hiding interface in video mode.");
            color: Theme.text2;
            font-size: Theme.fs;
            wrap: word-wrap;
        }
        AuthorCard { }
    }
}

export component UrlDialog inherits Dialog {
    title: @tr("Open URL");
    card-width: 560px;
    close => { Ui.url-dialog = false; }
    VerticalLayout {
        padding: 20px;
        padding-top: 4px;
        spacing: 12px;
        Text {
            text: @tr("A radio stream, a file on the web or a playlist (http, https, rtsp, m3u8). Links to YouTube and other video sites work too.");
            color: Theme.text3;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
        f := Field {
            text <=> Ui.url-text;
            placeholder: "https://…";
            icon: Icons.link;
            accepted(t) => { Ui.url-accepted(t); }
            escape => { Ui.url-dialog = false; }
            init => { self.focus-input(); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                text: @tr("Cancel");
                clicked => { Ui.url-dialog = false; }
            }
            Btn {
                text: @tr("Play");
                primary: true;
                enabled: Ui.url-text != "";
                clicked => { Ui.url-accepted(Ui.url-text); }
            }
        }
    }
}

export component RenameDialog inherits Dialog {
    title: Ui.rename-title;
    card-width: 420px;
    close => { Ui.rename-dialog = false; }
    VerticalLayout {
        padding: 20px;
        padding-top: 4px;
        spacing: 12px;
        Field {
            text <=> Ui.rename-text;
            clearable: false;
            accepted(t) => { Ui.rename-accepted(t); }
            escape => { Ui.rename-dialog = false; }
            init => { self.focus-input(); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                text: @tr("Cancel");
                clicked => { Ui.rename-dialog = false; }
            }
            Btn {
                text: @tr("Save");
                primary: true;
                enabled: Ui.rename-text != "";
                clicked => { Ui.rename-accepted(Ui.rename-text); }
            }
        }
    }
}

export component TagEditor inherits Dialog {
    title: @tr("Tag editing");
    card-width: 680px;
    close => { Ui.tag-editor = false; }
    in-out property <[string]> v: Ui.tag-values;
    VerticalLayout {
        padding: 20px;
        padding-top: 0px;
        spacing: 12px;
        Text {
            text: Ui.tag-title;
            color: Theme.text3;
            font-size: Theme.fs-sm;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 18px;
            VerticalLayout {
                spacing: 8px;
                width: 150px;
                Cover {
                    width: 150px;
                    height: 150px;
                    source: Ui.tag-cover;
                    has: Ui.tag-has-cover;
                }
                Btn {
                    text: @tr("Change cover…");
                    compact: true;
                    clicked => { Ui.tag-pick-cover(); }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                for f[i] in [@tr("Title"), @tr("Artist"), @tr("Album"), @tr("Album artist"), @tr("Genre"), @tr("Year"), @tr("Track no."), @tr("Disc no."), @tr("Composer"), @tr("Comment")]: HorizontalLayout {
                    spacing: 10px;
                    Text {
                        width: 130px;
                        text: f;
                        color: Theme.text2;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        height: 30px;
                        text: root.v[i];
                        placeholder-text: Ui.tag-mixed[i] ? @tr("(multiple values – unchanged)") : "";
                        edited(t) => { root.v[i] = t; }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                text: @tr("Cancel");
                clicked => { Ui.tag-editor = false; }
            }
            Btn {
                text: Ui.tag-busy ? @tr("Saving…") : @tr("Save");
                primary: true;
                enabled: !Ui.tag-busy;
                clicked => { Ui.tag-save(root.v); }
            }
        }
    }
}

export component UpdateDialog inherits Dialog {
    title: @tr("Update available");
    card-width: 520px;
    close => { Ui.update-dialog = false; }
    VerticalLayout {
        padding: 20px;
        padding-top: 4px;
        spacing: 12px;
        Text {
            text: @tr("OpenMP {} is ready to download (you have {}).", Ui.update-version, Prefs.version);
            color: Theme.text;
            font-size: Theme.fs;
            wrap: word-wrap;
        }
        if Ui.update-notes != "": Rectangle {
            height: min(180px, nt.preferred-height + 20px);
            border-radius: Theme.radius;
            background: Theme.panel2;
            ScrollView {
                nt := Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: Ui.update-notes;
                    color: Theme.text2;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
            }
        }
        if Ui.update-progress >= 0: Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.hover;
            Rectangle {
                x: 0;
                width: parent.width * Ui.update-progress;
                border-radius: 3px;
                background: Theme.tint;
            }
        }
        if Ui.update-status != "": Text {
            text: Ui.update-status;
            color: Theme.text3;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                text: @tr("Skip this version");
                clicked => { Ui.update-skip(); }
            }
            Btn {
                text: Ui.update-portable ? @tr("Open download page") : @tr("Install and restart");
                primary: true;
                enabled: Ui.update-progress < 0;
                clicked => { Ui.update-install(); }
            }
        }
    }
}
