// Okna dialogowe: korektor i efekty, ustawienia, edytor tagów, adres URL, o programie,
// aktualizacja, zmiana nazwy.

import { ScrollView, ComboBox, LineEdit, SpinBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconBtn, Btn, HSlider, VSlider, Switch, SettingRow, SettingSwitch, Segmented, Field, SectionTitle, Divider, Cover } from "widgets.slint";
import { Player, Prefs, Ui } from "state.slint";
import { GlassFill } from "glass.slint";

// Okno dialogowe: osobne okno programu (DialogWindow), karta wypełnia całe okno.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 480px;
    in property <length> card-height: 0;
    // Rozmiar, jaki dialog chce mieć – z niego bierze się rozmiar okna.
    out property <length> natural-width: card-width;
    out property <length> natural-height: card-height > 0 ? card-height : lay.preferred-height;
    callback close();
    background: Theme.glass-color;
    GlassFill {
        min-alpha: 0.5;
    }
    lay := VerticalLayout {
        HorizontalLayout {
            height: 50px;
            padding-left: 20px;
            padding-right: 10px;
            Rectangle {
                horizontal-stretch: 1;
                // Przeciąganie okna dialogu za pasek tytułu.
                TouchArea {
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
                    // Okno jedzie za kursorem, więc przesunięcie od miejsca chwycenia jest stałe.
                    moved => {
                        if self.pressed {
                            Ui.dialog-move(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }
                }
                Text {
                    x: 0;
                    width: parent.width;
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.fs-lg;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.close;
                tip: "Zamknij";
                clicked => { root.close(); }
            }
        }
        @children
    }
}

export component EqualizerDialog inherits Dialog {
    title: "Korektor i efekty dźwięku";
    card-width: 860px;
    close => { Ui.equalizer = false; }
    VerticalLayout {
        padding: 20px;
        padding-top: 4px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            Switch {
                y: (parent.height - self.height) / 2;
                checked <=> Prefs.eq-on;
                toggled => { Prefs.changed("eq-on"); }
            }
            Text {
                text: Prefs.eq-on ? "Korektor włączony" : "Korektor wyłączony";
                color: Theme.text;
                font-size: Theme.fs;
                vertical-alignment: center;
            }
            Rectangle {
                width: 14px;
            }
            Switch {
                y: (parent.height - self.height) / 2;
                checked <=> Prefs.auto-eq;
                toggled => { Prefs.changed("auto-eq"); }
            }
            Text {
                text: "Dopasuj do gatunku";
                color: Prefs.auto-eq ? Theme.text : Theme.text2;
                font-size: Theme.fs;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            ComboBox {
                width: 200px;
                model: Prefs.presets;
                current-index: Prefs.preset;
                selected => { Prefs.eq-preset(self.current-index); }
            }
            Btn {
                text: "Zapisz jako…";
                icon: Icons.add;
                clicked => { Prefs.eq-save-preset(); }
            }
            Btn {
                text: "Wyzeruj";
                clicked => { Prefs.eq-reset(); }
            }
        }
        Rectangle {
            height: 220px;
            border-radius: Theme.radius;
            background: Theme.panel2;
            opacity: Prefs.eq-on ? 1 : 0.55;
            HorizontalLayout {
                padding: 12px;
                spacing: 6px;
                VSlider {
                    label: "Wzm.";
                    range: 20;
                    value: Prefs.preamp;
                    moved(v) => {
                        Prefs.preamp = v;
                        Prefs.changed("preamp");
                    }
                }
                Rectangle {
                    width: 1px;
                    background: Theme.line2;
                }
                for g[i] in Prefs.eq: VSlider {
                    horizontal-stretch: 1;
                    value: g;
                    label: ["31", "63", "87", "125", "175", "250", "350", "500", "700", "1k", "1.4k", "2k", "2.8k", "4k", "5.6k", "8k", "11k", "16k"][i];
                    moved(v) => { Prefs.eq-band(i, v); }
                }
            }
        }
        HorizontalLayout {
            spacing: 24px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                SectionTitle {
                    text: "PRZESTRZEŃ";
                }
                SettingRow {
                    title: "Balans";
                    HSlider {
                        width: 150px;
                        minimum: -1;
                        maximum: 1;
                        centered: true;
                        value: Prefs.balance;
                        moved(v) => {
                            Prefs.balance = v;
                            Prefs.changed("balance");
                        }
                        reset => {
                            Prefs.balance = 0;
                            Prefs.changed("balance");
                        }
                    }
                }
                SettingRow {
                    title: "Szerokość stereo";
                    hint: round(Prefs.width * 100) + "%";
                    HSlider {
                        width: 150px;
                        minimum: 0;
                        maximum: 2;
                        centered: true;
                        value: Prefs.width;
                        moved(v) => {
                            Prefs.width = v;
                            Prefs.changed("width");
                        }
                        reset => {
                            Prefs.width = 1;
                            Prefs.changed("width");
                        }
                    }
                }
                SettingSwitch {
                    title: "Mono";
                    checked <=> Prefs.mono;
                    toggled => { Prefs.changed("mono"); }
                }
                SettingSwitch {
                    title: "Zamiana kanałów";
                    checked <=> Prefs.swap;
                    toggled => { Prefs.changed("swap"); }
                }
                SettingSwitch {
                    title: "Przesłuch słuchawkowy";
                    hint: "Naturalniejsza scena w słuchawkach";
                    checked <=> Prefs.crossfeed;
                    toggled => { Prefs.changed("crossfeed"); }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                SectionTitle {
                    text: "ODTWARZANIE";
                }
                SettingRow {
                    title: "Przenikanie utworów";
                    hint: Prefs.crossfade > 0 ? round(Prefs.crossfade * 10) / 10 + " s" : "Wyłączone – przejścia bez przerwy";
                    HSlider {
                        width: 150px;
                        minimum: 0;
                        maximum: 12;
                        step: 0.5;
                        value: Prefs.crossfade;
                        moved(v) => {
                            Prefs.crossfade = v;
                            Prefs.changed("crossfade");
                        }
                    }
                }
                SettingRow {
                    title: "Prędkość";
                    hint: round(Prefs.speed * 100) / 100 + "× (z tonacją, jak gramofon)";
                    HSlider {
                        width: 150px;
                        minimum: 0.5;
                        maximum: 2;
                        step: 0.05;
                        value: Prefs.speed;
                        moved(v) => {
                            Prefs.speed = v;
                            Prefs.changed("speed");
                        }
                        reset => {
                            Prefs.speed = 1;
                            Prefs.changed("speed");
                        }
                    }
                }
                SettingRow {
                    title: "ReplayGain";
                    hint: "Wyrównanie głośności z tagów";
                    Segmented {
                        small: true;
                        options: ["Wył.", "Utwór", "Album"];
                        selected <=> Prefs.replaygain;
                        changed => { Prefs.changed("replaygain"); }
                    }
                }
                SettingSwitch {
                    title: "Ogranicznik";
                    hint: "Chroni przed przesterowaniem przy podbiciu";
                    checked <=> Prefs.limiter;
                    toggled => { Prefs.changed("limiter"); }
                }
                SettingSwitch {
                    title: "Korektor parametryczny";
                    hint: Prefs.peq-name != "" ? "Profil: " + Prefs.peq-name : "Profil słuchawek z AutoEQ – wczytaj plik ParametricEQ.txt";
                    checked <=> Prefs.peq-on;
                    toggled => { Prefs.changed("peq-on"); }
                }
                HorizontalLayout {
                    alignment: start;
                    Btn {
                        text: "Wczytaj profil AutoEQ…";
                        icon: Icons.file;
                        compact: true;
                        clicked => { Prefs.changed("peq-load"); }
                    }
                }
                SettingSwitch {
                    title: "Płynna pauza";
                    hint: "Wyciszanie przy pauzie i wznowieniu";
                    checked <=> Prefs.soft-pause;
                    toggled => { Prefs.changed("soft-pause"); }
                }
            }
        }
    }
}

component Page inherits ScrollView {
    in property <string> heading;
    VerticalLayout {
        padding: 22px;
        padding-top: 16px;
        spacing: 2px;
        Text {
            text: root.heading;
            color: Theme.text;
            font-size: Theme.fs-xl;
            font-weight: 600;
        }
        Rectangle {
            height: 10px;
        }
        @children
    }
}

export component AuthorCard inherits Rectangle {
    border-radius: Theme.radius-lg;
    background: Theme.panel2;
    border-width: 1px;
    border-color: Theme.line;
    height: lay.preferred-height;
    lay := HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3px;
            Text {
                text: Prefs.author-line;
                color: Theme.text;
                font-size: Theme.fs;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: "OpenMP jest darmowy. Jeśli ci się przydaje, możesz wesprzeć dalszy rozwój.";
                color: Theme.text3;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            Btn {
                text: "redzikowski.com";
                icon: Icons.link;
                clicked => { Prefs.open-url("https://redzikowski.com"); }
            }
            Btn {
                text: "Postaw kawę";
                icon: Icons.coffee;
                primary: true;
                clicked => { Prefs.open-url("https://buycoffee.to/adamredzikowski"); }
            }
        }
    }
}

component FolderList inherits VerticalLayout {
    in property <int> kind;
    in property <string> title;
    in property <string> hint;
    in property <[string]> folders;
    spacing: 6px;
    SectionTitle {
        text: root.title;
    }
    Text {
        text: root.hint;
        color: Theme.text3;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
    if root.folders.length == 0: Text {
        text: "Brak folderów.";
        color: Theme.text3;
        font-size: Theme.fs;
    }
    for f[i] in root.folders: Rectangle {
        height: 38px;
        border-radius: Theme.radius;
        background: Theme.panel2;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 4px;
            spacing: 10px;
            Icon {
                y: (parent.height - self.height) / 2;
                icon: Icons.folder;
                size: 16px;
                fill: Theme.text3;
            }
            Text {
                text: f;
                color: Theme.text;
                font-size: Theme.fs;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            IconBtn {
                y: (parent.height - self.height) / 2;
                icon: Icons.delete;
                size: 28px;
                icon-size: 15px;
                tip: "Usuń folder z biblioteki";
                clicked => { Prefs.remove-folder(root.kind, i); }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        spacing: 8px;
        Btn {
            text: "Dodaj folder…";
            icon: Icons.add;
            compact: true;
            clicked => { Prefs.add-folder(root.kind); }
        }
        Btn {
            text: "Dodaj ścieżkę sieciową…";
            icon: Icons.link;
            compact: true;
            clicked => { Prefs.add-network-folder(root.kind); }
        }
    }
}

export component SettingsDialog inherits Dialog {
    title: "Ustawienia";
    card-width: 900px;
    card-height: 640px;
    close => { Ui.settings = false; }
    HorizontalLayout {
        vertical-stretch: 1;
        VerticalLayout {
            width: 220px;
            padding: 10px;
            spacing: 2px;
            // Szukanie ustawienia po nazwie i opisie – klik przenosi na stronę i podświetla wiersz.
            Field {
                icon: Icons.search;
                placeholder: "Szukaj ustawienia";
                text <=> Ui.settings-query;
                edited(t) => { Ui.settings-search(t); }
                escape => {
                    Ui.settings-query = "";
                    Ui.settings-search("");
                }
            }
            Rectangle {
                height: 6px;
            }
            if Ui.settings-query != "" && Ui.settings-results.length == 0: Text {
                text: "Nic nie znaleziono";
                color: Theme.text3;
                font-size: Theme.fs-sm;
                horizontal-alignment: center;
            }
            for r in Ui.settings-results: Rectangle {
                min-height: 40px;
                border-radius: Theme.radius;
                background: rta.has-hover ? Theme.hover : transparent;
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    alignment: center;
                    Text {
                        text: r.label;
                        color: Theme.text;
                        font-size: Theme.fs;
                        overflow: elide;
                    }
                    Text {
                        text: r.sub;
                        color: Theme.text3;
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                }
                rta := TouchArea {
                    clicked => {
                        Ui.settings-page = r.id.to-float();
                        Theme.settings-flash = r.label;
                    }
                }
            }
            for p[i] in [
                { icon: Icons.palette, l: "Wygląd" },
                { icon: Icons.queue, l: "Układ" },
                { icon: Icons.equalizer, l: "Wizualizacja" },
                { icon: Icons.play, l: "Odtwarzanie" },
                { icon: Icons.volume, l: "Dźwięk" },
                { icon: Icons.movie, l: "Wideo" },
                { icon: Icons.subtitles, l: "Napisy" },
                { icon: Icons.library, l: "Biblioteka" },
                { icon: Icons.keyboard, l: "Skróty klawiszowe" },
                { icon: Icons.system, l: "System" },
                { icon: Icons.info, l: "O programie" },
            ]: Rectangle {
                // Podczas szukania zamiast stron są wyniki.
                height: Ui.settings-query == "" ? 34px : 0px;
                visible: Ui.settings-query == "";
                border-radius: Theme.radius;
                background: Ui.settings-page == i ? Theme.sel : pta.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 10px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        icon: p.icon;
                        size: 16px;
                        fill: Ui.settings-page == i ? Theme.tint : Theme.text3;
                    }
                    Text {
                        text: p.l;
                        color: Ui.settings-page == i ? Theme.text : Theme.text2;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }
                }
                pta := TouchArea {
                    clicked => { Ui.settings-page = i; }
                }
            }
            Rectangle {
                vertical-stretch: 1;
            }
        }
        Rectangle {
            width: 1px;
            background: Theme.line;
        }
        Rectangle {
            horizontal-stretch: 1;
            if Ui.settings-page == 0: Page {
                heading: "Wygląd";
                SettingRow {
                    title: "Motyw";
                    Segmented {
                        options: ["Ciemny", "Jasny"];
                        selected: Prefs.dark ? 0 : 1;
                        changed(i) => {
                            Prefs.dark = i == 0;
                            Prefs.changed("dark");
                        }
                    }
                }
                SectionTitle {
                    text: "KOLOR PRZEWODNI";
                }
                SettingRow {
                    title: "Kolor akcentu";
                    hint: "Gdy okładka nie ma wyraźnej barwy – albo zawsze, gdy kolor z okładki jest wyłączony";
                    HorizontalLayout {
                        spacing: 6px;
                        for c in [{ h: "#4f8cff", c: #4f8cff }, { h: "#8b5cf6", c: #8b5cf6 }, { h: "#c026d3", c: #c026d3 }, { h: "#ec4899", c: #ec4899 }, { h: "#ef4444", c: #ef4444 }, { h: "#f97316", c: #f97316 }, { h: "#f59e0b", c: #f59e0b }, { h: "#84cc16", c: #84cc16 }, { h: "#22c55e", c: #22c55e }, { h: "#14b8a6", c: #14b8a6 }, { h: "#06b6d4", c: #06b6d4 }, { h: "#e2e8f0", c: #e2e8f0 }]: Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: c.c;
                            border-width: Prefs.accent == c.h ? 2px : 0;
                            border-color: Theme.text;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Prefs.accent = c.h;
                                    Prefs.changed("accent");
                                }
                            }
                        }
                    }
                }
                SettingRow {
                    title: "Własny kolor";
                    hint: "Zapis szesnastkowy, np. #ff6a3d";
                    LineEdit {
                        width: 110px;
                        text <=> Prefs.accent;
                        edited => { Prefs.changed("accent"); }
                    }
                }
                SettingSwitch {
                    title: "Kolor przewodni z okładki";
                    hint: "Cały program przyjmuje barwę albumu (przy filmie – barwę obrazu, gdy włączone w ustawieniach wideo)";
                    checked <=> Prefs.accent-from-cover;
                    toggled => { Prefs.changed("accent-from-cover"); }
                }
                SettingRow {
                    title: "Zasięg koloru przewodniego";
                    hint: Prefs.accent-scope == 0 ? "Tylko akcenty: zaznaczenia, fala, przycisk odtwarzania" : Prefs.accent-scope == 1 ? "Także ikony odtwarzania, gałki suwaków, znaczniki i sterowanie filmu – zamiast bieli" : "Cały interfejs: również tła, linie, tytuły i drugorzędny tekst";
                    Segmented {
                        options: ["Akcenty", "Elementy", "Całość"];
                        selected: Prefs.accent-scope;
                        changed(i) => {
                            Prefs.accent-scope = i;
                            Prefs.changed("accent-scope");
                        }
                    }
                }
                SettingRow {
                    title: "Siła poświaty";
                    hint: round(Prefs.glow * 100) + "% – za okładką, przyciskiem odtwarzania i u góry okna";
                    HSlider {
                        width: 180px;
                        minimum: 0;
                        maximum: 2;
                        step: 0.1;
                        value: Prefs.glow;
                        moved(v) => {
                            Prefs.glow = v;
                            Prefs.changed("glow");
                        }
                        reset => {
                            Prefs.glow = 1;
                            Prefs.changed("glow");
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: "TŁO OKNA";
                }
                SettingRow {
                    title: "Tło z okładki";
                    hint: "Subtelna nakładka pod całym oknem; przy filmie – poświata z obrazu";
                    Segmented {
                        options: ["Brak", "Rozmyta okładka", "Gradient barw"];
                        selected: Prefs.backdrop;
                        changed(i) => {
                            Prefs.backdrop = i;
                            Prefs.changed("backdrop");
                        }
                    }
                }
                if Prefs.backdrop > 0: SettingRow {
                    title: "Krycie tła";
                    hint: round(Prefs.backdrop-opacity * 100) + "%";
                    HSlider {
                        width: 180px;
                        minimum: 0.04;
                        maximum: 0.6;
                        step: 0.02;
                        value: Prefs.backdrop-opacity;
                        moved(v) => {
                            Prefs.backdrop-opacity = v;
                            Prefs.changed("backdrop-opacity");
                        }
                        reset => {
                            Prefs.backdrop-opacity = 0.2;
                            Prefs.changed("backdrop-opacity");
                        }
                    }
                }
                if Prefs.backdrop > 0: SettingSwitch {
                    title: "Ruch tła";
                    hint: "Powoli krążące plamy światła w barwach okładki – okno odświeża się bez przerwy (więcej prądu)";
                    checked <=> Prefs.backdrop-motion;
                    toggled => { Prefs.changed("backdrop-motion"); }
                }
                Rectangle {
                    height: 10px;
                }
                SettingRow {
                    title: "Szkło: przezroczystość";
                    hint: round(Prefs.panel-glass * 100) + "% – wszystkie okna, menu, panele i paski boczne prześwitują rozmytą okładką albo filmem";
                    HSlider {
                        width: 180px;
                        minimum: 0;
                        maximum: 0.8;
                        step: 0.05;
                        value: Prefs.panel-glass;
                        moved(v) => {
                            Prefs.panel-glass = v;
                            Prefs.changed("panel-glass");
                        }
                        reset => {
                            Prefs.panel-glass = 0;
                            Prefs.changed("panel-glass");
                        }
                    }
                }
                SettingRow {
                    title: "Szkło: barwa";
                    hint: "Kolor tła wszystkich okien, menu i paneli";
                    Segmented {
                        options: ["Neutralna", "Z akcentu", "Czerń"];
                        selected: Prefs.glass-tint;
                        changed(i) => {
                            Prefs.glass-tint = i;
                            Prefs.changed("glass-tint");
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: "KSZTAŁT I TEKST";
                }
                SettingRow {
                    title: "Zaokrąglenia";
                    Segmented {
                        options: ["Ostre", "Zwykłe", "Mocne"];
                        selected: Prefs.corners;
                        changed(i) => {
                            Prefs.corners = i;
                            Prefs.changed("corners");
                        }
                    }
                }
                SettingRow {
                    title: "Wielkość tekstu";
                    Segmented {
                        options: ["90%", "100%", "110%", "125%"];
                        selected: Prefs.text-scale < 0.95 ? 0 : Prefs.text-scale < 1.05 ? 1 : Prefs.text-scale < 1.15 ? 2 : 3;
                        changed(i) => {
                            Prefs.text-scale = [0.9, 1, 1.1, 1.25][i];
                            Prefs.changed("text-scale");
                        }
                    }
                }
                SettingSwitch {
                    title: "Kompaktowy interfejs";
                    hint: "Niższe wiersze list i panelu nawigacji, mniejsze odstępy i okładka – więcej utworów na ekranie";
                    checked <=> Prefs.compact-ui;
                    toggled => { Prefs.changed("compact-ui"); }
                }
                SettingRow {
                    title: "Czcionka tytułów";
                    Segmented {
                        options: ["Szeryfowa", "Bezszeryfowa", "Techniczna"];
                        selected: Prefs.title-font;
                        changed(i) => {
                            Prefs.title-font = i;
                            Prefs.changed("title-font");
                        }
                    }
                }
            }
            if Ui.settings-page == 1: Page {
                heading: "Układ";
                SectionTitle {
                    text: "PANEL NAWIGACJI";
                }
                SettingRow {
                    title: "Wielkość tekstu panelu";
                    Segmented {
                        options: ["90%", "100%", "115%", "130%"];
                        selected: Prefs.nav-text < 0.95 ? 0 : Prefs.nav-text < 1.07 ? 1 : Prefs.nav-text < 1.22 ? 2 : 3;
                        changed(i) => {
                            Prefs.nav-text = [0.9, 1, 1.15, 1.3][i];
                            Prefs.changed("nav-text");
                        }
                    }
                }
                SettingSwitch {
                    title: "Panel nawigacji";
                    checked <=> Prefs.show-sidebar;
                    toggled => { Prefs.changed("show-sidebar"); }
                }
                if Prefs.show-sidebar: SettingSwitch {
                    title: "Panel: listy odtwarzania";
                    checked <=> Prefs.nav-playlist;
                    toggled => { Prefs.changed("nav-sections"); }
                }
                if Prefs.show-sidebar: SettingSwitch {
                    title: "Panel: muzyka";
                    checked <=> Prefs.nav-music;
                    toggled => { Prefs.changed("nav-sections"); }
                }
                if Prefs.show-sidebar: SettingSwitch {
                    title: "Panel: wideo";
                    checked <=> Prefs.nav-video;
                    toggled => { Prefs.changed("nav-sections"); }
                }
                if Prefs.show-sidebar: SettingSwitch {
                    title: "Panel: zbiory";
                    checked <=> Prefs.nav-sets;
                    toggled => { Prefs.changed("nav-sections"); }
                }
                if Prefs.show-sidebar: SettingSwitch {
                    title: "Panel: inteligentne listy";
                    checked <=> Prefs.nav-smart;
                    toggled => { Prefs.changed("nav-sections"); }
                }
                if Prefs.show-sidebar: SettingSwitch {
                    title: "Panel: foldery";
                    checked <=> Prefs.nav-folders;
                    toggled => { Prefs.changed("nav-sections"); }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: "LISTY UTWORÓW";
                }
                SettingRow {
                    title: "Widok utworów";
                    hint: Prefs.track-grid ? "Okładki " + round(Prefs.grid-size) + " px – ten sam suwak jest nad listą" : "Lista – przesuń w prawo, by pokazać okładki";
                    HSlider {
                        width: 180px;
                        minimum: 90;
                        maximum: 280;
                        step: 10;
                        value: Prefs.view-size;
                        moved(v) => { Prefs.set-view(v); }
                        reset => { Prefs.set-view(160); }
                    }
                }
                SettingSwitch {
                    title: "Grupuj listę według albumów";
                    hint: "Nagłówki z okładką nad każdym albumem";
                    checked <=> Prefs.group-albums;
                    toggled => { Prefs.changed("group-albums"); }
                }
                SettingSwitch {
                    title: "Przewijaj długie tytuły";
                    checked <=> Prefs.scroll-title;
                    toggled => { Prefs.changed("scroll-title"); }
                }
                SettingSwitch {
                    title: "Pokazuj czas pozostały";
                    checked <=> Prefs.remaining;
                    toggled => { Prefs.changed("remaining"); }
                }
            }
            if Ui.settings-page == 2: Page {
                heading: "Wizualizacja";
                SectionTitle {
                    text: "ANALIZATOR";
                }
                SettingRow {
                    title: "Liczba słupków analizatora";
                    hint: Prefs.viz-bands + "";
                    HSlider {
                        width: 180px;
                        minimum: 16;
                        maximum: 96;
                        step: 4;
                        value: Prefs.viz-bands;
                        moved(v) => {
                            Prefs.viz-bands = v;
                            Prefs.changed("viz-bands");
                        }
                    }
                }
                SettingRow {
                    title: "Czułość analizatora";
                    HSlider {
                        width: 180px;
                        minimum: -12;
                        maximum: 12;
                        step: 1;
                        centered: true;
                        value: Prefs.viz-sensitivity;
                        moved(v) => {
                            Prefs.viz-sensitivity = v;
                            Prefs.changed("viz-sensitivity");
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: "TAŚMA UTWORU";
                }
                SettingSwitch {
                    title: "Fala utworu na pasku przewijania";
                    checked <=> Prefs.show-waveform;
                    toggled => { Prefs.changed("show-waveform"); }
                }
                if Prefs.show-waveform: SettingRow {
                    title: "Styl taśmy utworu";
                    ComboBox {
                        width: 200px;
                        model: ["Fala", "Słupki", "Od dołu", "Kontur", "Gęste słupki", "Lustro", "Diody", "Słupki 3D", "Fala 3D", "Linia", "Kropki"];
                        current-index: Prefs.wave-style;
                        selected => {
                            Prefs.wave-style = self.current-index;
                            Prefs.changed("wave-style");
                        }
                    }
                }
                if Prefs.show-waveform: SettingRow {
                    title: "Efekt przy znaczniku";
                    hint: "Część taśmy wokół miejsca odtwarzania porusza się z muzyką";
                    ComboBox {
                        width: 200px;
                        model: ["Wyłączony", "Puls taśmy", "Słupki widma", "Fala widma", "Kropki szczytów", "Obwiednia", "Fala uderzeniowa"];
                        current-index: Prefs.live-style;
                        selected => {
                            Prefs.live-style = self.current-index;
                            Prefs.changed("live-style");
                        }
                    }
                }
                if Prefs.show-waveform && Prefs.live-style > 0: SettingRow {
                    title: "Zasięg efektu";
                    Segmented {
                        options: ["Wąski", "Średni", "Szeroki"];
                        selected: Prefs.live-span;
                        changed(i) => {
                            Prefs.live-span = i;
                            Prefs.changed("live-span");
                        }
                    }
                }
                if Prefs.show-waveform: SettingSwitch {
                    title: "Poświata przy znaczniku";
                    checked <=> Prefs.live-glow;
                    toggled => { Prefs.changed("live-glow"); }
                }
            }
            if Ui.settings-page == 3: Page {
                heading: "Odtwarzanie";
                SettingSwitch {
                    title: "Wznów po uruchomieniu";
                    hint: "Ostatni utwór od miejsca, w którym skończyłeś";
                    checked <=> Prefs.resume-on-start;
                    toggled => { Prefs.changed("resume-on-start"); }
                }
                SettingSwitch {
                    title: "Podążaj za odtwarzanym utworem";
                    hint: "Lista przewija się do bieżącego utworu";
                    checked <=> Prefs.follow-playing;
                    toggled => { Prefs.changed("follow-playing"); }
                }
                SettingRow {
                    title: "Krok przewijania strzałkami";
                    hint: round(Prefs.seek-step) + " s";
                    HSlider {
                        width: 180px;
                        minimum: 2;
                        maximum: 30;
                        step: 1;
                        value: Prefs.seek-step;
                        moved(v) => {
                            Prefs.seek-step = v;
                            Prefs.changed("seek-step");
                        }
                    }
                }
                SettingRow {
                    title: "Przenikanie utworów";
                    hint: Prefs.crossfade > 0 ? round(Prefs.crossfade * 10) / 10 + " s" : "Wyłączone – przejścia bez przerwy (gapless)";
                    HSlider {
                        width: 180px;
                        minimum: 0;
                        maximum: 12;
                        step: 0.5;
                        value: Prefs.crossfade;
                        moved(v) => {
                            Prefs.crossfade = v;
                            Prefs.changed("crossfade");
                        }
                    }
                }
                SettingSwitch {
                    title: "Płynna pauza";
                    hint: "Krótkie wyciszanie przy pauzie i wznowieniu";
                    checked <=> Prefs.soft-pause;
                    toggled => { Prefs.changed("soft-pause"); }
                }
            }
            if Ui.settings-page == 4: Page {
                heading: "Dźwięk";
                SettingRow {
                    title: "Urządzenie wyjściowe";
                    ComboBox {
                        width: 280px;
                        model: Prefs.devices;
                        current-index: Prefs.device;
                        selected => {
                            Prefs.device = self.current-index;
                            Prefs.changed("device");
                        }
                    }
                }
                SettingSwitch {
                    title: "Tryb wyłączny (WASAPI Exclusive)";
                    hint: "Karta gra w częstotliwości pliku, z pominięciem miksera Windows – inne programy nie zagrają w tym czasie";
                    checked <=> Prefs.exclusive;
                    toggled => { Prefs.changed("exclusive"); }
                }
                SettingRow {
                    title: "Jakość przepróbkowania";
                    hint: "Gdy plik ma inną częstotliwość niż karta (od następnego utworu)";
                    Segmented {
                        options: ["Szybka", "Dobra", "Najlepsza"];
                        selected <=> Prefs.resample-quality;
                        changed => { Prefs.changed("resample-quality"); }
                    }
                }
                SettingRow {
                    title: "ReplayGain";
                    hint: "Wyrównuje głośność utworów – z tagów, a pliki bez tagów mierzy sam (EBU R128)";
                    Segmented {
                        options: ["Wyłączone", "Utwór", "Album"];
                        selected <=> Prefs.replaygain;
                        changed => { Prefs.changed("replaygain"); }
                    }
                }
                SettingRow {
                    title: "Wzmocnienie ReplayGain";
                    hint: (Prefs.rg-preamp > 0 ? "+" : "") + round(Prefs.rg-preamp) + " dB";
                    HSlider {
                        width: 180px;
                        minimum: -12;
                        maximum: 12;
                        step: 0.5;
                        centered: true;
                        value: Prefs.rg-preamp;
                        moved(v) => {
                            Prefs.rg-preamp = v;
                            Prefs.changed("rg-preamp");
                        }
                    }
                }
                SettingSwitch {
                    title: "Ogranicznik";
                    hint: "Zapobiega przesterowaniu przy podbitym korektorze";
                    checked <=> Prefs.limiter;
                    toggled => { Prefs.changed("limiter"); }
                }
                SettingRow {
                    title: "Korektor i efekty";
                    hint: "18 pasm, gotowe ustawienia, balans, szerokość stereo, przesłuch";
                    Btn {
                        text: "Otwórz korektor";
                        icon: Icons.equalizer;
                        clicked => {
                            Ui.settings = false;
                            Ui.equalizer = true;
                        }
                    }
                }
            }
            if Ui.settings-page == 5: Page {
                heading: "Wideo";
                SectionTitle {
                    text: "WIDOK FILMU";
                }
                SettingSwitch {
                    title: "Otwieraj filmy w widoku filmu";
                    hint: "Wyłączone – film zaczyna grać w miejscu okładki, a widok filmu otwiera się kliknięciem";
                    checked <=> Prefs.video-open-view;
                    toggled => { Prefs.changed("video-open-view"); }
                }
                SettingRow {
                    title: "Wyjście z widoku filmu (Esc)";
                    hint: "Co dzieje się z filmem, gdy wracasz do biblioteki";
                    ComboBox {
                        width: 240px;
                        model: ["Obraz gra dalej w oknie", "Gra tylko dźwięk", "Pauza"];
                        current-index: Prefs.video-leave;
                        selected => {
                            Prefs.video-leave = self.current-index;
                            Prefs.changed("video-leave");
                        }
                    }
                }
                SettingSwitch {
                    title: "Chowaj sterowanie także w oknie";
                    hint: "Na pełnym ekranie sterowanie i kursor znikają zawsze";
                    checked <=> Prefs.autohide-window;
                    toggled => { Prefs.changed("autohide-window"); }
                }
                SettingRow {
                    title: "Ukrywanie sterowania";
                    hint: "Po " + round(Prefs.autohide-ms / 100) / 10 + " s bez ruchu myszy";
                    HSlider {
                        width: 180px;
                        minimum: 1000;
                        maximum: 8000;
                        step: 250;
                        value: Prefs.autohide-ms;
                        moved(v) => {
                            Prefs.autohide-ms = v;
                            Prefs.changed("autohide-ms");
                        }
                    }
                }
                SettingRow {
                    title: "Poświata z obrazu";
                    hint: "Miękkie światło w barwach filmu wokół obrazu i w pasach po bokach";
                    Segmented {
                        options: ["Wyłączona", "Delikatna", "Mocna"];
                        selected: Prefs.ambient;
                        changed(i) => {
                            Prefs.ambient = i;
                            Prefs.changed("ambient");
                        }
                    }
                }
                SettingSwitch {
                    title: "Kolor przewodni z obrazu";
                    hint: "Akcent programu płynnie podąża za barwami filmu";
                    checked <=> Prefs.video-tint;
                    toggled => { Prefs.changed("video-tint"); }
                }
                if Prefs.video-tint: SettingRow {
                    title: "Jak często brać kolor z obrazu";
                    hint: "Częściej – kolor szybciej nadąża za sceną, rzadziej – spokojniej i lżej dla karty";
                    Segmented {
                        options: ["0,5 s", "1,2 s", "3 s", "8 s"];
                        selected: Prefs.tint-rate;
                        changed(i) => {
                            Prefs.tint-rate = i;
                            Prefs.changed("tint-rate");
                        }
                    }
                }
                SettingSwitch {
                    title: "Podgląd klatek nad paskiem przewijania";
                    hint: "Miniatura miejsca pod kursorem (pliki na dysku)";
                    checked <=> Prefs.seek-preview;
                    toggled => { Prefs.changed("seek-preview"); }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: "OBRAZ";
                }
                SettingRow {
                    title: "Jakość obrazu";
                    hint: ["Skalowanie dwuliniowe – najlżejsze dla słabych komputerów", "Spline36 i poprawne zmniejszanie – dobry obraz bez obciążenia", "EWA Lanczos i pomiar jasności HDR – ostrzejszy obraz", "Najostrzejsze skalowanie – dla mocnych kart graficznych"][Prefs.video-quality];
                    Segmented {
                        options: ["Szybka", "Zrównoważona", "Wysoka", "Najwyższa"];
                        selected: Prefs.video-quality;
                        changed(i) => {
                            Prefs.video-quality = i;
                            Prefs.changed("video-quality");
                        }
                    }
                }
                SettingRow {
                    title: "Dekodowanie sprzętowe";
                    hint: "Karta graficzna dekoduje obraz – mniej obciążenia procesora";
                    ComboBox {
                        width: 240px;
                        model: ["Wyłączone", "Automatyczne (zalecane)", "Automatyczne z kopiowaniem", "D3D11 (kopiowanie)", "NVIDIA NVDEC (kopiowanie)", "DXVA2 (kopiowanie)"];
                        current-index: Prefs.hwdec-mode;
                        selected => {
                            Prefs.hwdec-mode = self.current-index;
                            Prefs.changed("hwdec-mode");
                        }
                    }
                }
                SettingSwitch {
                    title: "Płynny ruch (interpolacja klatek)";
                    hint: "Dopasowuje film do odświeżania ekranu – bez szarpania przy 24 kl./s na 60 Hz";
                    checked <=> Prefs.interpolation;
                    toggled => { Prefs.changed("interpolation"); }
                }
                SettingSwitch {
                    title: "Usuwanie pasm";
                    hint: "Gładkie gradienty nieba i cieni w mocno skompresowanych plikach";
                    checked <=> Prefs.deband;
                    toggled => { Prefs.changed("deband"); }
                }
                SettingRow {
                    title: "Mapowanie tonów HDR";
                    hint: "Jak filmy HDR trafiają na zwykły ekran";
                    ComboBox {
                        width: 200px;
                        model: ["Automatyczne", "BT.2390", "Hable (filmowe)", "Mobius", "Reinhard", "Obcięcie"];
                        current-index: Prefs.tone-mapping;
                        selected => {
                            Prefs.tone-mapping = self.current-index;
                            Prefs.changed("tone-mapping");
                        }
                    }
                }
                SettingSwitch {
                    title: "Usuwanie przeplotu";
                    checked <=> Prefs.deinterlace;
                    toggled => { Prefs.changed("deinterlace"); }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: "STEROWANIE";
                }
                SettingRow {
                    title: "Kółko myszy nad obrazem";
                    hint: "Z Ctrl – powiększenie obrazu";
                    Segmented {
                        options: ["Głośność", "Przewijanie"];
                        selected: Prefs.wheel-action;
                        changed(i) => {
                            Prefs.wheel-action = i;
                            Prefs.changed("wheel-action");
                        }
                    }
                }
                SettingSwitch {
                    title: "Dwuklik przy krawędzi przewija o 10 s";
                    hint: "Lewa ćwiartka – wstecz, prawa – naprzód; na środku – pełny ekran";
                    checked <=> Prefs.dblclick-seek;
                    toggled => { Prefs.changed("dblclick-seek"); }
                }
                SettingSwitch {
                    title: "Wznawiaj filmy";
                    hint: "Film zaczyna się tam, gdzie go przerwałeś";
                    checked <=> Prefs.video-resume;
                    toggled => { Prefs.changed("video-resume"); }
                }
                SettingSwitch {
                    title: "Po filmie następny plik z listy";
                    checked <=> Prefs.video-autonext;
                    toggled => { Prefs.changed("video-autonext"); }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: "DŹWIĘK FILMÓW";
                }
                SettingRow {
                    title: "Wzmocnienie głośności";
                    hint: round(Prefs.volume-boost) + "% przy pełnej głośności – dla cichych filmów";
                    HSlider {
                        width: 180px;
                        minimum: 100;
                        maximum: 200;
                        step: 5;
                        value: Prefs.volume-boost;
                        moved(v) => {
                            Prefs.volume-boost = v;
                            Prefs.changed("volume-boost");
                        }
                        reset => {
                            Prefs.volume-boost = 100;
                            Prefs.changed("volume-boost");
                        }
                    }
                }
                SettingSwitch {
                    title: "Tryb nocny";
                    hint: "Wyrównana dynamika: słychać dialogi, wybuchy nie budzą domowników";
                    checked <=> Prefs.night-mode;
                    toggled => { Prefs.changed("night-mode"); }
                }
                SettingSwitch {
                    title: "Miks dźwięku przestrzennego do stereo";
                    hint: "Dla słuchawek i głośników stereo – dialogi z kanału centralnego nie giną";
                    checked <=> Prefs.downmix;
                    toggled => { Prefs.changed("downmix"); }
                }
                SettingRow {
                    title: "Preferowane języki dźwięku";
                    hint: "Kody oddzielone przecinkami, np. pol,eng";
                    LineEdit {
                        width: 180px;
                        text <=> Prefs.audio-lang;
                        edited => { Prefs.changed("audio-lang"); }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: "SIEĆ";
                }
                SettingSwitch {
                    title: "Filmy z serwisów wideo (yt-dlp)";
                    hint: "Linki do YouTube i innych serwisów – program sam pobiera i odświeża yt-dlp";
                    checked <=> Prefs.ytdl;
                    toggled => { Prefs.changed("ytdl"); }
                }
                SettingRow {
                    title: "Jakość filmów z sieci";
                    ComboBox {
                        width: 180px;
                        model: ["Najlepsza", "Do 1080p", "Do 720p", "Do 480p"];
                        current-index: Prefs.ytdl-format;
                        selected => {
                            Prefs.ytdl-format = self.current-index;
                            Prefs.changed("ytdl-format");
                        }
                    }
                }
                SettingRow {
                    title: "Bufor strumieni";
                    hint: Prefs.cache-mb + " MB pamięci na zapas filmu z sieci";
                    HSlider {
                        width: 180px;
                        minimum: 32;
                        maximum: 1024;
                        step: 32;
                        value: Prefs.cache-mb;
                        moved(v) => {
                            Prefs.cache-mb = v;
                            Prefs.changed("cache-mb");
                        }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SettingRow {
                    title: "Folder zrzutów ekranu";
                    hint: Prefs.screenshot-dir;
                    Btn {
                        text: "Zmień…";
                        clicked => { Prefs.pick-screenshot-dir(); }
                    }
                }
                SettingRow {
                    title: "Silnik wideo";
                    hint: Prefs.mpv-info;
                    Text {
                        text: Prefs.mpv-ok ? "gotowy" : "niedostępny";
                        color: Prefs.mpv-ok ? Theme.ok : Theme.danger;
                        font-size: Theme.fs;
                    }
                }
            }
            if Ui.settings-page == 6: Page {
                heading: "Napisy";
                SettingRow {
                    title: "Wielkość napisów";
                    hint: Prefs.sub-size + "";
                    HSlider {
                        width: 180px;
                        minimum: 24;
                        maximum: 90;
                        step: 1;
                        value: Prefs.sub-size;
                        moved(v) => {
                            Prefs.sub-size = v;
                            Prefs.changed("sub-size");
                        }
                    }
                }
                SettingRow {
                    title: "Czcionka";
                    hint: "Nazwa czcionki zainstalowanej w Windows";
                    LineEdit {
                        width: 200px;
                        text <=> Prefs.sub-font;
                        edited => { Prefs.changed("sub-font"); }
                    }
                }
                SettingRow {
                    title: "Kolor";
                    HorizontalLayout {
                        spacing: 6px;
                        for c[i] in [#ffffff, #ffe14d, #86e1ff, #a6ffa0]: Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: c;
                            border-width: Prefs.sub-color == i ? 2px : 1px;
                            border-color: Prefs.sub-color == i ? Theme.tint : Theme.line2;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Prefs.sub-color = i;
                                    Prefs.changed("sub-color");
                                }
                            }
                        }
                    }
                }
                SettingRow {
                    title: "Styl";
                    hint: ["Czarny obrys – czytelne na każdym tle", "Miękki cień", "Półprzezroczyste pole pod tekstem"][Prefs.sub-style];
                    Segmented {
                        options: ["Obrys", "Cień", "Pole"];
                        selected: Prefs.sub-style;
                        changed(i) => {
                            Prefs.sub-style = i;
                            Prefs.changed("sub-style");
                        }
                    }
                }
                SettingRow {
                    title: "Położenie";
                    hint: Prefs.sub-pos >= 100 ? "Przy dolnej krawędzi obrazu" : "Wyżej o " + (100 - Prefs.sub-pos) + "% wysokości";
                    HSlider {
                        width: 180px;
                        minimum: 40;
                        maximum: 110;
                        step: 1;
                        value: Prefs.sub-pos;
                        moved(v) => {
                            Prefs.sub-pos = v;
                            Prefs.changed("sub-pos");
                        }
                        reset => {
                            Prefs.sub-pos = 100;
                            Prefs.changed("sub-pos");
                        }
                    }
                }
                SettingSwitch {
                    title: "Pogrubione";
                    checked <=> Prefs.sub-bold;
                    toggled => { Prefs.changed("sub-bold"); }
                }
                SettingSwitch {
                    title: "Własny styl także dla napisów ASS";
                    hint: "Napisy ze stylami (anime, karaoke) dostają czcionkę i kolor z ustawień";
                    checked <=> Prefs.sub-override;
                    toggled => { Prefs.changed("sub-override"); }
                }
                SettingRow {
                    title: "Napisy z folderu filmu";
                    hint: "Które pliki napisów obok filmu wczytywać same";
                    ComboBox {
                        width: 200px;
                        model: ["Nie wczytuj", "Ta sama nazwa", "Podobna nazwa", "Wszystkie z folderu"];
                        current-index: Prefs.sub-auto;
                        selected => {
                            Prefs.sub-auto = self.current-index;
                            Prefs.changed("sub-auto");
                        }
                    }
                }
                SettingRow {
                    title: "Preferowane języki napisów";
                    hint: "Kody oddzielone przecinkami, np. pol,eng";
                    LineEdit {
                        width: 180px;
                        text <=> Prefs.sub-lang;
                        edited => { Prefs.changed("sub-lang"); }
                    }
                }
            }
            if Ui.settings-page == 7: Page {
                heading: "Biblioteka";
                FolderList {
                    kind: 0;
                    title: "MUZYKA";
                    hint: "Foldery z muzyką – wykonawcy, albumy, gatunki, lata i foldery.";
                    folders: Prefs.folders;
                }
                Rectangle {
                    height: 18px;
                }
                FolderList {
                    kind: 1;
                    title: "WIDEO";
                    hint: "Foldery z filmami i serialami – wszystkie filmy, foldery, kontynuowanie oglądania.";
                    folders: Prefs.video-folders;
                }
                Rectangle {
                    height: 18px;
                }
                Text {
                    text: "Dyski sieciowe: dodaj folder na dysku zmapowanym (np. Z:\\Muzyka) albo ścieżkę udziału (\\\\NAS\\Muzyka). Gdy serwer jest wyłączony, biblioteka zachowuje jego pliki i odświeży je przy następnym skanowaniu.";
                    color: Theme.text3;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 10px;
                }
                HorizontalLayout {
                    alignment: start;
                    Btn {
                        text: "Skanuj bibliotekę teraz";
                        icon: Icons.refresh;
                        clicked => { Prefs.changed("rescan"); }
                    }
                }
                Rectangle {
                    height: 10px;
                }
                SectionTitle {
                    text: "INTERNET";
                }
                SettingSwitch {
                    title: "Pobieraj brakujące teksty z LRCLIB";
                    hint: "Wysyła tylko wykonawcę, tytuł, album i czas trwania";
                    checked <=> Prefs.online-lyrics;
                    toggled => { Prefs.changed("online-lyrics"); }
                }
                SettingSwitch {
                    title: "Pobieraj brakujące okładki";
                    hint: "Z MusicBrainz i Cover Art Archive – wysyła tylko wykonawcę i album";
                    checked <=> Prefs.online-covers;
                    toggled => { Prefs.changed("online-covers"); }
                }
                SettingRow {
                    title: "Klucz API TMDB";
                    hint: "Polskie plakaty, opisy, gatunki i oceny filmów – darmowy klucz z themoviedb.org (Ustawienia → API)";
                    LineEdit {
                        width: 220px;
                        input-type: password;
                        text <=> Prefs.tmdb-key;
                        edited => { Prefs.changed("tmdb-key"); }
                    }
                }
                SettingRow {
                    title: "Klucz API OpenSubtitles";
                    hint: "Pobieranie polskich napisów jednym kliknięciem – klucz z opensubtitles.com (Konto → API)";
                    LineEdit {
                        width: 220px;
                        input-type: password;
                        text <=> Prefs.os-key;
                        edited => { Prefs.changed("os-key"); }
                    }
                }
                SettingRow {
                    title: "Token ListenBrainz";
                    hint: "Scrobbling wysłuchanych utworów – token z listenbrainz.org/settings; puste wyłącza";
                    LineEdit {
                        width: 220px;
                        input-type: password;
                        text <=> Prefs.lb-token;
                        edited => { Prefs.changed("lb-token"); }
                    }
                }
            }
            if Ui.settings-page == 8: Page {
                heading: "Skróty klawiszowe";
                for k in Prefs.keys: HorizontalLayout {
                    height: 30px;
                    spacing: 12px;
                    Rectangle {
                        width: 190px;
                        HorizontalLayout {
                            alignment: start;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 22px;
                                width: kt.preferred-width + 14px;
                                border-radius: 5px;
                                background: Theme.panel2;
                                border-width: 1px;
                                border-color: Theme.line2;
                                kt := Text {
                                    text: k.keys;
                                    color: Theme.text;
                                    font-size: Theme.fs-sm;
                                    font-family: Theme.mono;
                                }
                            }
                        }
                    }
                    Text {
                        text: k.action;
                        color: Theme.text2;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }
                }
            }
            if Ui.settings-page == 9: Page {
                heading: "System";
                SettingSwitch {
                    title: "Jedno okno programu";
                    hint: "Otwierane pliki trafiają do działającego OpenMP";
                    checked <=> Prefs.single-instance;
                    toggled => { Prefs.changed("single-instance"); }
                }
                SettingSwitch {
                    title: "Klawisze multimedialne i panel Windows";
                    hint: "Sterowanie z klawiatury, słuchawek i nakładki głośności";
                    checked <=> Prefs.media-keys;
                    toggled => { Prefs.changed("media-keys"); }
                }
                SettingSwitch {
                    title: "Globalne skróty klawiszowe";
                    hint: "Ctrl+Alt+Spacja – odtwórz/pauza, Ctrl+Alt+←/→ – utwór, Ctrl+Alt+↑/↓ – głośność; także gdy okno jest w tle";
                    checked <=> Prefs.global-hotkeys;
                    toggled => { Prefs.changed("global-hotkeys"); }
                }
                SettingSwitch {
                    title: "Nie usypiaj komputera podczas filmu";
                    checked <=> Prefs.prevent-sleep;
                    toggled => { Prefs.changed("prevent-sleep"); }
                }
                SettingRow {
                    title: "Skojarzenia plików";
                    hint: "Ustaw OpenMP jako domyślny odtwarzacz w ustawieniach Windows";
                    Btn {
                        text: "Aplikacje domyślne…";
                        clicked => { Prefs.associate(); }
                    }
                }
                SettingSwitch {
                    title: "Sprawdzaj aktualizacje";
                    hint: "Przy uruchomieniu, przez redzikowski.com";
                    checked <=> Prefs.check-updates;
                    toggled => { Prefs.changed("check-updates"); }
                }
                SettingRow {
                    title: "Wersja " + Prefs.version;
                    Btn {
                        text: "Sprawdź teraz";
                        icon: Icons.refresh;
                        clicked => { Prefs.check-update(); }
                    }
                }
            }
            if Ui.settings-page == 10: Page {
                heading: "O programie";
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    Image {
                        source: @image-url("../icon.png");
                        width: 64px;
                        height: 64px;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: "OpenMP";
                            color: Theme.text;
                            font-size: 24px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Open Media Player · wersja " + Prefs.version;
                            color: Theme.text3;
                            font-size: Theme.fs;
                        }
                    }
                }
                Rectangle {
                    height: 14px;
                }
                Text {
                    text: "Odtwarzacz muzyki i wideo dla Windows: własny silnik dźwięku z przejściami bez przerwy, przenikaniem, 18-pasmowym korektorem i ReplayGain, biblioteka muzyki, radio internetowe, teksty piosenek oraz odtwarzanie filmów z napisami i dekodowaniem sprzętowym (mpv).";
                    color: Theme.text2;
                    font-size: Theme.fs;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 16px;
                }
                AuthorCard { }
                Rectangle {
                    height: 16px;
                }
                Text {
                    text: "Wykorzystuje: Slint, Symphonia, cpal, rubato, RustFFT, lofty, libmpv i FFmpeg.";
                    color: Theme.text3;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component AboutDialog inherits Dialog {
    title: "O programie";
    card-width: 520px;
    close => { Ui.about = false; }
    VerticalLayout {
        padding: 22px;
        padding-top: 4px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            Image {
                source: @image-url("../icon.png");
                width: 64px;
                height: 64px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text {
                    text: "OpenMP";
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 700;
                }
                Text {
                    text: "Open Media Player · wersja " + Prefs.version;
                    color: Theme.text3;
                    font-size: Theme.fs;
                }
            }
        }
        Text {
            text: "Odtwarzacz muzyki i wideo dla Windows – rozbudowany wyświetlacz w trybie muzyki i minimalistyczny, chowający się interfejs w trybie wideo.";
            color: Theme.text2;
            font-size: Theme.fs;
            wrap: word-wrap;
        }
        AuthorCard { }
    }
}

export component UrlDialog inherits Dialog {
    title: "Otwórz adres";
    card-width: 560px;
    close => { Ui.url-dialog = false; }
    VerticalLayout {
        padding: 20px;
        padding-top: 4px;
        spacing: 12px;
        Text {
            text: "Strumień radia, plik w sieci albo lista odtwarzania (http, https, rtsp, m3u8). Działają też linki do YouTube i innych serwisów wideo.";
            color: Theme.text3;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
        f := Field {
            text <=> Ui.url-text;
            placeholder: "https://…";
            icon: Icons.link;
            accepted(t) => { Ui.url-accepted(t); }
            escape => { Ui.url-dialog = false; }
            init => { self.focus-input(); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                text: "Anuluj";
                clicked => { Ui.url-dialog = false; }
            }
            Btn {
                text: "Odtwórz";
                primary: true;
                enabled: Ui.url-text != "";
                clicked => { Ui.url-accepted(Ui.url-text); }
            }
        }
    }
}

export component RenameDialog inherits Dialog {
    title: Ui.rename-title;
    card-width: 420px;
    close => { Ui.rename-dialog = false; }
    VerticalLayout {
        padding: 20px;
        padding-top: 4px;
        spacing: 12px;
        Field {
            text <=> Ui.rename-text;
            clearable: false;
            accepted(t) => { Ui.rename-accepted(t); }
            escape => { Ui.rename-dialog = false; }
            init => { self.focus-input(); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                text: "Anuluj";
                clicked => { Ui.rename-dialog = false; }
            }
            Btn {
                text: "Zapisz";
                primary: true;
                enabled: Ui.rename-text != "";
                clicked => { Ui.rename-accepted(Ui.rename-text); }
            }
        }
    }
}

export component TagEditor inherits Dialog {
    title: "Edycja tagów";
    card-width: 680px;
    close => { Ui.tag-editor = false; }
    in-out property <[string]> v: Ui.tag-values;
    VerticalLayout {
        padding: 20px;
        padding-top: 0px;
        spacing: 12px;
        Text {
            text: Ui.tag-title;
            color: Theme.text3;
            font-size: Theme.fs-sm;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 18px;
            VerticalLayout {
                spacing: 8px;
                width: 150px;
                Cover {
                    width: 150px;
                    height: 150px;
                    source: Ui.tag-cover;
                    has: Ui.tag-has-cover;
                }
                Btn {
                    text: "Zmień okładkę…";
                    compact: true;
                    clicked => { Ui.tag-pick-cover(); }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                for f[i] in ["Tytuł", "Wykonawca", "Album", "Wykonawca albumu", "Gatunek", "Rok", "Nr utworu", "Nr płyty", "Kompozytor", "Komentarz"]: HorizontalLayout {
                    spacing: 10px;
                    Text {
                        width: 130px;
                        text: f;
                        color: Theme.text2;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        height: 30px;
                        text: root.v[i];
                        placeholder-text: Ui.tag-mixed[i] ? "(różne wartości – bez zmian)" : "";
                        edited(t) => { root.v[i] = t; }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                text: "Anuluj";
                clicked => { Ui.tag-editor = false; }
            }
            Btn {
                text: Ui.tag-busy ? "Zapisywanie…" : "Zapisz";
                primary: true;
                enabled: !Ui.tag-busy;
                clicked => { Ui.tag-save(root.v); }
            }
        }
    }
}

export component UpdateDialog inherits Dialog {
    title: "Dostępna aktualizacja";
    card-width: 520px;
    close => { Ui.update-dialog = false; }
    VerticalLayout {
        padding: 20px;
        padding-top: 4px;
        spacing: 12px;
        Text {
            text: "OpenMP " + Ui.update-version + " jest gotowy do pobrania (masz " + Prefs.version + ").";
            color: Theme.text;
            font-size: Theme.fs;
            wrap: word-wrap;
        }
        if Ui.update-notes != "": Rectangle {
            height: min(180px, nt.preferred-height + 20px);
            border-radius: Theme.radius;
            background: Theme.panel2;
            ScrollView {
                nt := Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: Ui.update-notes;
                    color: Theme.text2;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
            }
        }
        if Ui.update-progress >= 0: Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.hover;
            Rectangle {
                x: 0;
                width: parent.width * Ui.update-progress;
                border-radius: 3px;
                background: Theme.tint;
            }
        }
        if Ui.update-status != "": Text {
            text: Ui.update-status;
            color: Theme.text3;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                text: "Pomiń tę wersję";
                clicked => { Ui.update-skip(); }
            }
            Btn {
                text: Ui.update-portable ? "Otwórz stronę pobierania" : "Zainstaluj i uruchom ponownie";
                primary: true;
                enabled: Ui.update-progress < 0;
                clicked => { Ui.update-install(); }
            }
        }
    }
}
