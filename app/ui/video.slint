// Widok filmu w dwóch odsłonach: kinowej (obraz na całe okno, sterowanie chowa się po chwili)
// i szerokiej (obraz z panelem listy i ustawień, sterowanie jak w oknie muzyki). Na pełnym ekranie
// zawsze kinowy z autoukrywaniem. Ten sam panel: lista, dźwięk, napisy, obraz, rozdziały, szczegóły.
// Miniodtwarzacz: pasek muzyki albo obraz w obrazie z przyciskami po najechaniu.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconBtn, HSlider, Segmented, Cover, Marquee, Btn, Switch } from "widgets.slint";
import { SeekBar, Fmt, Visualizer } from "display.slint";
import { CoverArt, PlayRing } from "nowplaying.slint";
import { WinButtons } from "views.slint";
import { VideoStage } from "surface.slint";
import { Player, Video, Ui, Prefs, Lists } from "state.slint";
import { Opt } from "types.slint";

component Pill inherits Rectangle {
    background: #0c0e12d9;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.scope >= 1 ? Theme.tint.with-alpha(0.22) : #ffffff14;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000080;
}

// Barwy panelu: w szerokim widoku z motywu, na obrazie – jasne.
global VInk {
    pure public function fg(t: bool) -> color {
        return t ? Theme.text : #ffffff;
    }
    pure public function fg2(t: bool) -> color {
        return t ? Theme.text2 : #ffffffb0;
    }
    pure public function fg3(t: bool) -> color {
        return t ? Theme.text3 : #ffffff80;
    }
    pure public function sel(t: bool) -> color {
        return t ? Theme.sel : #ffffff1f;
    }
    pure public function hov(t: bool) -> color {
        return t ? Theme.hover : #ffffff12;
    }
    pure public function track(t: bool) -> color {
        return t ? (Theme.dark ? #ffffff1f : #0000001a) : #ffffff33;
    }
    pure public function fill(t: bool) -> color {
        return t || Theme.scope >= 1 ? Theme.tint : #ffffff;
    }
}

component OptList inherits VerticalLayout {
    in property <[Opt]> items;
    in property <string> empty;
    in property <bool> themed;
    callback picked(string);
    spacing: 2px;
    if root.items.length == 0: Text {
        text: root.empty;
        color: VInk.fg3(root.themed);
        font-size: Theme.fs-sm;
    }
    for o in root.items: Rectangle {
        height: o.sub != "" ? 40px : 30px;
        border-radius: 7px;
        background: o.selected ? VInk.sel(root.themed) : ota.has-hover ? VInk.hov(root.themed) : transparent;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            Rectangle {
                width: 14px;
                if o.selected: Icon {
                    icon: Icons.check;
                    size: 14px;
                    fill: Theme.tint-hi;
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: o.label;
                    color: VInk.fg(root.themed);
                    font-size: Theme.fs;
                    overflow: elide;
                }
                if o.sub != "": Text {
                    text: o.sub;
                    color: VInk.fg3(root.themed);
                    font-size: Theme.fs-xs;
                    overflow: elide;
                }
            }
        }
        ota := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(o.id); }
        }
    }
}

component VRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <bool> themed;
    spacing: 10px;
    height: 30px;
    Text {
        width: 104px;
        text: root.label;
        color: VInk.fg2(root.themed);
        font-size: Theme.fs-sm;
        vertical-alignment: center;
    }
    @children
    Text {
        width: 56px;
        text: root.value-text;
        color: VInk.fg(root.themed);
        font-size: Theme.fs-sm;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component VSwitch inherits HorizontalLayout {
    in property <string> label;
    in property <bool> themed;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 30px;
    spacing: 10px;
    Text {
        text: root.label;
        color: VInk.fg2(root.themed);
        font-size: Theme.fs-sm;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Switch {
        y: (parent.height - self.height) / 2;
        checked <=> root.checked;
        toggled(v) => { root.toggled(v); }
    }
}

component Caption inherits Text {
    in property <bool> themed;
    color: themed ? Theme.text3 : #ffffff90;
    font-size: Theme.fs-xs;
    font-weight: 700;
    letter-spacing: 0.6px;
}

// Panel filmu: karty jako ikony, treść karty pod spodem.
component VideoPages inherits VerticalLayout {
    in property <bool> themed;
    in property <bool> wide;
    property <int> pg: !root.wide && Video.panel-page == 5 ? 0 : Video.panel-page;
    spacing: 10px;
    HorizontalLayout {
        spacing: 2px;
        for t in [
            { i: 5, icon: Icons.queue, tip: "Lista" },
            { i: 0, icon: Icons.audiotrack, tip: "Dźwięk i prędkość" },
            { i: 1, icon: Icons.subtitles, tip: "Napisy" },
            { i: 2, icon: Icons.tune, tip: "Obraz" },
            { i: 3, icon: Icons.bookmark, tip: "Rozdziały" },
            { i: 4, icon: Icons.info, tip: "Szczegóły odtwarzania" },
        ]: Rectangle {
            width: t.i != 5 || root.wide ? 36px : 0px;
            height: 34px;
            if t.i != 5 || root.wide: IconBtn {
                icon: t.icon;
                tip: t.tip;
                size: 34px;
                icon-size: 18px;
                active: root.pg == t.i;
                on-dark: !root.themed;
                icon-color: root.pg == t.i ? Theme.tint-hi : VInk.fg2(root.themed);
                hover-color: VInk.fg(root.themed);
                background: root.pg == t.i ? VInk.sel(root.themed) : transparent;
                clicked => {
                    Video.panel-page = t.i;
                    Video.panel-page-changed(t.i);
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: ["Dźwięk", "Napisy", "Obraz", "Rozdziały", "Szczegóły", "Lista"][root.pg];
            color: VInk.fg(root.themed);
            font-size: Theme.fs-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    // Lista bieżąca – kliknięcie odtwarza.
    if root.pg == 5: ListView {
        vertical-stretch: 1;
        for r in Lists.rows: Rectangle {
            height: r.header ? 0px : 46px;
            visible: !r.header;
            border-radius: 8px;
            background: r.playing ? Theme.sel : lta.has-hover ? VInk.hov(root.themed) : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 10px;
                Rectangle {
                    width: 18px;
                    Icon {
                        icon: r.playing ? Icons.play : r.video ? Icons.movie : Icons.note;
                        size: 15px;
                        fill: r.playing ? Theme.tint-hi : VInk.fg3(root.themed);
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: r.title;
                        color: r.playing ? Theme.tint-hi : VInk.fg(root.themed);
                        font-size: Theme.fs;
                        font-weight: r.playing ? 600 : 400;
                        overflow: elide;
                    }
                    Text {
                        text: r.artist;
                        color: VInk.fg3(root.themed);
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                }
                Text {
                    text: r.dur;
                    color: VInk.fg3(root.themed);
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                }
            }
            lta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Lists.row-double(r.idx); }
            }
        }
    }
    if root.pg != 5: Flickable {
        vertical-stretch: 1;
        content-height: inner.preferred-height;
        inner := VerticalLayout {
            spacing: 8px;
            if root.pg == 0: VerticalLayout {
                spacing: 6px;
                Caption {
                    themed: root.themed;
                    text: "ŚCIEŻKA DŹWIĘKOWA";
                }
                OptList {
                    themed: root.themed;
                    items: Video.audio-tracks;
                    empty: "Brak ścieżek dźwiękowych";
                    picked(id) => { Video.select-audio(id); }
                }
                Rectangle {
                    height: 6px;
                }
                Caption {
                    themed: root.themed;
                    text: "PRĘDKOŚĆ";
                }
                HorizontalLayout {
                    spacing: 4px;
                    for s in [0.5, 0.75, 1, 1.25, 1.5, 2]: Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius;
                        background: abs(Video.speed - s) < 0.01 ? Theme.tint.with-alpha(0.3) : sta.has-hover ? VInk.hov(root.themed) : #ffffff08;
                        border-width: 1px;
                        border-color: abs(Video.speed - s) < 0.01 ? Theme.tint : transparent;
                        Text {
                            text: s + "×";
                            color: VInk.fg(root.themed);
                            font-size: Theme.fs-sm;
                        }
                        sta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Video.set-speed(s); }
                        }
                    }
                }
                VRow {
                    themed: root.themed;
                    label: "Dokładnie";
                    value-text: round(Video.speed * 100) / 100 + "×";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: 0.25;
                        maximum: 4;
                        step: 0.05;
                        value: Video.speed;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => { Video.set-speed(v); }
                        reset => { Video.set-speed(1); }
                    }
                }
                VRow {
                    themed: root.themed;
                    label: "Opóźnienie dźwięku";
                    value-text: round(Video.audio-delay * 1000) + " ms";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: -2;
                        maximum: 2;
                        step: 0.05;
                        centered: true;
                        value: Video.audio-delay;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => { Video.set-audio-delay(v); }
                        reset => { Video.set-audio-delay(0); }
                    }
                }
                VRow {
                    themed: root.themed;
                    label: "Wzmocnienie";
                    value-text: round(Prefs.volume-boost) + "%";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: 100;
                        maximum: 200;
                        step: 5;
                        value: Prefs.volume-boost;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => {
                            Prefs.volume-boost = v;
                            Prefs.changed("volume-boost");
                        }
                        reset => {
                            Prefs.volume-boost = 100;
                            Prefs.changed("volume-boost");
                        }
                    }
                }
                VSwitch {
                    themed: root.themed;
                    label: "Tryb nocny (wyrównana dynamika)";
                    checked <=> Prefs.night-mode;
                    toggled => { Prefs.changed("night-mode"); }
                }
                VSwitch {
                    themed: root.themed;
                    label: "Miks do stereo";
                    checked <=> Prefs.downmix;
                    toggled => { Prefs.changed("downmix"); }
                }
            }
            if root.pg == 1: VerticalLayout {
                spacing: 6px;
                OptList {
                    themed: root.themed;
                    items: Video.sub-tracks;
                    empty: "Brak napisów";
                    picked(id) => { Video.select-sub(id); }
                }
                Btn {
                    text: "Wczytaj napisy z pliku…";
                    icon: Icons.file;
                    compact: true;
                    clicked => { Video.load-sub(); }
                }
                Rectangle {
                    height: 4px;
                }
                VRow {
                    themed: root.themed;
                    label: "Opóźnienie";
                    value-text: round(Video.sub-delay * 1000) + " ms";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: -5;
                        maximum: 5;
                        step: 0.1;
                        centered: true;
                        value: Video.sub-delay;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => { Video.set-sub-delay(v); }
                        reset => { Video.set-sub-delay(0); }
                    }
                }
                VRow {
                    themed: root.themed;
                    label: "Wielkość";
                    value-text: round(Video.sub-scale * 100) + "%";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: 0.5;
                        maximum: 2.5;
                        step: 0.05;
                        value: Video.sub-scale;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => { Video.set-sub-scale(v); }
                        reset => { Video.set-sub-scale(1); }
                    }
                }
                VRow {
                    themed: root.themed;
                    label: "Położenie";
                    value-text: Prefs.sub-pos + "";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: 40;
                        maximum: 110;
                        step: 1;
                        value: Prefs.sub-pos;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => {
                            Prefs.sub-pos = v;
                            Prefs.changed("sub-pos");
                        }
                        reset => {
                            Prefs.sub-pos = 100;
                            Prefs.changed("sub-pos");
                        }
                    }
                }
                Caption {
                    themed: root.themed;
                    text: "STYL";
                }
                Segmented {
                    small: true;
                    options: ["Obrys", "Cień", "Pole"];
                    selected: Prefs.sub-style;
                    changed(i) => {
                        Prefs.sub-style = i;
                        Prefs.changed("sub-style");
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    padding-top: 4px;
                    for c[i] in [#ffffff, #ffe14d, #86e1ff, #a6ffa0]: Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: c;
                        border-width: Prefs.sub-color == i ? 2px : 1px;
                        border-color: Prefs.sub-color == i ? Theme.tint : #00000040;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Prefs.sub-color = i;
                                Prefs.changed("sub-color");
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                VSwitch {
                    themed: root.themed;
                    label: "Pogrubione";
                    checked <=> Prefs.sub-bold;
                    toggled => { Prefs.changed("sub-bold"); }
                }
                VSwitch {
                    themed: root.themed;
                    label: "Własny styl także dla napisów ASS";
                    checked <=> Prefs.sub-override;
                    toggled => { Prefs.changed("sub-override"); }
                }
            }
            if root.pg == 2: VerticalLayout {
                spacing: 4px;
                for e in [
                    { id: "brightness", l: "Jasność", v: Video.brightness },
                    { id: "contrast", l: "Kontrast", v: Video.contrast },
                    { id: "saturation", l: "Nasycenie", v: Video.saturation },
                    { id: "gamma", l: "Gamma", v: Video.gamma },
                    { id: "hue", l: "Odcień", v: Video.hue },
                ]: VRow {
                    themed: root.themed;
                    label: e.l;
                    value-text: round(e.v);
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: -100;
                        maximum: 100;
                        step: 1;
                        centered: true;
                        value: e.v;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => { Video.set-eq(e.id, v); }
                        reset => { Video.set-eq(e.id, 0); }
                    }
                }
                VRow {
                    themed: root.themed;
                    label: "Powiększenie";
                    value-text: round(pow(2, Video.zoom) * 100) + "%";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: -1;
                        maximum: 2;
                        step: 0.05;
                        centered: true;
                        value: Video.zoom;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => { Video.set-zoom(v); }
                        reset => { Video.set-zoom(0); }
                    }
                }
                Caption {
                    themed: root.themed;
                    text: "PROPORCJE";
                }
                Segmented {
                    small: true;
                    options: ["Auto", "16:9", "4:3", "21:9", "Rozc.", "Wypełnij"];
                    selected: Video.aspect;
                    changed(i) => { Video.set-aspect(i); }
                }
                Caption {
                    themed: root.themed;
                    text: "POŚWIATA Z OBRAZU";
                }
                Segmented {
                    small: true;
                    options: ["Wyłączona", "Delikatna", "Mocna"];
                    selected: Prefs.ambient;
                    changed(i) => {
                        Prefs.ambient = i;
                        Prefs.changed("ambient");
                    }
                }
                VSwitch {
                    themed: root.themed;
                    label: "Usuwanie pasm (gładkie gradienty)";
                    checked <=> Prefs.deband;
                    toggled => { Prefs.changed("deband"); }
                }
                VSwitch {
                    themed: root.themed;
                    label: "Kolor przewodni z obrazu";
                    checked <=> Prefs.video-tint;
                    toggled => { Prefs.changed("video-tint"); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    padding-top: 6px;
                    Btn {
                        text: "Obróć";
                        icon: Icons.refresh;
                        compact: true;
                        clicked => { Video.rotate-view(); }
                    }
                    Btn {
                        text: "Jak w pliku";
                        icon: Icons.aspect;
                        compact: true;
                        clicked => { Video.reset-view(); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Btn {
                        text: "Zrzut ekranu";
                        icon: Icons.camera;
                        compact: true;
                        clicked => { Video.screenshot(); }
                    }
                    Btn {
                        text: "Pętla A-B";
                        icon: Icons.repeat;
                        compact: true;
                        clicked => { Video.ab-loop(); }
                    }
                }
            }
            if root.pg == 3: OptList {
                themed: root.themed;
                items: Video.chapter-list;
                empty: "Ten plik nie ma rozdziałów";
                picked(id) => { Video.goto-chapter(id); }
            }
            if root.pg == 4: VerticalLayout {
                spacing: 2px;
                if Video.stats.length == 0: Text {
                    text: "Szczegóły pojawią się po wczytaniu pliku.";
                    color: VInk.fg3(root.themed);
                    font-size: Theme.fs-sm;
                }
                for s in Video.stats: HorizontalLayout {
                    spacing: 10px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    Text {
                        width: 112px;
                        text: s.label;
                        color: VInk.fg3(root.themed);
                        font-size: Theme.fs-sm;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: s.sub;
                        color: VInk.fg(root.themed);
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// Komunikat na środku (głośność, przewinięcie, prędkość).
component Osd inherits Rectangle {
    width: osdt.preferred-width + 30px;
    height: 38px;
    border-radius: 19px;
    background: #000000b8;
    border-width: 1px;
    border-color: Theme.tint.with-alpha(0.35);
    opacity: Video.osd-visible ? 1 : 0;
    animate opacity { duration: 180ms; }
    osdt := Text {
        text: Video.osd;
        color: #ffffff;
        font-size: Theme.fs-md;
        font-weight: 600;
    }
}

// Obsługa myszy na obrazie: klik – pauza, dwuklik – pełny ekran (przy krawędziach – przewijanie),
// kółko – głośność albo przewijanie (z Ctrl – powiększenie), prawy – menu, środkowy – pełny ekran.
component StageInput inherits TouchArea {
    in property <bool> can-drag: true;
    property <length> px;
    property <length> py;
    property <bool> dragged;
    mouse-cursor: Video.cursor || !Video.playing ? MouseCursor.default : MouseCursor.none;
    moved => {
        Video.mouse-moved();
        if self.pressed && root.can-drag && !root.dragged && !Video.fullscreen && (abs(self.mouse-x - root.px) > 6px || abs(self.mouse-y - root.py) > 6px) {
            root.dragged = true;
            Ui.drag();
        }
    }
    pointer-event(e) => {
        if e.kind == PointerEventKind.move {
            Video.mouse-moved();
        }
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            root.px = self.mouse-x;
            root.py = self.mouse-y;
            root.dragged = false;
        }
        if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
            Video.menu();
        }
        if e.kind == PointerEventKind.up && e.button == PointerEventButton.middle {
            Video.toggle-fullscreen();
        }
    }
    clicked => {
        if !root.dragged {
            if Video.panel {
                Video.panel = false;
            } else {
                Player.play-pause();
            }
        }
    }
    double-clicked => {
        Player.play-pause();
        if Prefs.dblclick-seek && self.mouse-x < self.width * 0.25 {
            Player.seek-rel(-10);
        } else if Prefs.dblclick-seek && self.mouse-x > self.width * 0.75 {
            Player.seek-rel(10);
        } else {
            Video.toggle-fullscreen();
        }
    }
    scroll-event(e) => {
        if e.modifiers.control {
            Video.set-zoom(clamp(Video.zoom + (e.delta-y > 0 ? 0.1 : -0.1), -1, 2));
        } else if Prefs.wheel-action == 1 {
            Player.seek-rel(e.delta-y > 0 ? 5 : -5);
        } else {
            Player.set-volume(clamp(Player.volume + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1));
        }
        Video.mouse-moved();
        accept
    }
}

component VideoSeek inherits SeekBar {
    value: Video.duration > 0 ? Video.pos / Video.duration : 0;
    duration: Video.duration;
    chapters: Video.chapters;
    buffered: Video.buffered;
    ab-a: Player.ab-a;
    ab-b: Player.ab-b;
    show-preview: Prefs.seek-preview;
    preview: Video.preview;
    has-preview: Video.has-preview;
    preview-ratio: Video.ratio;
    preview-label: Video.preview-chapter;
    seek(v) => { Player.seek(v); }
    hover(f) => { Video.hover-seek(f); }
}

// Kinowy: obraz na całe okno, pasek tytułu u góry i pigułka sterowania u dołu – chowają się.
component CinemaView inherits Rectangle {
    background: #000000;
    property <bool> show: Video.controls || !Video.playing || Video.panel;
    property <color> c1: Theme.on-video;
    property <color> c2: Theme.on-video2;
    VideoStage {
        ambient: Prefs.ambient > 0;
        ambient-strength: Prefs.ambient == 2 ? 0.6 : 0.32;
    }
    StageInput { }
    // Górny pasek: powrót do biblioteki, tytuł, widoki i przyciski okna.
    Rectangle {
        y: 0;
        height: 70px;
        opacity: root.show ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 220ms; }
        background: @linear-gradient(180deg, #000000c0 0%, transparent 100%);
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left && !Video.fullscreen {
                    Ui.drag();
                }
                if e.kind == PointerEventKind.move {
                    Video.mouse-moved();
                }
            }
            double-clicked => { Video.toggle-fullscreen(); }
        }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            padding-top: 4px;
            alignment: stretch;
            height: 44px;
            spacing: 2px;
            IconBtn {
                y: 4px;
                icon: Icons.back;
                on-dark: true;
                icon-color: root.c2;
                hover-color: #ffffff;
                tip: "Biblioteka – film gra dalej (Esc)";
                clicked => { Video.leave-view(); }
            }
            VerticalLayout {
                padding-left: 8px;
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: Video.title;
                    color: #ffffff;
                    font-size: Theme.fs-md;
                    font-weight: 600;
                    overflow: elide;
                }
                if Video.info != "": Text {
                    text: Video.info;
                    color: #ffffff90;
                    font-size: Theme.fs-xs;
                    overflow: elide;
                }
            }
            if !Video.fullscreen: IconBtn {
                y: 4px;
                icon: Icons.playlist;
                on-dark: true;
                icon-color: root.c2;
                hover-color: #ffffff;
                tip: "Widok szeroki (W)";
                clicked => { Video.set-layout(1); }
            }
            IconBtn {
                y: 4px;
                icon: Icons.pip;
                on-dark: true;
                icon-color: root.c2;
                hover-color: #ffffff;
                tip: "Obraz w obrazie (P)";
                clicked => { Video.mini(); }
            }
            IconBtn {
                y: 4px;
                icon: Icons.pin;
                on-dark: true;
                active: Video.ontop;
                icon-color: Video.ontop ? Theme.tint-hi : root.c2;
                hover-color: #ffffff;
                tip: "Zawsze na wierzchu (T)";
                clicked => { Video.toggle-ontop(); }
            }
            if !Video.fullscreen: WinButtons {
                on-dark: true;
            }
        }
    }
    Osd {
        y: 78px;
        x: (parent.width - self.width) / 2;
    }
    // Dolny panel sterowania.
    bar := Pill {
        property <length> w: min(root.width - 24px, 860px);
        x: (root.width - self.width) / 2;
        y: root.height - self.height - (root.show ? 14px : -10px);
        width: w;
        height: 86px;
        opacity: root.show ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity, y { duration: 220ms; easing: ease-out; }
        TouchArea {
            changed has-hover => { Video.hover-controls(self.has-hover); }
        }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 6px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: Fmt.time(Video.pos);
                    color: root.c2;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                    width: 52px;
                }
                VideoSeek {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                    on-video: true;
                }
                Text {
                    text: Video.duration > 0 ? (Prefs.remaining ? "-" + Fmt.time(Video.duration - Video.pos) : Fmt.time(Video.duration)) : "na żywo";
                    color: root.c2;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    width: 52px;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Prefs.remaining = !Prefs.remaining;
                            Prefs.changed("remaining");
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 2px;
                IconBtn {
                    icon: Player.muted || Player.volume == 0 ? Icons.volume-off : Icons.volume;
                    tip: Player.muted ? "Włącz dźwięk (M)" : "Wycisz (M)";
                    on-dark: true;
                    icon-color: root.c2;
                    hover-color: #ffffff;
                    clicked => { Player.toggle-mute(); }
                }
                HSlider {
                    y: (parent.height - self.height) / 2;
                    width: bar.w > 600px ? 96px : 60px;
                    value: Player.volume;
                    fill-color: Theme.scope >= 1 ? Theme.tint : #ffffff;
                    track-color: #ffffff33;
                    moved(v) => { Player.set-volume(v); }
                }
                if bar.w > 600px && Video.speed != 1: Text {
                    text: "  " + round(Video.speed * 100) / 100 + "×";
                    color: Theme.tint-hi;
                    font-size: Theme.fs-sm;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                IconBtn {
                    icon: Icons.prev;
                    tip: "Poprzedni (Ctrl+←)";
                    on-dark: true;
                    icon-color: root.c2;
                    hover-color: #ffffff;
                    clicked => { Player.prev(); }
                }
                IconBtn {
                    icon: Icons.rewind;
                    on-dark: true;
                    icon-color: root.c2;
                    hover-color: #ffffff;
                    tip: "-10 s";
                    clicked => { Player.seek-rel(-10); }
                }
                Rectangle {
                    width: 44px;
                    height: 44px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 22px;
                    background: Theme.scope >= 1 ? (vpta.has-hover ? Theme.tint.brighter(0.15) : Theme.tint) : (vpta.has-hover ? #ffffff : #ffffffe6);
                    drop-shadow-blur: Theme.scope >= 1 ? 16px : 0;
                    drop-shadow-color: Theme.glow;
                    Icon {
                        icon: Video.playing ? Icons.pause : Icons.play;
                        size: 24px;
                        fill: Theme.scope >= 1 ? #ffffff : #000000;
                    }
                    vpta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Player.play-pause(); }
                    }
                }
                IconBtn {
                    icon: Icons.forward;
                    on-dark: true;
                    icon-color: root.c2;
                    hover-color: #ffffff;
                    tip: "+10 s";
                    clicked => { Player.seek-rel(10); }
                }
                IconBtn {
                    icon: Icons.next;
                    tip: "Następny (Ctrl+→)";
                    on-dark: true;
                    icon-color: root.c2;
                    hover-color: #ffffff;
                    clicked => { Player.next(); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if bar.w > 470px: IconBtn {
                    icon: Icons.subtitles;
                    on-dark: true;
                    active: Video.panel && Video.panel-page == 1;
                    icon-color: root.c2;
                    hover-color: #ffffff;
                    tip: "Napisy (V)";
                    clicked => {
                        Video.panel = !(Video.panel && Video.panel-page == 1);
                        Video.panel-page = 1;
                    }
                }
                IconBtn {
                    icon: Icons.tune;
                    on-dark: true;
                    active: Video.panel && Video.panel-page != 1;
                    icon-color: root.c2;
                    hover-color: #ffffff;
                    tip: "Dźwięk, obraz, prędkość, szczegóły";
                    clicked => {
                        Video.panel = !(Video.panel && Video.panel-page != 1);
                        Video.panel-page = Video.panel-page == 1 || Video.panel-page == 5 ? 0 : Video.panel-page;
                    }
                }
                if bar.w > 540px: IconBtn {
                    icon: Icons.more;
                    on-dark: true;
                    icon-color: root.c2;
                    hover-color: #ffffff;
                    tip: "Więcej";
                    clicked => { Video.menu(); }
                }
                IconBtn {
                    icon: Video.fullscreen ? Icons.fullscreen-exit : Icons.fullscreen;
                    on-dark: true;
                    icon-color: root.c2;
                    hover-color: #ffffff;
                    tip: "Pełny ekran (F)";
                    clicked => { Video.toggle-fullscreen(); }
                }
            }
        }
    }
    // Panel boczny: dźwięk, napisy, obraz, rozdziały, szczegóły.
    if Video.panel: Pill {
        x: root.width - self.width - 14px;
        y: 64px;
        width: min(340px, root.width - 28px);
        height: max(140px, bar.y - 78px);
        TouchArea { }
        VerticalLayout {
            padding: 12px;
            VideoPages {
                vertical-stretch: 1;
                themed: false;
                wide: false;
            }
        }
    }
}

// Szeroki: obraz na scenie z poświatą, panel listy i ustawień obok, sterowanie pod spodem.
component WideView inherits Rectangle {
    background: Theme.bg;
    property <bool> narrow: root.width < 820px;
    property <bool> tiny: root.width < 560px;
    // Tło: poświata z obrazu na całe okno.
    if Video.has-ambient && Video.active && Prefs.ambient > 0: Image {
        width: 100%;
        height: 100%;
        source: Video.ambient;
        image-fit: fill;
        opacity: Prefs.ambient == 2 ? 0.42 : 0.24;
    }
    Rectangle {
        background: @linear-gradient(180deg, Theme.bg.with-alpha(0.2) 0%, Theme.bg.with-alpha(0.55) 70%, Theme.bg.with-alpha(0.85) 100%);
    }
    VerticalLayout {
        // Pasek tytułu.
        Rectangle {
            height: 46px;
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        Ui.drag();
                    }
                }
                double-clicked => { Ui.toggle-maximize(); }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 4px;
                spacing: 2px;
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.back;
                    tip: "Biblioteka – film gra dalej (Esc)";
                    clicked => { Video.leave-view(); }
                }
                VerticalLayout {
                    padding-left: 8px;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: Video.title;
                        color: Theme.heading;
                        font-size: Theme.fs-md + 1px;
                        font-family: Theme.font-serif;
                        overflow: elide;
                    }
                    if Video.info != "": Text {
                        text: Video.info;
                        color: Theme.text3;
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                }
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.movie;
                    tip: "Widok kinowy (W)";
                    clicked => { Video.set-layout(0); }
                }
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.pip;
                    tip: "Obraz w obrazie (P)";
                    clicked => { Video.mini(); }
                }
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.queue;
                    active: Video.side;
                    tip: "Panel boczny";
                    clicked => { Video.side = !Video.side; }
                }
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.pin;
                    active: Video.ontop;
                    tip: "Zawsze na wierzchu (T)";
                    clicked => { Video.toggle-ontop(); }
                }
                Rectangle {
                    width: 6px;
                }
                WinButtons { }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 18px;
            padding-right: 14px;
            padding-top: 4px;
            spacing: 14px;
            box := Rectangle {
                horizontal-stretch: 1;
                // Poświata wokół sceny.
                if Video.has-ambient && Video.active && Prefs.ambient > 0: Image {
                    x: stage.x - 36px;
                    y: stage.y - 28px;
                    width: stage.width + 72px;
                    height: stage.height + 56px;
                    source: Video.ambient;
                    image-fit: fill;
                    opacity: Prefs.ambient == 2 ? 0.8 : 0.5;
                }
                stage := VideoStage {
                    property <float> ar: max(Video.ratio, 0.1);
                    width: min(box.width, box.height * self.ar);
                    height: min(box.height, box.width / self.ar);
                    x: (box.width - self.width) / 2;
                    y: (box.height - self.height) / 2;
                    radius: Theme.radius-lg;
                    ambient: false;
                }
                StageInput {
                    can-drag: false;
                }
                Osd {
                    y: 16px;
                    x: (parent.width - self.width) / 2;
                }
            }
            if Video.side && !root.narrow: Rectangle {
                width: 340px;
                border-radius: Theme.radius-lg;
                background: Theme.panel.with-alpha(0.82);
                border-width: 1px;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 12px;
                    VideoPages {
                        vertical-stretch: 1;
                        themed: true;
                        wide: true;
                    }
                }
            }
        }
        // Sterowanie – jak dolny pasek okna muzyki.
        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 10px;
            padding-bottom: 12px;
            spacing: 2px;
            VideoSeek { }
            HorizontalLayout {
                height: 20px;
                Text {
                    text: Fmt.time(Video.pos);
                    color: Theme.text2;
                    font-size: Theme.fs;
                    font-family: Theme.font-display;
                    vertical-alignment: center;
                }
                if Video.preview-chapter != "": Text {
                    text: "   " + Video.preview-chapter;
                    color: Theme.text3;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: Video.duration <= 0 ? "na żywo" : Prefs.remaining ? "-" + Fmt.time(Video.duration - Video.pos) : Fmt.time(Video.duration);
                    color: Theme.text2;
                    font-size: Theme.fs;
                    font-family: Theme.font-display;
                    vertical-alignment: center;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Prefs.remaining = !Prefs.remaining;
                            Prefs.changed("remaining");
                        }
                    }
                }
            }
            HorizontalLayout {
                height: 64px;
                spacing: 8px;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: 4px;
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Player.muted || Player.volume == 0 ? Icons.volume-off : Player.volume < 0.5 ? Icons.volume-low : Icons.volume;
                        tip: "Wycisz (M)";
                        clicked => { Player.toggle-mute(); }
                    }
                    if !root.tiny: HSlider {
                        y: (parent.height - self.height) / 2;
                        width: root.narrow ? 70px : 120px;
                        value: Player.volume;
                        fill-color: Player.muted ? Theme.text3 : Theme.tint;
                        moved(v) => { Player.set-volume(v); }
                    }
                    if !root.narrow: Text {
                        width: 40px;
                        text: round(Player.volume * 100) + "%";
                        color: Theme.text3;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                    if Video.speed != 1: Text {
                        text: "   " + round(Video.speed * 100) / 100 + "×";
                        color: Theme.tint-hi;
                        font-size: Theme.fs-sm;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: root.narrow ? 4px : 12px;
                    alignment: center;
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.prev;
                        size: 42px;
                        icon-size: 24px;
                        icon-color: Theme.ink;
                        tip: "Poprzedni (Ctrl+←)";
                        clicked => { Player.prev(); }
                    }
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.rewind;
                        size: 38px;
                        tip: "-10 s";
                        clicked => { Player.seek-rel(-10); }
                    }
                    PlayRing {
                        y: (parent.height - self.height) / 2;
                        size: 56px;
                    }
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.forward;
                        size: 38px;
                        tip: "+10 s";
                        clicked => { Player.seek-rel(10); }
                    }
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.next;
                        size: 42px;
                        icon-size: 24px;
                        icon-color: Theme.ink;
                        tip: "Następny (Ctrl+→)";
                        clicked => { Player.next(); }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: end;
                    spacing: 2px;
                    if !root.narrow: HorizontalLayout {
                    spacing: 2px;
                    for b in [
                        { i: 1, icon: Icons.subtitles, tip: "Napisy (V)" },
                        { i: 0, icon: Icons.audiotrack, tip: "Ścieżki dźwiękowe i prędkość" },
                        { i: 2, icon: Icons.tune, tip: "Obraz" },
                    ]: IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: b.icon;
                        size: 34px;
                        active: Video.side && Video.panel-page == b.i;
                        tip: b.tip;
                        clicked => {
                            if Video.side && Video.panel-page == b.i {
                                Video.side = false;
                            } else {
                                Video.side = true;
                                Video.panel-page = b.i;
                            }
                        }
                    }
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.camera;
                        size: 34px;
                        tip: "Zrzut ekranu (S)";
                        clicked => { Video.screenshot(); }
                    }
                    }
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.more;
                        size: 34px;
                        tip: "Więcej";
                        clicked => { Video.menu(); }
                    }
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.fullscreen;
                        size: 34px;
                        tip: "Pełny ekran (F)";
                        clicked => { Video.toggle-fullscreen(); }
                    }
                }
            }
        }
    }
}

export component VideoView inherits Rectangle {
    background: #000000;
    if Prefs.video-ui == 1 && !Video.fullscreen: WideView { }
    if Prefs.video-ui != 1 || Video.fullscreen: CinemaView { }
}

export component MiniView inherits Rectangle {
    background: Theme.bg;
    property <bool> hover: area.has-hover;
    // Obraz w obrazie: film na całe okienko, przyciski po najechaniu.
    if Video.active: Rectangle {
        background: #000000;
        VideoStage {
            ambient: Prefs.ambient > 0;
            ambient-strength: 0.3;
        }
    }
    area := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                Ui.drag();
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right && Video.active {
                Video.menu();
            }
        }
        double-clicked => {
            if Video.active {
                Video.open-view();
            } else {
                Ui.set-mode(0);
            }
        }
        scroll-event(e) => {
            Player.set-volume(clamp(Player.volume + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1));
            accept
        }
        if Video.active: Rectangle {
            opacity: root.hover || !Video.playing ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 180ms; }
            Rectangle {
                height: 48px;
                y: 0;
                background: @linear-gradient(180deg, #000000b0 0%, transparent 100%);
            }
            Rectangle {
                height: 70px;
                y: parent.height - self.height;
                background: @linear-gradient(0deg, #000000c8 0%, transparent 100%);
            }
            HorizontalLayout {
                x: 8px;
                y: 6px;
                width: parent.width - 14px;
                height: 30px;
                spacing: 2px;
                Text {
                    text: Video.title;
                    color: #ffffff;
                    font-size: Theme.fs-sm;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconBtn {
                    icon: Icons.expand;
                    size: 28px;
                    icon-size: 15px;
                    on-dark: true;
                    icon-color: #ffffffd0;
                    hover-color: #ffffff;
                    tip: "Widok filmu";
                    clicked => { Video.open-view(); }
                }
                IconBtn {
                    icon: Icons.library;
                    size: 28px;
                    icon-size: 15px;
                    on-dark: true;
                    icon-color: #ffffffd0;
                    hover-color: #ffffff;
                    tip: "Pełne okno";
                    clicked => { Ui.set-mode(0); }
                }
                IconBtn {
                    icon: Icons.close;
                    size: 28px;
                    icon-size: 14px;
                    on-dark: true;
                    icon-color: #ffffffd0;
                    hover-color: #ffffff;
                    tip: "Zamknij";
                    clicked => { Ui.close(); }
                }
            }
            HorizontalLayout {
                x: 8px;
                y: parent.height - 42px;
                width: parent.width - 16px;
                height: 36px;
                spacing: 4px;
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Video.playing ? Icons.pause : Icons.play;
                    size: 32px;
                    icon-size: 20px;
                    on-dark: true;
                    icon-color: Theme.on-video;
                    hover-color: #ffffff;
                    tip: "Odtwórz / pauza";
                    tip-above: true;
                    clicked => { Player.play-pause(); }
                }
                VideoSeek {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                    on-video: true;
                }
                Text {
                    text: Fmt.time(Video.pos);
                    color: #ffffffd0;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                }
            }
        }
        if !Video.active && Player.has-cover: Image {
            width: 100%;
            height: 100%;
            source: Player.backdrop;
            image-fit: ImageFit.cover;
            opacity: 0.22;
        }
        if !Video.active: Rectangle {
            background: @linear-gradient(90deg, Theme.bg.with-alpha(0.9) 0%, Theme.bg.with-alpha(0.6) 60%, Theme.bg.with-alpha(0.92) 100%);
        }
        // Delikatne słupki analizatora za tytułem – muzyka „widać” także bez najeżdżania.
        if !Video.active && Player.viz-mode != 4 && !Player.idle: Visualizer {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            height: strip.y - 12px;
            opacity: 0.28;
            overlay: true;
            mode: Player.viz-mode == 3 ? 0 : Player.viz-mode;
            bars: Player.bars;
            peaks: Player.peaks;
            scope-path: Player.scope-path;
            spectrum-path: Player.spectrum-path;
            active: Player.viz-active;
            note: "";
        }
        // Tytuł i wykonawca – zawsze widoczne; ustępują miejsca okładce po najechaniu.
        if !Video.active: HorizontalLayout {
            x: 14px;
            y: 8px;
            width: parent.width - 28px;
            height: strip.y - 14px;
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                padding-right: root.hover ? cover.width + 8px : 0px;
                animate padding-right { duration: 180ms; easing: ease-out; }
                Marquee {
                    text: Player.idle ? "OpenMP" : Player.title;
                    font-size: Theme.fs-lg + 1px;
                    font-family: Theme.font-serif;
                    text-color: Theme.heading;
                    enabled: Prefs.scroll-title;
                }
                Text {
                    text: Player.idle ? "Nic nie gra" : Player.artist;
                    color: Theme.tint.mix(Theme.text2, 0.45);
                    font-size: Theme.fs;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: start;
                IconBtn {
                    icon: Icons.expand;
                    size: 26px;
                    icon-size: 15px;
                    tip: "Pełne okno";
                    clicked => { Ui.set-mode(0); }
                }
                IconBtn {
                    icon: Icons.close;
                    tip: "Zamknij";
                    size: 26px;
                    icon-size: 14px;
                    clicked => { Ui.close(); }
                }
            }
        }
        // Pasek postępu z przyciskami odtwarzania.
        strip := Rectangle {
            x: 0;
            width: parent.width;
            height: 56px;
            y: parent.height - self.height;
            visible: !Video.active;
            background: Theme.panel2.with-alpha(0.85);
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 16px;
                spacing: 2px;
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.prev;
                    tip: "Poprzedni";
                    size: 34px;
                    icon-size: 20px;
                    icon-color: Theme.ink;
                    tip-above: true;
                    clicked => { Player.prev(); }
                }
                PlayRing {
                    y: (parent.height - self.height) / 2;
                    size: 40px;
                }
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.next;
                    tip: "Następny";
                    size: 34px;
                    icon-size: 20px;
                    icon-color: Theme.ink;
                    tip-above: true;
                    clicked => { Player.next(); }
                }
                Rectangle {
                    width: 8px;
                }
                SeekBar {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                    wave-height: 32px;
                    value: Player.duration > 0 ? Player.pos / Player.duration : 0;
                    duration: Player.duration;
                    wave: Player.wave;
                    wave2: Player.wave2;
                    wave2-kind: Player.wave2-kind;
                    wave-live: Player.wave-live;
                    show-wave: Prefs.show-waveform;
                    ab-a: Player.ab-a;
                    ab-b: Player.ab-b;
                    seek(v) => { Player.seek(v); }
                }
                Rectangle {
                    width: 12px;
                }
                Text {
                    text: Prefs.remaining && Player.duration > 0 ? "-" + Fmt.time(Player.duration - Player.pos) : Fmt.time(Player.pos);
                    color: Theme.text2;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Prefs.remaining = !Prefs.remaining;
                            Prefs.changed("remaining");
                        }
                    }
                }
            }
        }
        // Okładka z wizualizacją – nad paskiem po prawej, tylko po najechaniu.
        cover := CoverArt {
            width: strip.y - 14px;
            height: self.width;
            x: parent.width - self.width - 48px;
            y: root.hover ? strip.y - self.height - 6px : strip.y - self.height + 6px;
            radius: 8px;
            show-chip: false;
            show-viz: false;
            opacity: root.hover && !Video.active ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity, y { duration: 180ms; easing: ease-out; }
            clicked => { Player.cycle-viz(); }
        }
    }
}
