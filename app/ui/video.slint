// Widok filmu: w oknie szeroki (obraz z panelem listy i ustawień, sterowanie jak w oknie muzyki),
// na pełnym ekranie sam obraz z chowanym sterowaniem. Ten sam panel: lista, dźwięk, napisy, obraz,
// rozdziały, szczegóły.
// Miniodtwarzacz: pasek muzyki albo obraz w obrazie z przyciskami po najechaniu.

import { ListView } from "scroll.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconBtn, HSlider, Segmented, Cover, Marquee, Btn, Switch } from "widgets.slint";
import { SeekBar, Fmt, Visualizer } from "display.slint";
import { CoverArt, PlayRing } from "nowplaying.slint";
import { WinButtons } from "views.slint";
import { VideoStage } from "surface.slint";
import { Player, Video, Ui, Prefs, Lists } from "state.slint";
import { Opt } from "types.slint";
import { GlassFill } from "glass.slint";

component Pill inherits Rectangle {
    background: #0c0e12d9;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.scope >= 1 ? Theme.tint.with-alpha(0.22) : #ffffff14;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000080;
}

// Barwy panelu: w szerokim widoku z motywu, na obrazie – jasne.
global VInk {
    pure public function fg(t: bool) -> color {
        return t ? Theme.text : #ffffff;
    }
    pure public function fg2(t: bool) -> color {
        return t ? Theme.text2 : #ffffffb0;
    }
    pure public function fg3(t: bool) -> color {
        return t ? Theme.text3 : #ffffff80;
    }
    pure public function sel(t: bool) -> color {
        return t ? Theme.sel : #ffffff1f;
    }
    pure public function hov(t: bool) -> color {
        return t ? Theme.hover : #ffffff12;
    }
    pure public function track(t: bool) -> color {
        return t ? (Theme.dark ? #ffffff1f : #0000001a) : #ffffff33;
    }
    pure public function fill(t: bool) -> color {
        return t || Theme.scope >= 1 ? Theme.tint : #ffffff;
    }
}

component OptList inherits VerticalLayout {
    in property <[Opt]> items;
    in property <string> empty;
    in property <bool> themed;
    callback picked(string);
    spacing: 2px;
    if root.items.length == 0: Text {
        text: root.empty;
        color: VInk.fg3(root.themed);
        font-size: Theme.fs-sm;
    }
    for o in root.items: Rectangle {
        height: o.sub != "" ? 40px : 30px;
        border-radius: 7px;
        background: o.selected ? VInk.sel(root.themed) : ota.has-hover ? VInk.hov(root.themed) : transparent;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            Rectangle {
                width: 14px;
                if o.selected: Icon {
                    icon: Icons.check;
                    size: 14px;
                    fill: Theme.tint-hi;
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: o.label;
                    color: VInk.fg(root.themed);
                    font-size: Theme.fs;
                    overflow: elide;
                }
                if o.sub != "": Text {
                    text: o.sub;
                    color: VInk.fg3(root.themed);
                    font-size: Theme.fs-xs;
                    overflow: elide;
                }
            }
        }
        ota := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(o.id); }
        }
    }
}

component VRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <bool> themed;
    spacing: 10px;
    height: 30px;
    Text {
        width: 104px;
        text: root.label;
        color: VInk.fg2(root.themed);
        font-size: Theme.fs-sm;
        vertical-alignment: center;
    }
    @children
    Text {
        width: 56px;
        text: root.value-text;
        color: VInk.fg(root.themed);
        font-size: Theme.fs-sm;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component VSwitch inherits HorizontalLayout {
    in property <string> label;
    in property <bool> themed;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 30px;
    spacing: 10px;
    Text {
        text: root.label;
        color: VInk.fg2(root.themed);
        font-size: Theme.fs-sm;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Switch {
        y: (parent.height - self.height) / 2;
        checked <=> root.checked;
        toggled(v) => { root.toggled(v); }
    }
}

component Caption inherits Text {
    in property <bool> themed;
    color: themed ? Theme.text3 : #ffffff90;
    font-size: Theme.fs-xs;
    font-weight: 700;
    letter-spacing: 0.6px;
}

// Panel filmu: karty jako ikony, treść karty pod spodem.
component VideoPages inherits VerticalLayout {
    in property <bool> themed;
    in property <bool> wide;
    property <int> pg: !root.wide && Video.panel-page == 5 ? 0 : Video.panel-page;
    spacing: 10px;
    HorizontalLayout {
        spacing: 2px;
        for t in [
            { i: 5, icon: Icons.queue, tip: @tr("List") },
            { i: 0, icon: Icons.audiotrack, tip: @tr("Audio and speed") },
            { i: 1, icon: Icons.subtitles, tip: @tr("Subtitles") },
            { i: 2, icon: Icons.tune, tip: @tr("Picture") },
            { i: 3, icon: Icons.bookmark, tip: @tr("Chapters") },
            { i: 4, icon: Icons.info, tip: @tr("Playback details") },
        ]: Rectangle {
            width: t.i != 5 || root.wide ? 36px : 0px;
            height: 34px;
            if t.i != 5 || root.wide: IconBtn {
                icon: t.icon;
                tip: t.tip;
                size: 34px;
                icon-size: 18px;
                active: root.pg == t.i;
                on-dark: !root.themed;
                icon-color: root.pg == t.i ? Theme.tint-hi : VInk.fg2(root.themed);
                hover-color: VInk.fg(root.themed);
                background: root.pg == t.i ? VInk.sel(root.themed) : transparent;
                clicked => {
                    Video.panel-page = t.i;
                    Video.panel-page-changed(t.i);
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: [@tr("Audio"), @tr("Subtitles"), @tr("Picture"), @tr("Chapters"), @tr("Details"), @tr("List")][root.pg];
            color: VInk.fg(root.themed);
            font-size: Theme.fs-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    // Lista bieżąca – kliknięcie odtwarza.
    if root.pg == 5: ListView {
        vertical-stretch: 1;
        for r in Lists.rows: Rectangle {
            height: r.header ? 0px : 46px;
            visible: !r.header;
            border-radius: 8px;
            background: r.playing ? Theme.sel : lta.has-hover ? VInk.hov(root.themed) : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 10px;
                Rectangle {
                    width: 18px;
                    Icon {
                        icon: r.playing ? Icons.play : r.video ? Icons.movie : Icons.note;
                        size: 15px;
                        fill: r.playing ? Theme.tint-hi : VInk.fg3(root.themed);
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: r.title;
                        color: r.playing ? Theme.tint-hi : VInk.fg(root.themed);
                        font-size: Theme.fs;
                        font-weight: r.playing ? 600 : 400;
                        overflow: elide;
                    }
                    Text {
                        text: r.artist;
                        color: VInk.fg3(root.themed);
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                }
                Text {
                    text: r.dur;
                    color: VInk.fg3(root.themed);
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                }
            }
            lta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Lists.row-double(r.idx); }
            }
        }
    }
    if root.pg != 5: Flickable {
        vertical-stretch: 1;
        content-height: inner.preferred-height;
        inner := VerticalLayout {
            spacing: 8px;
            if root.pg == 0: VerticalLayout {
                spacing: 6px;
                Caption {
                    themed: root.themed;
                    text: @tr("AUDIO TRACK");
                }
                OptList {
                    themed: root.themed;
                    items: Video.audio-tracks;
                    empty: @tr("No audio tracks");
                    picked(id) => { Video.select-audio(id); }
                }
                // Ten sam korektor i efekty co dla muzyki – działają też na dźwięk filmu.
                Btn {
                    text: Player.eq-on ? @tr("Equalizer and sound effects (on)") : @tr("Equalizer and sound effects…");
                    icon: Icons.equalizer;
                    compact: true;
                    clicked => { Ui.equalizer = true; }
                }
                Rectangle {
                    height: 6px;
                }
                if Video.is-url: Caption {
                    themed: root.themed;
                    text: @tr("ONLINE VIDEO QUALITY");
                }
                if Video.is-url: Segmented {
                    options: [@tr("Best"), "1080p", "720p", "480p"];
                    selected <=> Prefs.ytdl-format;
                    changed => { Prefs.changed("ytdl-format"); }
                }
                if Video.is-url: Rectangle {
                    height: 6px;
                }
                Caption {
                    themed: root.themed;
                    text: @tr("SPEED");
                }
                HorizontalLayout {
                    spacing: 4px;
                    for s in [0.5, 0.75, 1, 1.25, 1.5, 2]: Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius;
                        background: abs(Video.speed - s) < 0.01 ? Theme.tint.with-alpha(0.3) : sta.has-hover ? VInk.hov(root.themed) : #ffffff08;
                        border-width: 1px;
                        border-color: abs(Video.speed - s) < 0.01 ? Theme.tint : transparent;
                        Text {
                            text: s + "×";
                            color: VInk.fg(root.themed);
                            font-size: Theme.fs-sm;
                        }
                        sta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Video.set-speed(s); }
                        }
                    }
                }
                VRow {
                    themed: root.themed;
                    label: @tr("Fine");
                    value-text: round(Video.speed * 100) / 100 + "×";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: 0.25;
                        maximum: 4;
                        step: 0.05;
                        value: Video.speed;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => { Video.set-speed(v); }
                        reset => { Video.set-speed(1); }
                    }
                }
                VRow {
                    themed: root.themed;
                    label: @tr("Audio delay");
                    value-text: round(Video.audio-delay * 1000) + " ms";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: -2;
                        maximum: 2;
                        step: 0.05;
                        centered: true;
                        value: Video.audio-delay;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => { Video.set-audio-delay(v); }
                        reset => { Video.set-audio-delay(0); }
                    }
                }
                VRow {
                    themed: root.themed;
                    label: @tr("Boost");
                    value-text: round(Prefs.volume-boost) + "%";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: 100;
                        maximum: 200;
                        step: 5;
                        value: Prefs.volume-boost;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => {
                            Prefs.volume-boost = v;
                            Prefs.changed("volume-boost");
                        }
                        reset => {
                            Prefs.volume-boost = 100;
                            Prefs.changed("volume-boost");
                        }
                    }
                }
                VSwitch {
                    themed: root.themed;
                    label: @tr("Night mode (compressed dynamics)");
                    checked <=> Prefs.night-mode;
                    toggled => { Prefs.changed("night-mode"); }
                }
                VSwitch {
                    themed: root.themed;
                    label: @tr("Stereo downmix");
                    checked <=> Prefs.downmix;
                    toggled => { Prefs.changed("downmix"); }
                }
            }
            if root.pg == 1: VerticalLayout {
                spacing: 6px;
                OptList {
                    themed: root.themed;
                    items: Video.sub-tracks;
                    empty: @tr("No subtitles");
                    picked(id) => { Video.select-sub(id); }
                }
                Btn {
                    text: @tr("Load subtitles from file…");
                    icon: Icons.file;
                    compact: true;
                    clicked => { Video.load-sub(); }
                }
                Btn {
                    text: @tr("Download subtitles (OpenSubtitles)");
                    icon: Icons.download;
                    compact: true;
                    clicked => { Video.fetch-sub(); }
                }
                Rectangle {
                    height: 4px;
                }
                VRow {
                    themed: root.themed;
                    label: @tr("Delay");
                    value-text: round(Video.sub-delay * 1000) + " ms";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: -5;
                        maximum: 5;
                        step: 0.1;
                        centered: true;
                        value: Video.sub-delay;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => { Video.set-sub-delay(v); }
                        reset => { Video.set-sub-delay(0); }
                    }
                }
                VRow {
                    themed: root.themed;
                    label: @tr("subtitles" => "Size");
                    value-text: round(Video.sub-scale * 100) + "%";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: 0.5;
                        maximum: 2.5;
                        step: 0.05;
                        value: Video.sub-scale;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => { Video.set-sub-scale(v); }
                        reset => { Video.set-sub-scale(1); }
                    }
                }
                VRow {
                    themed: root.themed;
                    label: @tr("Position");
                    value-text: Prefs.sub-pos + "";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: 40;
                        maximum: 110;
                        step: 1;
                        value: Prefs.sub-pos;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => {
                            Prefs.sub-pos = v;
                            Prefs.changed("sub-pos");
                        }
                        reset => {
                            Prefs.sub-pos = 100;
                            Prefs.changed("sub-pos");
                        }
                    }
                }
                Caption {
                    themed: root.themed;
                    text: @tr("STYLE");
                }
                Segmented {
                    small: true;
                    options: [@tr("Outline"), @tr("Shadow"), @tr("Box")];
                    selected: Prefs.sub-style;
                    changed(i) => {
                        Prefs.sub-style = i;
                        Prefs.changed("sub-style");
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    padding-top: 4px;
                    for c[i] in [#ffffff, #ffe14d, #86e1ff, #a6ffa0]: Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: c;
                        border-width: Prefs.sub-color == i ? 2px : 1px;
                        border-color: Prefs.sub-color == i ? Theme.tint : #00000040;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Prefs.sub-color = i;
                                Prefs.changed("sub-color");
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                VSwitch {
                    themed: root.themed;
                    label: @tr("Bold");
                    checked <=> Prefs.sub-bold;
                    toggled => { Prefs.changed("sub-bold"); }
                }
                VSwitch {
                    themed: root.themed;
                    label: @tr("Custom style for ASS subtitles too");
                    checked <=> Prefs.sub-override;
                    toggled => { Prefs.changed("sub-override"); }
                }
            }
            if root.pg == 2: VerticalLayout {
                spacing: 4px;
                for e in [
                    { id: "brightness", l: @tr("Brightness"), v: Video.brightness },
                    { id: "contrast", l: @tr("Contrast"), v: Video.contrast },
                    { id: "saturation", l: @tr("Saturation"), v: Video.saturation },
                    { id: "gamma", l: @tr("Gamma"), v: Video.gamma },
                    { id: "hue", l: @tr("Hue"), v: Video.hue },
                ]: VRow {
                    themed: root.themed;
                    label: e.l;
                    value-text: round(e.v);
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: -100;
                        maximum: 100;
                        step: 1;
                        centered: true;
                        value: e.v;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => { Video.set-eq(e.id, v); }
                        reset => { Video.set-eq(e.id, 0); }
                    }
                }
                VRow {
                    themed: root.themed;
                    label: @tr("Zoom");
                    value-text: round(pow(2, Video.zoom) * 100) + "%";
                    HSlider {
                        horizontal-stretch: 1;
                        y: (parent.height - self.height) / 2;
                        minimum: -1;
                        maximum: 2;
                        step: 0.05;
                        centered: true;
                        value: Video.zoom;
                        fill-color: VInk.fill(root.themed);
                        track-color: VInk.track(root.themed);
                        moved(v) => { Video.set-zoom(v); }
                        reset => { Video.set-zoom(0); }
                    }
                }
                Caption {
                    themed: root.themed;
                    text: @tr("ASPECT RATIO");
                }
                Segmented {
                    small: true;
                    options: ["Auto", "16:9", "4:3", "21:9", @tr("Stretch"), @tr("Fill")];
                    selected: Video.aspect;
                    changed(i) => { Video.set-aspect(i); }
                }
                Caption {
                    themed: root.themed;
                    text: @tr("AMBIENT GLOW");
                }
                Segmented {
                    small: true;
                    options: [@tr("glow" => "Off"), @tr("Subtle"), @tr("glow" => "Strong")];
                    selected: Prefs.ambient;
                    changed(i) => {
                        Prefs.ambient = i;
                        Prefs.changed("ambient");
                    }
                }
                VSwitch {
                    themed: root.themed;
                    label: @tr("Debanding (smooth gradients)");
                    checked <=> Prefs.deband;
                    toggled => { Prefs.changed("deband"); }
                }
                VSwitch {
                    themed: root.themed;
                    label: @tr("Accent color from picture");
                    checked <=> Prefs.video-tint;
                    toggled => { Prefs.changed("video-tint"); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    padding-top: 6px;
                    Btn {
                        text: @tr("Rotate");
                        icon: Icons.refresh;
                        compact: true;
                        clicked => { Video.rotate-view(); }
                    }
                    Btn {
                        text: @tr("As in file");
                        icon: Icons.aspect;
                        compact: true;
                        clicked => { Video.reset-view(); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Btn {
                        text: @tr("Screenshot");
                        icon: Icons.camera;
                        compact: true;
                        clicked => { Video.screenshot(); }
                    }
                    Btn {
                        text: @tr("A-B loop");
                        icon: Icons.repeat;
                        compact: true;
                        clicked => { Video.ab-loop(); }
                    }
                }
            }
            if root.pg == 3: OptList {
                themed: root.themed;
                items: Video.chapter-list;
                empty: @tr("This file has no chapters");
                picked(id) => { Video.goto-chapter(id); }
            }
            if root.pg == 4: VerticalLayout {
                spacing: 2px;
                if Video.stats.length == 0: Text {
                    text: @tr("Details will appear once the file loads.");
                    color: VInk.fg3(root.themed);
                    font-size: Theme.fs-sm;
                }
                for s in Video.stats: HorizontalLayout {
                    spacing: 10px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    Text {
                        width: 112px;
                        text: s.label;
                        color: VInk.fg3(root.themed);
                        font-size: Theme.fs-sm;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: s.sub;
                        color: VInk.fg(root.themed);
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// Komunikat na środku (głośność, przewinięcie, prędkość).
// Komunikat u góry obrazu: karta z ikoną w kolorze akcentu i – dla wartości – cienkim paskiem.
component Osd inherits Rectangle {
    property <bool> level: Video.osd-level >= 0;
    width: max(lay.preferred-width, 200px);
    height: lay.preferred-height;
    opacity: Video.osd-visible ? 1 : 0;
    animate opacity { duration: 180ms; easing: ease-out; }
    card := Rectangle {
        y: Video.osd-visible ? 0 : -10px;
        animate y { duration: 220ms; easing: ease-out; }
        border-radius: 12px;
        background: @linear-gradient(180deg, #1a1d24f0 0%, #0e1014f0 100%);
        border-width: 1px;
        border-color: #ffffff17;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #000000a0;
        lay := HorizontalLayout {
            padding-left: 10px;
            padding-right: 20px;
            padding-top: 9px;
            padding-bottom: 9px;
            spacing: 12px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 32px;
                height: 32px;
                border-radius: 9px;
                background: Theme.tint.with-alpha(0.18);
                Icon {
                    icon: Icons.get(Video.osd-icon);
                    size: 17px;
                    fill: Theme.tint-hi;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: Video.osd;
                    color: #ffffff;
                    font-size: Theme.fs-md;
                    font-weight: 600;
                }
                if root.level: Rectangle {
                    height: 3px;
                    border-radius: 1.5px;
                    background: #ffffff1f;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(Video.osd-level, 0, 1);
                        border-radius: 1.5px;
                        background: Theme.tint;
                        animate width { duration: 120ms; }
                    }
                }
            }
        }
    }
}

// Obsługa myszy na obrazie: klik – pauza, dwuklik – pełny ekran (przy krawędziach – przewijanie),
// kółko – głośność albo przewijanie (z Ctrl – powiększenie), prawy – menu, środkowy – pełny ekran.
component StageInput inherits TouchArea {
    in property <bool> can-drag: true;
    property <length> px;
    property <length> py;
    property <bool> dragged;
    // Gest: 1 – jasność (lewa strona), 2 – głośność (prawa); wartości z chwili naciśnięcia.
    property <int> gesture;
    property <float> g0;
    mouse-cursor: Video.cursor || !Video.playing ? MouseCursor.default : MouseCursor.none;
    moved => {
        Video.mouse-moved();
        // Pionowy ruch po bokach obrazu to gest (także w oknie – okno przesuwa się ze środka
        // obrazu albo ruchem w poziomie).
        if self.pressed && root.gesture == 0 && !root.dragged && abs(self.mouse-y - root.py) > 12px && abs(self.mouse-y - root.py) > 2 * abs(self.mouse-x - root.px) {
            if root.px < self.width * 0.35 {
                root.gesture = 1;
                root.g0 = Video.brightness;
            } else if root.px > self.width * 0.65 {
                root.gesture = 2;
                root.g0 = Player.volume;
            }
            root.dragged = root.gesture != 0;
        }
        if self.pressed && root.gesture == 1 {
            Video.set-eq("brightness", clamp(root.g0 + (root.py - self.mouse-y) / self.height * 100, -100, 100));
        }
        if self.pressed && root.gesture == 2 {
            Player.set-volume(clamp(root.g0 + (root.py - self.mouse-y) / self.height * 1.5, 0, 1));
        }
        // Okno przesuwa się ze środka obrazu albo ruchem w poziomie – boki zostają dla gestów.
        let side = root.px < self.width * 0.35 || root.px > self.width * 0.65;
        if self.pressed && root.can-drag && !root.dragged && !Video.fullscreen && (abs(self.mouse-x - root.px) > 6px || (!side && abs(self.mouse-y - root.py) > 6px)) {
            root.dragged = true;
            Ui.drag();
        }
    }
    pointer-event(e) => {
        if e.kind == PointerEventKind.move {
            Video.mouse-moved();
        }
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            root.px = self.mouse-x;
            root.py = self.mouse-y;
            root.dragged = false;
            root.gesture = 0;
        }
        if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
            Video.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
        }
        if e.kind == PointerEventKind.up && e.button == PointerEventButton.middle {
            Video.toggle-fullscreen();
        }
    }
    // Pojedynczy klik pauzuje dopiero po chwili – gdy przyjdzie drugi (dwuklik: pełny ekran,
    // przewijanie), pauzy nie ma i film gra dalej bez zatrzymania.
    property <bool> click-wait;
    Timer {
        interval: 250ms;
        running: root.click-wait;
        triggered => {
            root.click-wait = false;
            Player.play-pause();
        }
    }
    clicked => {
        if !root.dragged {
            if Video.panel {
                Video.panel = false;
            } else {
                root.click-wait = true;
            }
        }
    }
    double-clicked => {
        root.click-wait = false;
        if Prefs.dblclick-seek && self.mouse-x < self.width * 0.25 {
            Player.seek-rel(-10);
        } else if Prefs.dblclick-seek && self.mouse-x > self.width * 0.75 {
            Player.seek-rel(10);
        } else {
            Video.toggle-fullscreen();
        }
    }
    scroll-event(e) => {
        if e.modifiers.control {
            Video.set-zoom(clamp(Video.zoom + (e.delta-y > 0 ? 0.1 : -0.1), -1, 2));
        } else if Prefs.wheel-action == 1 {
            Player.seek-rel(e.delta-y > 0 ? 5 : -5);
        } else {
            Player.set-volume(clamp(Player.volume + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1));
        }
        Video.mouse-moved();
        accept
    }
}

component VideoSeek inherits SeekBar {
    value: Video.duration > 0 ? Video.pos / Video.duration : 0;
    duration: Video.duration;
    chapters: Video.chapters;
    buffered: Video.buffered;
    ab-a: Player.ab-a;
    ab-b: Player.ab-b;
    show-preview: Prefs.seek-preview;
    preview: Video.preview;
    has-preview: Video.has-preview;
    preview-ratio: Video.ratio;
    preview-label: Video.preview-chapter;
    seek(v) => { Player.seek(v); }
    hover(f) => { Video.hover-seek(f); }
}

// Pełny ekran: obraz na cały ekran, pasek tytułu u góry i sterowanie u dołu – chowają się.
component FullView inherits Rectangle {
    background: #000000;
    property <bool> show: Video.controls || !Video.playing || Video.panel;
    property <color> c1: Theme.on-video;
    property <color> c2: Theme.on-video2;
    VideoStage {
        ambient: Prefs.ambient > 0;
        ambient-strength: Prefs.ambient == 2 ? 0.6 : 0.32;
    }
    StageInput { }
    // Górny pasek: powrót do biblioteki, tytuł, widoki i przyciski okna – na całą szerokość,
    // z tłem przechodzącym w obraz, jak dolny pasek.
    Rectangle {
        y: root.show ? 0 : -16px;
        height: 96px;
        opacity: root.show ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity, y { duration: 220ms; easing: ease-out; }
        background: @linear-gradient(180deg, #000000e0 0%, #000000a0 45%, transparent 100%);
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left && !Video.fullscreen {
                    Ui.drag();
                }
                if e.kind == PointerEventKind.move {
                    Video.mouse-moved();
                }
            }
            double-clicked => { Video.toggle-fullscreen(); }
        }
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 6px;
            padding-top: 2px;
            alignment: stretch;
            height: 48px;
            spacing: 2px;
            IconBtn {
                y: 4px;
                icon: Icons.back;
                on-dark: true;
                icon-color: root.c2;
                hover-color: #ffffff;
                tip: @tr("To window – the movie keeps playing next to the description (Esc)");
                clicked => { Video.leave-view(); }
            }
            VerticalLayout {
                padding-left: 8px;
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: Video.title;
                    color: #ffffff;
                    font-size: Theme.fs-md * 1.35;
                    font-weight: 600;
                    overflow: elide;
                }
                if Video.info != "": Text {
                    text: Video.info;
                    color: #ffffff90;
                    font-size: Theme.fs-xs;
                    overflow: elide;
                }
            }
            IconBtn {
                y: 4px;
                icon: Icons.pip;
                on-dark: true;
                icon-color: root.c2;
                hover-color: #ffffff;
                tip: @tr("Picture in picture (P)");
                clicked => { Video.mini(); }
            }
            IconBtn {
                y: 4px;
                icon: Video.ontop ? Icons.pin : Icons.pin-off;
                on-dark: true;
                active: Video.ontop;
                icon-color: Video.ontop ? Theme.tint-hi : root.c2;
                hover-color: #ffffff;
                tip: Video.ontop ? @tr("Pinned on top – unpin (T)") : @tr("Always on top (T)");
                clicked => { Video.toggle-ontop(); }
            }
            if !Video.fullscreen: WinButtons {
                on-dark: true;
            }
        }
    }
    Osd {
        y: 78px;
        x: (parent.width - self.width) / 2;
    }
    // Dolny panel sterowania.
    // Pasek na całą szerokość, wtopiony w dół obrazu – bez ramki i zaokrągleń.
    bar := Rectangle {
        property <length> w: root.width;
        x: 0;
        y: root.height - self.height + (root.show ? 0 : 16px);
        width: root.width;
        height: 150px;
        background: @linear-gradient(180deg, transparent 0%, #000000a0 35%, #000000e0 100%);
        opacity: root.show ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity, y { duration: 220ms; easing: ease-out; }
        TouchArea {
            changed has-hover => { Video.hover-controls(self.has-hover); }
        }
        // Ten sam układ co pasek muzyki: taśma, czasy, głośność – odtwarzanie – przełączniki.
        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 34px;
            padding-bottom: 8px;
            spacing: 2px;
            VideoSeek {
                on-video: true;
            }
            HorizontalLayout {
                height: 20px;
                // Wcięcie jak ikona w przycisku pod spodem (32 px, ikona 18 px) – czasy równo z ikonami.
                padding-left: 7px;
                padding-right: 7px;
                Text {
                    text: Fmt.time(Video.pos);
                    color: root.c2;
                    font-size: Theme.fs;
                    font-family: Theme.font-display;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: Video.duration > 0 ? (Prefs.remaining ? "-" + Fmt.time(Video.duration - Video.pos) : Fmt.time(Video.duration)) : @tr("live");
                    color: root.c2;
                    font-size: Theme.fs;
                    font-family: Theme.font-display;
                    vertical-alignment: center;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Prefs.remaining = !Prefs.remaining;
                            Prefs.changed("remaining");
                        }
                    }
                }
            }
            HorizontalLayout {
                height: 62px;
                spacing: 8px;
                // Lewa strona: głośność i prędkość.
                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: 4px;
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Player.muted || Player.volume == 0 ? Icons.volume-off : Player.volume < 0.5 ? Icons.volume-low : Icons.volume;
                        size: 32px;
                        icon-size: 18px;
                        on-dark: true;
                        icon-color: root.c2;
                        hover-color: #ffffff;
                        tip: Player.muted ? @tr("Unmute (M)") : @tr("Mute (M)");
                        clicked => { Player.toggle-mute(); }
                    }
                    HSlider {
                        y: (parent.height - self.height) / 2;
                        width: bar.w > 600px ? 110px : 64px;
                        value: Player.volume;
                        fill-color: Player.muted ? root.c2 : Theme.tint;
                        track-color: #ffffff33;
                        moved(v) => { Player.set-volume(v); }
                    }
                    if bar.w > 600px: Text {
                        width: 38px;
                        text: round(Player.volume * 100) + "%";
                        color: root.c2;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                    if bar.w > 600px && Video.speed != 1: Text {
                        text: "  " + round(Video.speed * 100) / 100 + "×";
                        color: Theme.tint-hi;
                        font-size: Theme.fs-sm;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                // Środek: odtwarzanie – przyciski i pierścień jak w oknie muzyki.
                HorizontalLayout {
                    spacing: bar.w > 600px ? 14px : 6px;
                    alignment: center;
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.prev;
                        size: 44px;
                        icon-size: 26px;
                        on-dark: true;
                        icon-color: root.c2;
                        hover-color: #ffffff;
                        tip: @tr("Previous (Ctrl+←)");
                        clicked => { Player.prev(); }
                    }
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.rewind;
                        size: 40px;
                        icon-size: 20px;
                        on-dark: true;
                        icon-color: root.c2;
                        hover-color: #ffffff;
                        tip: "-10 s";
                        clicked => { Player.seek-rel(-10); }
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 56px;
                        height: 56px;
                        border-radius: 28px;
                        background: vpta.pressed ? Theme.tint.with-alpha(0.32) : vpta.has-hover ? Theme.tint.with-alpha(0.2) : Theme.tint.with-alpha(0.08);
                        border-width: 2px;
                        border-color: Theme.tint;
                        drop-shadow-blur: 22px;
                        drop-shadow-color: Theme.glow;
                        animate background { duration: 140ms; }
                        Icon {
                            icon: Video.playing ? Icons.pause : Icons.play;
                            size: 24px;
                            fill: Theme.ink;
                        }
                        vpta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Player.play-pause(); }
                        }
                    }
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.forward;
                        size: 40px;
                        icon-size: 20px;
                        on-dark: true;
                        icon-color: root.c2;
                        hover-color: #ffffff;
                        tip: "+10 s";
                        clicked => { Player.seek-rel(10); }
                    }
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.next;
                        size: 44px;
                        icon-size: 26px;
                        on-dark: true;
                        icon-color: root.c2;
                        hover-color: #ffffff;
                        tip: @tr("Next (Ctrl+→)");
                        clicked => { Player.next(); }
                    }
                }
                // Prawa strona: napisy, ustawienia filmu, więcej i pełny ekran.
                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: end;
                    spacing: 2px;
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.subtitles;
                        size: 34px;
                        icon-size: 17px;
                        on-dark: true;
                        icon-color: root.c2;
                        hover-color: #ffffff;
                        tip: @tr("Subtitles (V)");
                        active: Video.panel && Video.panel-page == 1;
                        clicked => { Video.panel = !(Video.panel && Video.panel-page == 1); Video.panel-page = 1; }
                    }
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.tune;
                        size: 34px;
                        icon-size: 17px;
                        on-dark: true;
                        icon-color: root.c2;
                        hover-color: #ffffff;
                        tip: @tr("Audio, picture, speed, details");
                        active: Video.panel && Video.panel-page != 1;
                        clicked => { Video.panel = !(Video.panel && Video.panel-page != 1); Video.panel-page = Video.panel-page == 1 || Video.panel-page == 5 ? 0 : Video.panel-page; }
                    }
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Icons.more;
                        size: 34px;
                        icon-size: 17px;
                        on-dark: true;
                        icon-color: root.c2;
                        hover-color: #ffffff;
                        tip: @tr("More");
                        clicked => { Video.menu(self.absolute-position.x, self.absolute-position.y, true); }
                    }
                    IconBtn {
                        tip-above: true;
                        y: (parent.height - self.height) / 2;
                        icon: Video.fullscreen ? Icons.fullscreen-exit : Icons.fullscreen;
                        size: 34px;
                        icon-size: 17px;
                        on-dark: true;
                        icon-color: root.c2;
                        hover-color: #ffffff;
                        tip: @tr("Full screen (F)");
                        clicked => { Video.toggle-fullscreen(); }
                    }
                }
            }
        }
    }
    // Pomiń czołówkę / napisy końcowe i następny odcinek – nad paskiem, po prawej.
    if Video.skip-text != "" || Video.next-text != "": VerticalLayout {
        x: root.width - self.width - 24px;
        y: bar.y - self.height - (root.show ? 8px : -100px);
        width: 320px;
        spacing: 8px;
        alignment: end;
        if Video.next-text != "": Rectangle {
            height: 86px;
            border-radius: 10px;
            background: #0e1014f0;
            border-width: 1px;
            border-color: #ffffff17;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000090;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: @tr("Next in {} s", Video.next-secs);
                    color: #ffffffa0;
                    font-size: Theme.fs-xs;
                }
                Text {
                    text: Video.next-text;
                    color: #ffffff;
                    font-size: Theme.fs-md;
                    font-weight: 600;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Btn {
                        text: @tr("Play now");
                        icon: Icons.play;
                        primary: true;
                        clicked => { Player.next(); }
                    }
                    Btn {
                        text: @tr("Cancel");
                        clicked => { Video.next-cancel(); }
                    }
                }
            }
        }
        if Video.skip-text != "": HorizontalLayout {
            alignment: end;
            Rectangle {
                width: skt.preferred-width + 48px;
                height: 40px;
                border-radius: 8px;
                background: skta.has-hover ? #ffffffe8 : #ffffffd0;
                drop-shadow-blur: 18px;
                drop-shadow-color: #00000080;
                HorizontalLayout {
                    padding-left: 14px;
                    spacing: 8px;
                    alignment: start;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.next;
                        size: 16px;
                        fill: #000000;
                    }
                    skt := Text {
                        text: Video.skip-text;
                        color: #000000;
                        font-size: Theme.fs;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                skta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Video.skip(); }
                }
            }
        }
    }
    // Panel boczny: dźwięk, napisy, obraz, rozdziały, szczegóły.
    // Pełny pasek boczny przy prawej krawędzi – od góry do dołu okna, z własnym zamknięciem.
    if Video.panel: Rectangle {
        x: root.width - self.width;
        y: 0;
        width: min(360px, root.width);
        height: root.height;
        // Nad obrazem filmu szkło nigdy nie jest całkiem przezroczyste – tekst musi być czytelny.
        GlassFill {
            base: Theme.dark ? #0b0c10 : Theme.glass-color;
            min-alpha: 0.72;
        }
        TouchArea { }
        VerticalLayout {
            padding: 16px;
            padding-top: 10px;
            spacing: 6px;
            HorizontalLayout {
                height: 36px;
                Rectangle {
                    horizontal-stretch: 1;
                    // Przeciąganie okna za nagłówek panelu.
                    TouchArea {
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                Ui.drag();
                            }
                        }
                    }
                }
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.close;
                    tip: @tr("Close panel");
                    size: 30px;
                    icon-size: 15px;
                    on-dark: true;
                    clicked => { Video.panel = false; }
                }
            }
            VideoPages {
                vertical-stretch: 1;
                themed: false;
                wide: false;
            }
        }
    }
}

// Szeroki: obraz na scenie z poświatą, panel listy i ustawień obok, sterowanie pod spodem.
export component VideoView inherits Rectangle {
    background: #000000;
    // Pełny ekran filmu – sam obraz; w oknie film gra w miejscu okładki, obok opisu.
    FullView { }
}

export component MiniView inherits Rectangle {
    background: Theme.bg;
    property <bool> hover: area.has-hover;
    // Obraz w obrazie: film na całe okienko, przyciski po najechaniu.
    if Video.active: Rectangle {
        background: #000000;
        VideoStage {
            ambient: Prefs.ambient > 0;
            ambient-strength: 0.3;
        }
    }
    area := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                Ui.drag();
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right && Video.active {
                Video.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
            }
        }
        double-clicked => {
            if Video.active {
                Video.open-view();
            } else {
                Ui.set-mode(0);
            }
        }
        scroll-event(e) => {
            Player.set-volume(clamp(Player.volume + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1));
            accept
        }
        if Video.active: Rectangle {
            opacity: root.hover || !Video.playing ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 180ms; }
            Rectangle {
                height: 48px;
                y: 0;
                background: @linear-gradient(180deg, #000000b0 0%, transparent 100%);
            }
            Rectangle {
                height: 70px;
                y: parent.height - self.height;
                background: @linear-gradient(0deg, #000000c8 0%, transparent 100%);
            }
            HorizontalLayout {
                x: 8px;
                y: 6px;
                width: parent.width - 14px;
                height: 30px;
                spacing: 2px;
                Text {
                    text: Video.title;
                    color: #ffffff;
                    font-size: Theme.fs-sm;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconBtn {
                    icon: Icons.expand;
                    size: 28px;
                    icon-size: 15px;
                    on-dark: true;
                    icon-color: #ffffffd0;
                    hover-color: #ffffff;
                    tip: @tr("Movie view");
                    clicked => { Video.open-view(); }
                }
                IconBtn {
                    icon: Icons.library;
                    size: 28px;
                    icon-size: 15px;
                    on-dark: true;
                    icon-color: #ffffffd0;
                    hover-color: #ffffff;
                    tip: @tr("Full window");
                    clicked => { Ui.set-mode(0); }
                }
                IconBtn {
                    icon: Icons.close;
                    size: 28px;
                    icon-size: 14px;
                    on-dark: true;
                    icon-color: #ffffffd0;
                    hover-color: #ffffff;
                    tip: @tr("Close");
                    clicked => { Ui.close(); }
                }
            }
            HorizontalLayout {
                x: 8px;
                y: parent.height - 42px;
                width: parent.width - 16px;
                height: 36px;
                spacing: 4px;
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Video.playing ? Icons.pause : Icons.play;
                    size: 32px;
                    icon-size: 20px;
                    on-dark: true;
                    icon-color: Theme.on-video;
                    hover-color: #ffffff;
                    tip: @tr("Play / pause");
                    tip-above: true;
                    clicked => { Player.play-pause(); }
                }
                VideoSeek {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                    on-video: true;
                }
                Text {
                    text: Fmt.time(Video.pos);
                    color: #ffffffd0;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                }
            }
        }
        if !Video.active && Player.has-cover: Image {
            width: 100%;
            height: 100%;
            source: Player.backdrop;
            image-fit: ImageFit.cover;
            opacity: 0.22;
        }
        if !Video.active: Rectangle {
            background: @linear-gradient(90deg, Theme.bg.with-alpha(0.9) 0%, Theme.bg.with-alpha(0.6) 60%, Theme.bg.with-alpha(0.92) 100%);
        }
        // Delikatne słupki analizatora za tytułem – muzyka „widać” także bez najeżdżania.
        if !Video.active && Player.viz-mode != 4 && !Player.idle: Visualizer {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            height: strip.y - 12px;
            opacity: 0.28;
            overlay: true;
            mode: Player.viz-mode == 3 ? 0 : Player.viz-mode;
            bars: Player.bars;
            peaks: Player.peaks;
            scope-path: Player.scope-path;
            spectrum-path: Player.spectrum-path;
            active: Player.viz-active;
            note: "";
        }
        // Tytuł i wykonawca – zawsze widoczne; ustępują miejsca okładce po najechaniu.
        if !Video.active: HorizontalLayout {
            x: 14px;
            y: 8px;
            width: parent.width - 28px;
            height: strip.y - 14px;
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                padding-right: root.hover ? cover.width + 8px : 0px;
                animate padding-right { duration: 180ms; easing: ease-out; }
                Marquee {
                    text: Player.idle ? "OpenMP" : Player.title;
                    font-size: Theme.fs-lg + 1px;
                    font-family: Theme.font-serif;
                    text-color: Theme.heading;
                    enabled: Prefs.scroll-title;
                }
                Text {
                    text: Player.idle ? @tr("Nothing playing") : Player.artist;
                    color: Theme.tint.mix(Theme.text2, 0.45);
                    font-size: Theme.fs;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: start;
                IconBtn {
                    icon: Icons.expand;
                    size: 26px;
                    icon-size: 15px;
                    tip: @tr("Full window");
                    clicked => { Ui.set-mode(0); }
                }
                IconBtn {
                    icon: Icons.close;
                    tip: @tr("Close");
                    size: 26px;
                    icon-size: 14px;
                    clicked => { Ui.close(); }
                }
            }
        }
        // Pasek postępu z przyciskami odtwarzania.
        strip := Rectangle {
            x: 0;
            width: parent.width;
            height: 56px;
            y: parent.height - self.height;
            visible: !Video.active;
            background: Theme.panel2.with-alpha(0.85);
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 16px;
                spacing: 2px;
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.prev;
                    tip: @tr("Previous");
                    size: 34px;
                    icon-size: 20px;
                    icon-color: Theme.ink;
                    tip-above: true;
                    clicked => { Player.prev(); }
                }
                PlayRing {
                    y: (parent.height - self.height) / 2;
                    size: 40px;
                }
                IconBtn {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.next;
                    tip: @tr("Next");
                    size: 34px;
                    icon-size: 20px;
                    icon-color: Theme.ink;
                    tip-above: true;
                    clicked => { Player.next(); }
                }
                Rectangle {
                    width: 8px;
                }
                SeekBar {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                    wave-height: 32px;
                    value: Player.duration > 0 ? Player.pos / Player.duration : 0;
                    duration: Player.duration;
                    wave: Player.wave;
                    wave2: Player.wave2;
                    wave2-kind: Player.wave2-kind;
                    wave-live: Player.wave-live;
                    live-span: Player.live-span;
                    show-wave: Prefs.show-waveform;
                    ab-a: Player.ab-a;
                    ab-b: Player.ab-b;
                    seek(v) => { Player.seek(v); }
                }
                Rectangle {
                    width: 12px;
                }
                Text {
                    text: Prefs.remaining && Player.duration > 0 ? "-" + Fmt.time(Player.duration - Player.pos) : Fmt.time(Player.pos);
                    color: Theme.text2;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Prefs.remaining = !Prefs.remaining;
                            Prefs.changed("remaining");
                        }
                    }
                }
            }
        }
        // Okładka z wizualizacją – nad paskiem po prawej, tylko po najechaniu.
        cover := CoverArt {
            width: strip.y - 14px;
            height: self.width;
            x: parent.width - self.width - 48px;
            y: root.hover ? strip.y - self.height - 6px : strip.y - self.height + 6px;
            radius: 8px;
            show-chip: false;
            show-viz: false;
            opacity: root.hover && !Video.active ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity, y { duration: 180ms; easing: ease-out; }
            clicked => { Player.cycle-viz(); }
        }
    }
}
