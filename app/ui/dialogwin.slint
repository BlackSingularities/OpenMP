// Okno dialogów: ustawienia, korektor, edytor tagów i pozostałe jako osobne okno, które może
// wystawać poza okno programu. Stan (Prefs, Ui, Theme) Rust synchronizuje z oknem głównym.

import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EqualizerDialog, SettingsDialog, AboutDialog, UrlDialog, TagEditor, UpdateDialog, RenameDialog } from "dialogs.slint";
import { Ui } from "state.slint";

export component DialogWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    icon: @image-url("../icon.png");
    // Barwę szkła rysuje dialog; okno przezroczyste – pod spodem akryl systemowy.
    background: transparent;
    default-font-family: Theme.font;
    default-font-size: Theme.fs;
    title: Ui.settings ? @tr("Settings – OpenMP") : Ui.equalizer ? @tr("Equalizer – OpenMP") : Ui.tag-editor ? @tr("Tag editor – OpenMP") : "OpenMP";
    // Rozmiar okna = rozmiar aktywnego dialogu.
    // Ustawienia: rozmiar zmieniany uchwytem (nie mniejszy niż minimum).
    width: Ui.settings ? (Ui.settings-w > 0 ? max(Ui.settings-w, 680px) : set.natural-width) : Ui.equalizer ? eq.natural-width : Ui.tag-editor ? tag.natural-width : Ui.update-dialog ? upd.natural-width : Ui.url-dialog ? url.natural-width : Ui.rename-dialog ? ren.natural-width : about.natural-width;
    height: Ui.settings ? (Ui.settings-h > 0 ? max(Ui.settings-h, 460px) : set.natural-height) : Ui.equalizer ? eq.natural-height : Ui.tag-editor ? tag.natural-height : Ui.update-dialog ? upd.natural-height : Ui.url-dialog ? url.natural-height : Ui.rename-dialog ? ren.natural-height : about.natural-height;
    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    property <bool> dark: Theme.dark;
    changed dark => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                Ui.settings = false;
                Ui.equalizer = false;
                Ui.about = false;
                Ui.url-dialog = false;
                Ui.tag-editor = false;
                Ui.update-dialog = false;
                Ui.rename-dialog = false;
            }
            reject
        }
        Rectangle {
            border-width: 1px;
            border-color: Theme.line2;
            z: 10;
        }
        set := SettingsDialog { visible: Ui.settings; }
        eq := EqualizerDialog { visible: Ui.equalizer && !Ui.settings; }
        tag := TagEditor { visible: Ui.tag-editor && !Ui.settings && !Ui.equalizer; }
        upd := UpdateDialog { visible: Ui.update-dialog && !Ui.settings && !Ui.equalizer && !Ui.tag-editor; }
        url := UrlDialog { visible: Ui.url-dialog && !Ui.settings && !Ui.equalizer && !Ui.tag-editor && !Ui.update-dialog; }
        ren := RenameDialog { visible: Ui.rename-dialog && !Ui.settings && !Ui.equalizer && !Ui.tag-editor && !Ui.update-dialog && !Ui.url-dialog; }
        // Uchwyty zmiany rozmiaru okna ustawień: prawa krawędź, dolna krawędź i róg.
        if Ui.settings: Rectangle {
            x: parent.width - 6px;
            width: 6px;
            height: parent.height - 16px;
            z: 20;
            TouchArea {
                mouse-cursor: MouseCursor.ew-resize;
                moved => {
                    if self.pressed {
                        Ui.settings-w = max(680px, root.width + self.mouse-x - self.pressed-x);
                    }
                }
            }
        }
        if Ui.settings: Rectangle {
            y: parent.height - 6px;
            height: 6px;
            width: parent.width - 16px;
            z: 20;
            TouchArea {
                mouse-cursor: MouseCursor.ns-resize;
                moved => {
                    if self.pressed {
                        Ui.settings-h = max(460px, root.height + self.mouse-y - self.pressed-y);
                    }
                }
            }
        }
        if Ui.settings: Rectangle {
            x: parent.width - 16px;
            y: parent.height - 16px;
            width: 16px;
            height: 16px;
            z: 21;
            // Kropki uchwytu w rogu.
            for d in [{ x: 10px, y: 4px }, { x: 10px, y: 10px }, { x: 4px, y: 10px }]: Rectangle {
                x: d.x;
                y: d.y;
                width: 2px;
                height: 2px;
                border-radius: 1px;
                background: Theme.text3;
            }
            TouchArea {
                mouse-cursor: MouseCursor.nwse-resize;
                moved => {
                    if self.pressed {
                        Ui.settings-w = max(680px, root.width + self.mouse-x - self.pressed-x);
                        Ui.settings-h = max(460px, root.height + self.mouse-y - self.pressed-y);
                    }
                }
            }
        }
        about := AboutDialog { visible: Ui.about && !Ui.settings && !Ui.equalizer && !Ui.tag-editor && !Ui.update-dialog && !Ui.url-dialog && !Ui.rename-dialog; }
    }
}
