// Okno OpenMP – trzy tryby: okno, pełny ekran (ten sam układ) i miniodtwarzacz;
// film ma dodatkowo własny pełny ekran z samym obrazem (Ui.mode == 1).

import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "widgets.slint";
import { Hero, HeroLyrics, CoverArt, NowInfo, BottomBar } from "nowplaying.slint";
import { TitleBar, Sidebar, PlaylistView, LibraryView, RadioView, SidePanel } from "views.slint";
import { VideoView, MiniView } from "video.slint";
import { Backdrop } from "surface.slint";
import { Visualizer } from "display.slint";
import { StatsView } from "stats.slint";
import { MenuWindow } from "popup.slint";
import { DialogWindow } from "dialogwin.slint";
import { Welcome } from "welcome.slint";
import { Player, Lists, Lib, Video, Prefs, Ui } from "state.slint";
import { StatCard, StatDay, StatTop, TrackRow, NavItem, Tile, MenuEntry, TabItem, LyricLine, Opt, Station, KeyHelp } from "types.slint";

export { MenuWindow, DialogWindow, Theme, Player, Lists, Lib, Video, Prefs, Ui, StatCard, StatDay, StatTop, TrackRow, NavItem, Tile, MenuEntry, TabItem, LyricLine, Opt, Station, KeyHelp }

export component AppWindow inherits Window {
    title: Player.idle ? "OpenMP" : Player.title + " – OpenMP";
    icon: @image-url("../icon.png");
    no-frame: true;
    // Przezroczystość okna = szkło: przez tło prześwituje akryl systemowy.
    background: Ui.mode == 1 ? #000000 : Theme.bg.with-alpha(1 - Theme.glass);
    min-width: Ui.mode == 2 ? 260px : Ui.mode == 1 ? 320px : 720px;
    min-height: Ui.mode == 2 ? 120px : Ui.mode == 1 ? 180px : 560px;
    preferred-width: 1180px;
    preferred-height: 780px;
    default-font-family: Theme.font;
    default-font-size: Theme.fs;
    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    property <bool> dark: Theme.dark;
    changed dark => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    property <bool> any-dialog: Ui.settings || Ui.equalizer || Ui.about || Ui.url-dialog || Ui.tag-editor || Ui.update-dialog || Ui.rename-dialog;
    changed any-dialog => {
        Ui.dialog-shown(self.any-dialog);
    }

    public function focus-keys() {
        keys.focus();
    }

    // Przy zmianie widoku (np. start filmu z pola wyszukiwania albo z listy) element z fokusem
    // znika razem ze starym widokiem i strzałki nigdzie nie trafiały – fokus wraca do skrótów.
    property <int> view-mode: Ui.mode;
    changed view-mode => {
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(e) => {
            if Ui.ambient {
                Ui.ambient = false;
                return accept;
            }
            if e.text == Key.Escape {
                if Ui.settings || Ui.equalizer || Ui.about || Ui.url-dialog || Ui.tag-editor || Ui.update-dialog || Ui.rename-dialog {
                    Ui.settings = false;
                    Ui.equalizer = false;
                    Ui.about = false;
                    Ui.url-dialog = false;
                    Ui.tag-editor = false;
                    Ui.update-dialog = false;
                    Ui.rename-dialog = false;
                    return accept;
                }
            }
            // Tab (bez Ctrl) przenosi fokus między przyciskami – obsługuje go Slint.
            if (e.text == Key.Tab || e.text == Key.Backtab) && !e.modifiers.control {
                return reject;
            }
            Ui.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
            accept
        }

        if Ui.mode == 1: VideoView { }

        if Ui.mode == 2: MiniView { }

        // Okno i pełny ekran: panel nawigacji, okładka (albo obraz filmu) z opisem nad listą,
        // panel boczny i dolny pasek.
        if Ui.mode == 0: stage := Rectangle {
            // Bezczynność: 0 – zwykły widok, 1 – okładka, tytuł i tekst zostają, a panel nawigacji,
            // listy i dolny pasek znikają; ich miejsce zajmuje wizualizacja. Wejście trwa około
            // minuty, powrót jest szybki.
            property <float> amb: Ui.ambient ? 1 : 0;
            // Zwykły układ gaśnie w pierwszej połowie przejścia, układ bezczynności pojawia się w drugiej;
            // przestawienie następuje, gdy oba są niewidoczne.
            property <bool> amb-layout: self.amb >= 0.5;
            property <float> amb-in: max(0, self.amb * 2 - 1);
            property <float> amb-out: max(0, 1 - self.amb * 2);
            // Okładka z opisem na środku u góry, pod nimi tekst.
            property <length> amb-h: clamp(self.height * 0.3, 180px, 340px);
            property <length> amb-y: max(36px, self.height * 0.05);
            property <length> amb-info-w: min(self.width * 0.4, 640px);
            property <length> amb-lyr-w: min(self.width * 0.6, 900px);
            animate amb { duration: Ui.ambient ? 60s : 400ms; easing: ease-in-out; }
            // Tło z okładki (albo z obrazu filmu) i poświata akcentu za górną częścią okna.
            // Przy szkle to tylko delikatna barwa okładki – to, co za oknem, dalej prześwituje.
            if Prefs.backdrop > 0: Backdrop { }
            Rectangle {
                x: parent.width * 0.05;
                y: -parent.height * 0.35;
                width: parent.width * 0.75;
                height: parent.height * 0.9;
                background: @radial-gradient(circle, Theme.tint.with-alpha(min(0.09 * Theme.glow-k, 0.3)) 0%, transparent 65%);
            }
            // Tekst piosenki obok opisu – warstwa pod wizualizacją. W bezczynności tekst z sygnaturami
            // jest na środku okna, od okładki do dołu, za wizualizacją; tekst bez nich znika.
            if hero.show-lyrics: HeroLyrics {
                property <length> top: hero.absolute-position.y - parent.absolute-position.y;
                ambient: stage.amb-layout;
                x: stage.amb-layout ? (parent.width - stage.amb-lyr-w) / 2 : hero.absolute-position.x - parent.absolute-position.x + hero.lyrics-x;
                y: stage.amb-layout ? stage.amb-y + stage.amb-h + 12px : self.top;
                width: stage.amb-layout ? stage.amb-lyr-w : hero.lyrics-w;
                height: stage.amb-layout ? parent.height - self.y : hero.height;
                opacity: stage.amb-layout ? (Player.lyrics-synced ? stage.amb-in : 0) : stage.amb-out;
            }
            // Wizualizacja w tle (ustawienie „Pokazuj wizualizację”): duża, przygaszona, pod listami
            // i panelami, wyśrodkowana względem treści okna – bez panelu nawigacji. Słupki i widma
            // stoją na dole, tryby symetryczne są na środku wysokości. Rozmycie – kilka przesuniętych,
            // słabszych kopii wokół środka.
            if Prefs.viz-place == 1 && Player.viz-mode != 4 && !Player.idle && !Video.active: Rectangle {
                // Krawędzie jak kafelki i listy: kolumna treści bez jej odstępów (bez panelu nawigacji i panelu po prawej).
                property <length> left: (Prefs.show-sidebar ? Prefs.sidebar-width * 1px : 0px) + content.x + content.padding-left;
                property <bool> floor: Player.viz-mode == 0 || Player.viz-mode == 1 || Player.viz-mode == 7 || Player.viz-mode == 8 || Player.viz-mode == 10;
                property <length> r: Prefs.viz-blur * 22px;
                property <bool> soft: Prefs.viz-blur > 0.01;
                // W bezczynności wizualizacja zajmuje całą szerokość okna pod okładką i tytułem –
                // miejsce list i dolnego paska.
                property <float> k: parent.amb;
                property <length> top: hero.absolute-position.y + hero.height - parent.absolute-position.y + 8px;
                x: self.left * (1 - self.k);
                width: (content.width - content.padding-left - content.padding-right) * (1 - self.k) + parent.width * self.k;
                // Zawsze nad paskiem odtwarzania (pasek z falą ma własne miejsce pod spodem).
                y: self.top * self.k;
                height: (body.height - 4px) * (1 - self.k) + (parent.height - self.top) * self.k;
                clip: true;
                for o in (self.soft
                    ? [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: -1, y: 0 }, { x: 0.5, y: 0.87 }, { x: -0.5, y: 0.87 }, { x: 0.5, y: -0.87 }, { x: -0.5, y: -0.87 }]
                    : [{ x: 0, y: 0 }]): Visualizer {
                    width: parent.width;
                    x: (parent.width - self.width) / 2 + o.x * parent.r;
                    height: parent.height * (parent.floor ? 0.6 : 0.76);
                    y: (parent.floor ? parent.height - self.height : (parent.height - self.height) / 2) + o.y * parent.r;
                    opacity: (parent.soft ? 2.4 / 7 : 1) * (0.32 + 0.6 * parent.k);
                    overlay: true;
                    mode: Player.viz-mode;
                    bars: Player.bars;
                    peaks: Player.peaks;
                    scope-path: Player.scope-path;
                    spectrum-path: Player.spectrum-path;
                    viz-path: Player.viz-path;
                    vu-l: Player.vu-l;
                    vu-r: Player.vu-r;
                    vu-pl: Player.vu-pl;
                    vu-pr: Player.vu-pr;
                    active: Player.viz-active;
                    note: "";
                }
            }
            Rectangle {
                VerticalLayout {
                    body := HorizontalLayout {
                        vertical-stretch: 1;
                        if Prefs.show-sidebar: Sidebar {
                            opacity: 1 - stage.amb;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                TitleBar {
                                    show-brand: !Prefs.show-sidebar;
                                    subtitle: "";
                                }
                                HorizontalLayout {
                                    vertical-stretch: 1;
                                    // Odstępy ma sama treść – panel po prawej dochodzi do krawędzi okna.
                                    content := VerticalLayout {
                                        horizontal-stretch: 1;
                                        padding-left: Theme.pad;
                                        padding-right: Theme.dense ? 8px : 14px;
                                        padding-bottom: Theme.dense ? 6px : 10px;
                                        property <length> auto-h: Theme.dense ? clamp((root.height - 200px) * 0.36, 110px, 280px) : clamp((root.height - 230px) * 0.5, 150px, 400px);
                                        // Własna wysokość z przeciągnięcia – lista pod spodem zawsze zostaje widoczna.
                                        property <length> max-h: max(110px, root.height - 380px);
                                        property <length> drag-h: -1px;
                                        hero := Hero {
                                            avail: root.width;
                                            opacity: stage.amb-out;
                                            height: drag-h >= 0 ? drag-h : Prefs.hero-h > 0 ? clamp(Prefs.hero-h * 1px, 110px, max-h) : auto-h;
                                            small: self.height < 220px;
                                        }
                                        // Uchwyt między podglądem a listą: przeciągnij, podwójne kliknięcie – automatycznie.
                                        Rectangle {
                                            opacity: 1 - stage.amb;
                                            height: Theme.gap;
                                            // Separator na środku odstępu – tylko na nim (±4 px) zmienia się wysokość,
                                            // nie nad przyciskami listy.
                                            Rectangle {
                                                y: (parent.height - self.height) / 2;
                                                height: 1px;
                                                background: grip.pressed ? Theme.tint : grip.has-hover ? Theme.line2.brighter(0.6) : Theme.line;
                                            }
                                            grip := TouchArea {
                                                y: (parent.height - self.height) / 2;
                                                height: 9px;
                                                mouse-cursor: row-resize;
                                                property <length> start;
                                                pointer-event(e) => {
                                                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                                        self.start = hero.height;
                                                    }
                                                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && drag-h >= 0 {
                                                        Prefs.hero-h = drag-h / 1px;
                                                        drag-h = -1px;
                                                        Prefs.changed("hero-h");
                                                    }
                                                }
                                                moved => {
                                                    if self.pressed {
                                                        drag-h = clamp(self.start + self.mouse-y - self.pressed-y, 110px, max-h);
                                                    }
                                                }
                                                double-clicked => {
                                                    drag-h = -1px;
                                                    Prefs.hero-h = 0;
                                                    Prefs.changed("hero-h");
                                                }
                                            }
                                            Rectangle {
                                                y: (parent.height - self.height) / 2;
                                                width: 36px;
                                                height: 3px;
                                                border-radius: 1.5px;
                                                background: grip.pressed ? Theme.tint : Theme.line2;
                                                opacity: grip.has-hover || grip.pressed ? 1 : 0;
                                            }
                                        }
                                        if Lib.view == 0: PlaylistView {
                                            opacity: 1 - stage.amb;
                                            vertical-stretch: 1;
                                        }
                                        if Lib.view == 1: LibraryView {
                                            opacity: 1 - stage.amb;
                                            vertical-stretch: 1;
                                        }
                                        if Lib.view == 2: RadioView {
                                            opacity: 1 - stage.amb;
                                            vertical-stretch: 1;
                                        }
                                        if Lib.view == 3: StatsView {
                                            opacity: 1 - stage.amb;
                                            vertical-stretch: 1;
                                        }
                                    }
                                    if Prefs.side-panel > 0: SidePanel {
                                        opacity: 1 - stage.amb;
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                        opacity: 1 - stage.amb;
                    }
                    BottomBar {
                        opacity: 1 - stage.amb;
                    }
                }
            }
            // Bezczynność: okładka po lewej stronie opisu, razem na środku okna.
            if stage.amb-layout && !Video.active: amb-group := Rectangle {
                property <length> cover-w: stage.amb-h * hero.cover-ratio;
                width: self.cover-w + 36px + stage.amb-info-w;
                height: stage.amb-h;
                x: (parent.width - self.width) / 2;
                y: stage.amb-y;
                opacity: stage.amb-in;
                HorizontalLayout {
                    spacing: 36px;
                    CoverArt {
                        width: amb-group.cover-w;
                        show-viz: false;
                    }
                    NowInfo {
                        width: stage.amb-info-w;
                    }
                }
            }
            // Kliknięcie gdziekolwiek w oknie kończy tryb bezczynności.
            if Ui.ambient: TouchArea {
                clicked => { Ui.ambient = false; }
            }
        }

        if Ui.mode != 1 && Ui.drop-hint: Rectangle {
            background: Theme.tint.with-alpha(0.12);
            border-width: 2px;
            border-color: Theme.tint;
            border-radius: Theme.r(10px);
            Text {
                text: @tr("Drop to add to the list");
                color: Theme.text;
                font-size: Theme.fs-lg;
                font-weight: 600;
            }
        }

        if Ui.welcome && Ui.mode == 0: Welcome { }

        // Krótki komunikat u dołu okna – karta jak komunikaty na obrazie filmu.
        if Ui.mode != 1: Rectangle {
            y: parent.height - self.height - (Ui.mode == 2 ? 70px : 210px) + (Ui.toast-visible ? 0 : 10px);
            x: (parent.width - self.width) / 2;
            width: min(tl.preferred-width, parent.width - 32px);
            height: tl.preferred-height;
            border-radius: Theme.r(12px);
            background: @linear-gradient(180deg, #1a1d24f2 0%, #0e1014f2 100%);
            border-width: 1px;
            border-color: #ffffff17;
            opacity: Ui.toast-visible ? 1 : 0;
            animate opacity { duration: 200ms; easing: ease-out; }
            animate y { duration: 220ms; easing: ease-out; }
            drop-shadow-blur: 26px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000090;
            tl := HorizontalLayout {
                padding-left: 10px;
                padding-right: 18px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 12px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 28px;
                    border-radius: Theme.r(8px);
                    background: Theme.tint.with-alpha(0.18);
                    Icon {
                        icon: Icons.info;
                        size: 15px;
                        fill: Theme.tint-hi;
                    }
                }
                Text {
                    text: Ui.toast;
                    color: #ffffff;
                    font-size: Theme.fs;
                    font-weight: 600;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    max-width: 520px;
                }
            }
        }
    }

    // Uchwyty zmiany rozmiaru okna bez ramki.
    if !Ui.maximized && !Ui.fullscreen && !Video.fullscreen: Rectangle {
        // Szersze w widoku filmu – obraz sięga krawędzi okna.
        property <length> e: Ui.mode == 1 ? 8px : 6px;
        for h in [
            { x: 0px, y: e, w: e, hh: root.height - 2 * e, d: 3, c: MouseCursor.ew-resize },
            { x: root.width - e, y: e, w: e, hh: root.height - 2 * e, d: 4, c: MouseCursor.ew-resize },
            { x: e, y: 0px, w: root.width - 2 * e, hh: e, d: 1, c: MouseCursor.ns-resize },
            { x: e, y: root.height - e, w: root.width - 2 * e, hh: e, d: 2, c: MouseCursor.ns-resize },
            { x: 0px, y: 0px, w: e * 2, hh: e * 2, d: 5, c: MouseCursor.nwse-resize },
            { x: root.width - e * 2, y: 0px, w: e * 2, hh: e * 2, d: 6, c: MouseCursor.nesw-resize },
            { x: 0px, y: root.height - e * 2, w: e * 2, hh: e * 2, d: 7, c: MouseCursor.nesw-resize },
            { x: root.width - e * 2, y: root.height - e * 2, w: e * 2, hh: e * 2, d: 8, c: MouseCursor.nwse-resize },
        ]: TouchArea {
            x: h.x;
            y: h.y;
            width: h.w;
            height: h.hh;
            mouse-cursor: h.c;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    Ui.resize(h.d);
                }
            }
        }
    }
}
