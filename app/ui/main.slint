// Okno OpenMP: tryb muzyki (duży i pomniejszony), tryb wideo, miniodtwarzacz.

import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "widgets.slint";
import { Hero, BottomBar } from "nowplaying.slint";
import { TitleBar, Sidebar, PlaylistView, LibraryView, RadioView, SidePanel } from "views.slint";
import { VideoView, MiniView } from "video.slint";
import { EqualizerDialog, SettingsDialog, AboutDialog, UrlDialog, TagEditor, UpdateDialog, RenameDialog } from "dialogs.slint";
import { Player, Lists, Lib, Video, Prefs, Ui } from "state.slint";
import { TrackRow, NavItem, Tile, MenuEntry, TabItem, LyricLine, Opt, Station, KeyHelp } from "types.slint";

export { Theme, Player, Lists, Lib, Video, Prefs, Ui, TrackRow, NavItem, Tile, MenuEntry, TabItem, LyricLine, Opt, Station, KeyHelp }

export component AppWindow inherits Window {
    title: Player.idle ? "OpenMP" : Player.title + " – OpenMP";
    icon: @image-url("../icon.png");
    no-frame: true;
    background: Ui.mode == 1 ? #000000 : Theme.bg;
    min-width: Ui.mode == 2 ? 360px : Ui.mode == 1 || Prefs.compact ? 480px : 720px;
    min-height: Ui.mode == 2 ? 140px : Ui.mode == 1 ? 240px : Prefs.compact ? 300px : 560px;
    preferred-width: 1180px;
    preferred-height: 780px;
    default-font-family: Theme.font;
    default-font-size: Theme.fs;
    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    property <bool> dark: Theme.dark;
    changed dark => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    public function open-menu() {
        menu-popup.show();
    }
    public function focus-keys() {
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                if Ui.settings || Ui.equalizer || Ui.about || Ui.url-dialog || Ui.tag-editor || Ui.update-dialog || Ui.rename-dialog {
                    Ui.settings = false;
                    Ui.equalizer = false;
                    Ui.about = false;
                    Ui.url-dialog = false;
                    Ui.tag-editor = false;
                    Ui.update-dialog = false;
                    Ui.rename-dialog = false;
                    return accept;
                }
            }
            Ui.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
            accept
        }

        if Ui.mode == 1: VideoView { }

        if Ui.mode == 2: MiniView { }

        // Duże okno: panel nawigacji, okładka z opisem nad listą, panel boczny i dolny pasek.
        if Ui.mode == 0 && !Prefs.compact: Rectangle {
            // Poświata akcentu z okładki za górną częścią okna.
            Rectangle {
                x: parent.width * 0.05;
                y: -parent.height * 0.35;
                width: parent.width * 0.75;
                height: parent.height * 0.9;
                background: @radial-gradient(circle, Theme.tint.with-alpha(0.09) 0%, transparent 65%);
            }
            VerticalLayout {
                HorizontalLayout {
                    vertical-stretch: 1;
                    if Prefs.show-sidebar: Sidebar { }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        TitleBar {
                            show-brand: !Prefs.show-sidebar;
                            subtitle: "";
                        }
                        HorizontalLayout {
                            vertical-stretch: 1;
                            padding-left: 26px;
                            padding-right: 14px;
                            padding-bottom: 10px;
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 20px;
                                Hero {
                                    height: clamp((root.height - 230px) * 0.5, 150px, 400px);
                                    small: self.height < 220px;
                                }
                                if Lib.view == 0: PlaylistView {
                                    vertical-stretch: 1;
                                }
                                if Lib.view == 1: LibraryView {
                                    vertical-stretch: 1;
                                }
                                if Lib.view == 2: RadioView {
                                    vertical-stretch: 1;
                                }
                            }
                            if Prefs.side-panel > 0: SidePanel { }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                BottomBar { }
            }
        }

        // Widok pomniejszony: okładka z wizualizacją i tytuł po lewej, pod spodem ten sam dolny pasek.
        if Ui.mode == 0 && Prefs.compact: Rectangle {
            Rectangle {
                x: -parent.width * 0.2;
                y: -parent.height * 0.5;
                width: parent.width * 0.9;
                height: parent.height * 1.2;
                background: @radial-gradient(circle, Theme.tint.with-alpha(0.10) 0%, transparent 65%);
            }
            VerticalLayout {
                TitleBar {
                    subtitle: "";
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 2px;
                    Hero {
                        small: root.height < 560px;
                    }
                }
                BottomBar {
                    small: true;
                }
            }
        }

        if Ui.mode != 1 && Ui.drop-hint: Rectangle {
            background: Theme.tint.with-alpha(0.12);
            border-width: 2px;
            border-color: Theme.tint;
            border-radius: 10px;
            Text {
                text: "Upuść, by dodać do listy";
                color: Theme.text;
                font-size: Theme.fs-lg;
                font-weight: 600;
            }
        }

        if Ui.equalizer: EqualizerDialog { }
        if Ui.settings: SettingsDialog { }
        if Ui.about: AboutDialog { }
        if Ui.url-dialog: UrlDialog { }
        if Ui.tag-editor: TagEditor { }
        if Ui.update-dialog: UpdateDialog { }
        if Ui.rename-dialog: RenameDialog { }

        // Krótki komunikat u dołu okna.
        if Ui.mode != 1: Rectangle {
            y: parent.height - self.height - (Ui.mode == 2 ? 70px : Prefs.compact ? 160px : 210px);
            x: (parent.width - self.width) / 2;
            width: tt.preferred-width + 30px;
            height: 34px;
            border-radius: 17px;
            background: Theme.dark ? #2a303ce8 : #1c2028e8;
            opacity: Ui.toast-visible ? 1 : 0;
            animate opacity { duration: 200ms; }
            drop-shadow-blur: 14px;
            drop-shadow-color: #00000060;
            tt := Text {
                text: Ui.toast;
                color: #ffffff;
                font-size: Theme.fs;
            }
        }
    }

    // Uchwyty zmiany rozmiaru okna bez ramki.
    if !Ui.maximized && !Video.fullscreen: Rectangle {
        property <length> e: 5px;
        for h in [
            { x: 0px, y: e, w: e, hh: root.height - 2 * e, d: 3, c: MouseCursor.ew-resize },
            { x: root.width - e, y: e, w: e, hh: root.height - 2 * e, d: 4, c: MouseCursor.ew-resize },
            { x: e, y: 0px, w: root.width - 2 * e, hh: e, d: 1, c: MouseCursor.ns-resize },
            { x: e, y: root.height - e, w: root.width - 2 * e, hh: e, d: 2, c: MouseCursor.ns-resize },
            { x: 0px, y: 0px, w: e * 2, hh: e * 2, d: 5, c: MouseCursor.nwse-resize },
            { x: root.width - e * 2, y: 0px, w: e * 2, hh: e * 2, d: 6, c: MouseCursor.nesw-resize },
            { x: 0px, y: root.height - e * 2, w: e * 2, hh: e * 2, d: 7, c: MouseCursor.nesw-resize },
            { x: root.width - e * 2, y: root.height - e * 2, w: e * 2, hh: e * 2, d: 8, c: MouseCursor.nwse-resize },
        ]: TouchArea {
            x: h.x;
            y: h.y;
            width: h.w;
            height: h.hh;
            mouse-cursor: h.c;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    Ui.resize(h.d);
                }
            }
        }
    }

    menu-popup := PopupWindow {
        // Menu zawsze w całości w oknie, także gdy okno jest wąskie.
        x: max(4px, min(Ui.menu-x, root.width - mbox.width - 10px));
        y: max(4px, min(Ui.menu-y, root.height - mbox.height - 8px));
        // Okno menu dokładnie w rozmiarze zawartości – inaczej treść jest wyśrodkowana i ucięta.
        width: mbox.width;
        height: mbox.height;
        close-policy: PopupClosePolicy.close-on-click-outside;
        mbox := Rectangle {
            x: 0;
            y: 0;
            width: min(270px, root.width - 8px);
            height: mlay.preferred-height;
            border-radius: 10px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line2;
            drop-shadow-blur: 22px;
            drop-shadow-color: #00000080;
            mlay := VerticalLayout {
                padding: 5px;
                for m in Ui.menu: Rectangle {
                    height: m.sep ? 9px : 30px;
                    if m.sep: Rectangle {
                        height: 1px;
                        x: 8px;
                        width: parent.width - 16px;
                        background: Theme.line;
                    }
                    if !m.sep: Rectangle {
                        border-radius: 6px;
                        background: mta.has-hover && m.enabled ? Theme.sel : transparent;
                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 10px;
                            spacing: 10px;
                            Rectangle {
                                width: 16px;
                                if m.icon != "" || m.checked: Icon {
                                    icon: m.checked ? Icons.check : Icons.get(m.icon);
                                    size: 15px;
                                    fill: m.checked ? Theme.tint : m.enabled ? Theme.text2 : Theme.text3.with-alpha(0.5);
                                }
                            }
                            Text {
                                text: m.label;
                                color: m.enabled ? Theme.text : Theme.text3;
                                font-size: Theme.fs;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: m.shortcut;
                                color: Theme.text3;
                                font-size: Theme.fs-xs;
                                vertical-alignment: center;
                            }
                        }
                        mta := TouchArea {
                            enabled: m.enabled;
                            clicked => {
                                menu-popup.close();
                                Ui.menu-activated(m.id);
                            }
                        }
                    }
                }
            }
        }
    }
}
